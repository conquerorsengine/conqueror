using nativebridge;

// 2D oyuncu kontrolcüsü: A/D ile yürü, Space ile zıpla.
// Public alanlar Inspector'da düzenlenebilir (sahneyle kaydedilir).
script PlayerController : ConquerorScript
{
    [Tooltip("Horizontal movement speed (units per second)")]
    [Range(0, 20)]
    public float moveSpeed = 5.0;

    [Range(0, 30)]
    public float jumpForce = 7.0;

    private int jumps = 0;

    func Start()
    {
        LogInfo($"PlayerController started (speed {moveSpeed:F1})");
    }

    func Update(dt)
    {
        var vel = GetLinearVelocity2D();
        var moveX = 0.0;
        if (IsKeyPressed(Key.A) || IsKeyPressed(Key.Left))  moveX -= 1.0;
        if (IsKeyPressed(Key.D) || IsKeyPressed(Key.Right)) moveX += 1.0;

        var vy = vel.y;
        // Yerdeyken (dikey hız ~0) zıpla
        if (IsKeyPressed(Key.Space) && MathAbs(vy) < 0.01)
        {
            vy = jumpForce;
            jumps++;
        }
        SetLinearVelocity2D(moveX * moveSpeed, vy);
    }
}
