using nativebridge;

// Işık ruh hali: Start'ta (ya da ApplyPreset ile) güneşi, ortam ışığını, gökyüzünü ve sisi ayarlar.
script LightingPreset : ConquerorScript
{
    public string preset = "Day";
    public bool applyOnStart = true;

    // Çalışma zamanı bilgisi
    public string applied = "";
    public float sunIntensity = 0.0;

    func Start() { if (applyOnStart) { ApplyPreset(preset); } }

    func ApplyPreset(name)
    {
        var p = LightPresetValues(name);
        if (p == null) { LogWarn("LightingPreset: unknown preset " + name); return false; }
        LightPresetApply(p);
        applied = name;
        sunIntensity = p["sunIntensity"];
        return true;
    }
}

func LightPresetNames() { return ["Day", "Golden Hour", "Sunset", "Night", "Overcast", "Studio", "Interior"]; }

func LightPresetValues(name)
{
    var p = Map();
    p["sunPitch"] = -50.0; p["sunYaw"] = -30.0; p["sunColor"] = [1.0, 0.96, 0.9]; p["sunIntensity"] = 3.0;
    p["ambientIntensity"] = 1.0; p["skyExposure"] = 1.0; p["sky"] = "Auto"; p["background"] = [0.1, 0.1, 0.1];
    p["fog"] = false; p["fogColor"] = [0.6, 0.65, 0.72]; p["fogDensity"] = 0.01; p["exposure"] = 0.0;
    if (name == "Day") { return p; }
    if (name == "Golden Hour") { p["sunPitch"] = -18.0; p["sunColor"] = [1.0, 0.78, 0.5]; p["sunIntensity"] = 2.4; p["skyExposure"] = 0.85; p["fog"] = true; p["fogColor"] = [0.85, 0.7, 0.55]; p["fogDensity"] = 0.008; return p; }
    if (name == "Sunset") { p["sunPitch"] = -6.0; p["sunColor"] = [1.0, 0.5, 0.25]; p["sunIntensity"] = 1.6; p["ambientIntensity"] = 0.7; p["skyExposure"] = 0.6; p["fog"] = true; p["fogColor"] = [0.75, 0.45, 0.35]; p["fogDensity"] = 0.012; p["exposure"] = 0.1; return p; }
    if (name == "Night") { p["sunPitch"] = -35.0; p["sunYaw"] = 150.0; p["sunColor"] = [0.55, 0.65, 1.0]; p["sunIntensity"] = 0.25; p["ambientIntensity"] = 0.25; p["skyExposure"] = 0.08; p["fog"] = true; p["fogColor"] = [0.05, 0.07, 0.12]; p["fogDensity"] = 0.015; p["exposure"] = 0.4; return p; }
    if (name == "Overcast") { p["sunPitch"] = -60.0; p["sunColor"] = [0.85, 0.88, 0.92]; p["sunIntensity"] = 0.9; p["ambientIntensity"] = 1.3; p["skyExposure"] = 0.55; p["fog"] = true; p["fogColor"] = [0.62, 0.64, 0.68]; p["fogDensity"] = 0.02; return p; }
    if (name == "Studio") { p["sunPitch"] = -40.0; p["sunYaw"] = 35.0; p["sunColor"] = [1.0, 1.0, 1.0]; p["sunIntensity"] = 2.2; p["ambientIntensity"] = 1.1; p["sky"] = "SolidColor"; p["background"] = [0.16, 0.16, 0.18]; return p; }
    if (name == "Interior") { p["sunIntensity"] = 0.0; p["ambientIntensity"] = 0.45; p["sky"] = "SolidColor"; p["background"] = [0.03, 0.03, 0.04]; p["exposure"] = 0.3; return p; }
    return null;
}

// Hazır ayarı uygula: güneş yoksa oluşturur
func LightPresetApply(p)
{
    var sun = null;
    for (var e in FindEntitiesWithComponent("DirectionalLight")) { sun = e; break; }
    if (sun == null && p["sunIntensity"] > 0)
    {
        sun = CreateEntity("Sun");
        EntityAddComponent(sun, "DirectionalLight");
    }
    if (sun != null)
    {
        EntitySetRotation(sun, p["sunPitch"], p["sunYaw"], 0);
        EntitySetComponentField(sun, "DirectionalLight", "Color", p["sunColor"]);
        EntitySetComponentField(sun, "DirectionalLight", "Intensity", p["sunIntensity"]);
    }
    RenderSettingSet("Lighting.AmbientIntensity", p["ambientIntensity"]);
    RenderSettingSet("Lighting.SkyboxExposure", p["skyExposure"]);
    RenderSettingSet("Environment.Sky", p["sky"]);
    RenderSettingSet("Environment.BackgroundColor", p["background"]);
    RenderSettingSet("Fog.Enabled", p["fog"]);
    RenderSettingSet("Fog.Color", p["fogColor"]);
    RenderSettingSet("Fog.Density", p["fogDensity"]);
    RenderSettingSet("Post.Exposure", p["exposure"]);
}
