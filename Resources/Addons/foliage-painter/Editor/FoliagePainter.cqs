using nativebridge;

// Bitki boyayıcı: seçili nesneler şablondur. Merkez: editör kamerasının odak noktası (ya da useSelectionCenter).
// Yüzey: surfaceName adlı nesne (boşsa ışının ilk çarptığı görünür nesne, şablonlar hariç).
script FoliagePainter : ConquerorScript
{
    public int count = 20;
    public float radius = 8.0;
    public float minSpacing = 0.8;
    public float minScale = 0.8;
    public float maxScale = 1.3;
    public bool randomYaw = true;
    public bool alignToNormal = false;
    public float maxSlope = 40.0;
    public float heightOffset = 0.0;
    public string surfaceName = "";
    public bool useSelectionCenter = false;
    public int seed = 0;

    // Bilgi
    public int lastPlaced = 0;
    public string lastGroup = "";
    public string status = "";

    func OnLoad()
    {
        EditorAddMenuItem("Foliage/Scatter Selection", "Scatter");
        EditorAddMenuItem("Foliage/Clear Last Batch", "ClearLast");
        EditorAddToolButton("Paint", "tree", "Scatter", "Scatter copies of the selection onto the ground around the view center");
        EditorAddPanel("Foliage Painter", "DrawPanel");
    }

    func Scatter()
    {
        var templates = EditorGetSelection();
        if (len(templates) == 0) { status = "Select one or more template objects first."; EditorNotify(status); return; }
        var center = useSelectionCenter ? EntityGetWorldPosition(templates[0]) : EditorGetCameraTarget();
        var surface = surfaceName != "" ? FindEntity(surfaceName) : null;
        var group = CreateEntity("Foliage (" + EntityGetName(templates[0]) + ")");
        lastGroup = EntityGetName(group);
        var placed = [];
        var tries = 0;
        var maxTries = count * 30;
        var cosLimit = MathCos(MathDegToRad(maxSlope));
        while (placed.Count < count && tries < maxTries)
        {
            tries++;
            var a = MathRandom() * 6.2831853;
            var r = MathSqrt(MathRandom()) * radius;
            var x = center.x + MathCos(a) * r;
            var z = center.z + MathSin(a) * r;
            var top = center.y + 500.0;
            var hit = surface != null ? EntityRaycast(surface, x, top, z, 0, -1, 0, 2000.0) : SceneRaycast(x, top, z, 0, -1, 0, 2000.0, templates[0]);
            if (hit == null) { continue; }
            if (surface == null && IsTemplateOrCopy(hit.entity, templates, group)) { continue; }
            if (hit.normal.y < cosLimit) { continue; }
            // En küçük aralık
            var ok = true;
            for (var p in placed) { if ((p.x - hit.point.x) * (p.x - hit.point.x) + (p.z - hit.point.z) * (p.z - hit.point.z) < minSpacing * minSpacing) { ok = false; break; } }
            if (!ok) { continue; }
            var t = templates[MathRandomInt(0, len(templates) - 1)];
            var copy = Instantiate(t, hit.point.x, hit.point.y + heightOffset, hit.point.z);
            if (copy == null) { continue; }
            EntitySetParent(copy, group, true);
            var k = MathRandomRange(minScale, maxScale);
            var s = EntityGetScale(t);
            EntitySetScale(copy, s.x * k, s.y * k, s.z * k);
            var rot = EntityGetRotation(t);
            var yaw = randomYaw ? MathRandomRange(0.0, 360.0) : rot.y;
            if (alignToNormal)
            {
                // Normalden eğim: X/Z eksenleri etrafında yaklaşık döndür
                var pitch = MathRadToDeg(MathAtan2(hit.normal.z, hit.normal.y));
                var roll = -MathRadToDeg(MathAtan2(hit.normal.x, hit.normal.y));
                EntitySetRotation(copy, pitch, yaw, roll);
            }
            else { EntitySetRotation(copy, rot.x, yaw, rot.z); }
            placed.Add(hit.point);
        }
        lastPlaced = placed.Count;
        status = "Placed " + str(lastPlaced) + " / " + str(count) + " in " + lastGroup;
        if (lastPlaced == 0) { EntityDestroy(group); lastGroup = ""; }
        EditorNotify(status);
    }

    func IsTemplateOrCopy(e, templates, group)
    {
        var cur = e;
        for (var i = 0; i < 16; i++)
        {
            if (cur == null || cur < 0) { return false; }
            if (cur == group || ListContains(templates, cur)) { return true; }
            var n = EntityGetName(cur);
            if (StringStartsWith(n, "Foliage (")) { return true; }
            cur = EntityGetParent(cur);
        }
        return false;
    }

    func ClearLast()
    {
        if (lastGroup == "") { return; }
        var g = FindEntity(lastGroup);
        if (g != null) { EntityDestroy(g); }
        status = "Removed " + lastGroup;
        lastGroup = "";
        EditorNotify(status);
    }

    func DrawPanel()
    {
        GuiTextDisabled(str(len(EditorGetSelection())) + " template(s) selected");
        count = GuiSliderInt("Count", count, 1, 500);
        radius = GuiSliderFloat("Radius", radius, 0.5, 200.0);
        minSpacing = GuiSliderFloat("Min Spacing", minSpacing, 0.0, 10.0);
        minScale = GuiSliderFloat("Min Scale", minScale, 0.1, 3.0);
        maxScale = GuiSliderFloat("Max Scale", maxScale, 0.1, 3.0);
        if (maxScale < minScale) { maxScale = minScale; }
        randomYaw = GuiCheckbox("Random Yaw", randomYaw);
        alignToNormal = GuiCheckbox("Align To Surface", alignToNormal);
        maxSlope = GuiSliderFloat("Max Slope", maxSlope, 0.0, 90.0);
        heightOffset = GuiDragFloat("Height Offset", heightOffset, 0.01);
        surfaceName = GuiInputText("Surface (name)", surfaceName);
        useSelectionCenter = GuiCheckbox("Center On Selection", useSelectionCenter);
        GuiBeginDisabled(len(EditorGetSelection()) == 0);
        if (GuiButton("Scatter", -1)) { EditorRunUndoable("Scatter Foliage", "Scatter"); }
        GuiEndDisabled();
        GuiBeginDisabled(lastGroup == "");
        if (GuiButton("Clear Last Batch", -1)) { EditorRunUndoable("Clear Foliage", "ClearLast"); }
        GuiEndDisabled();
        if (status != "") { GuiTextDisabled(status); }
    }
}
