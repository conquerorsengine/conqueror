using nativebridge;

// Yanıp sönme: onTime görünür, offTime gizli (ışıklarda şiddet 0'lanır).
script Blink : ConquerorScript
{
    public float onTime = 0.5;
    public float offTime = 0.5;
    public float startDelay = 0.0;

    // Çalışma zamanı bilgisi
    public bool visible = true;
    public int toggles = 0;

    private float t = 0.0;
    private float savedIntensity = -1.0;

    func Update(dt)
    {
        t += dt;
        if (t < startDelay) { return; }
        var period = MathMax(0.01, onTime + offTime);
        var on = MathRepeat(t - startDelay, period) < onTime;
        if (on == visible) { return; }
        visible = on;
        toggles++;
        SetVisible(on);
        var lightType = HasComponent("PointLight") ? "PointLight" : (HasComponent("SpotLight") ? "SpotLight" : "");
        if (lightType != "")
        {
            if (!on) { savedIntensity = GetComponentField(lightType, "Intensity"); SetComponentField(lightType, "Intensity", 0.0); }
            else if (savedIntensity >= 0) { SetComponentField(lightType, "Intensity", savedIntensity); }
        }
    }
}
