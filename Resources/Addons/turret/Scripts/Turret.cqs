using nativebridge;

// Taret: "Turret Head" (yatay dönüş) ve onun çocuğu "Turret Barrel" (dikey eğim). Namlu ucu "Muzzle".
// targetTag etiketli en yakın görünür hedefe döner, nişan hatası aimTolerance altındaysa ateş eder.
script Turret : ConquerorScript
{
    public string targetTag = "Enemy";
    public float range = 18.0;
    public float turnSpeed = 180.0;
    public float pitchSpeed = 120.0;
    public float minPitch = -20.0;
    public float maxPitch = 60.0;
    public float aimTolerance = 4.0;
    public float fireRate = 4.0;
    public float damage = 10.0;
    public bool leadTargets = true;
    public float bulletSpeed = 120.0;
    public float idleSweep = 40.0;

    // Çalışma zamanı bilgisi
    public string targetName = "";
    public int shots = 0;
    public float aimError = 180.0;
    public float yaw = 0.0;
    public float pitch = 0.0;

    private var head = null;
    private var barrel = null;
    private var muzzle = null;
    private var target = null;
    private float cooldown = 0.0;
    private float retarget = 0.0;
    private float sweepTime = 0.0;

    func Start()
    {
        head = EntityFindChild(GetEntityId(), "Turret Head");
        barrel = head != null && head >= 0 ? EntityFindChild(head, "Turret Barrel") : -1;
        muzzle = barrel != null && barrel >= 0 ? EntityFindChild(barrel, "Muzzle") : -1;
        if (head == null || head < 0) { head = GetEntityId(); }
    }

    func Origin()
    {
        if (muzzle != null && muzzle >= 0) { return EntityGetWorldPosition(muzzle); }
        if (barrel != null && barrel >= 0) { return EntityGetWorldPosition(barrel); }
        return EntityGetWorldPosition(head);
    }

    func IsMine(e)
    {
        var cur = e;
        for (var i = 0; i < 16; i++)
        {
            if (cur == null || cur < 0) { return false; }
            if (cur == GetEntityId()) { return true; }
            cur = EntityGetParent(cur);
        }
        return false;
    }

    func Visible(e)
    {
        var o = Origin();
        var t = EntityGetWorldPosition(e);
        var tx = t.x; var ty = t.y + 1.0; var tz = t.z;
        var dx = tx - o.x; var dy = ty - o.y; var dz = tz - o.z;
        var d = MathSqrt(dx * dx + dy * dy + dz * dz);
        if (d > range || d < 0.01) { return false; }
        for (var h in RaycastAll(o.x, o.y, o.z, dx / d, dy / d, dz / d, d + 0.5))
        {
            if (h.isTrigger || IsMine(h.entity)) { continue; }
            var cur = h.entity;
            for (var i = 0; i < 16; i++)
            {
                if (cur == null || cur < 0) { return false; }
                if (cur == e) { return true; }
                cur = EntityGetParent(cur);
            }
            return false;
        }
        return true;
    }

    func PickTarget()
    {
        var best = null;
        var bestD = range * range;
        var o = EntityGetWorldPosition(GetEntityId());
        for (var e in FindEntitiesWithTag(targetTag))
        {
            if (HasScript(e, "Health") && GetScriptField(e, "dead")) { continue; }
            var p = EntityGetWorldPosition(e);
            var d = (p.x - o.x) * (p.x - o.x) + (p.z - o.z) * (p.z - o.z);
            if (d < bestD && Visible(e)) { bestD = d; best = e; }
        }
        return best;
    }

    func Update(dt)
    {
        if (dt <= 0) { return; }
        if (cooldown > 0) { cooldown -= dt; }
        retarget -= dt;
        if (target != null && (!EntityIsValid(target) || (HasScript(target, "Health") && GetScriptField(target, "dead")))) { target = null; }
        if (retarget <= 0) { target = PickTarget(); retarget = 0.25; }
        targetName = target != null ? EntityGetName(target) : "";
        var baseYaw = EntityGetRotation(GetEntityId()).y;
        var wantYaw = yaw;
        var wantPitch = 0.0;
        if (target != null)
        {
            var o = Origin();
            var t = EntityGetWorldPosition(target);
            var tx = t.x; var ty = t.y + 1.0; var tz = t.z;
            if (leadTargets)
            {
                var v = GetLinearVelocity(target);
                if (v != null)
                {
                    var dist = MathSqrt((tx - o.x) * (tx - o.x) + (ty - o.y) * (ty - o.y) + (tz - o.z) * (tz - o.z));
                    var tt = dist / MathMax(1.0, bulletSpeed);
                    tx += v.x * tt; ty += v.y * tt; tz += v.z * tt;
                }
            }
            var dx = tx - o.x; var dy = ty - o.y; var dz = tz - o.z;
            wantYaw = MathRadToDeg(MathAtan2(-dx, -dz)) - baseYaw;
            wantPitch = MathClamp(MathRadToDeg(MathAtan2(dy, MathSqrt(dx * dx + dz * dz))), minPitch, maxPitch);
        }
        else
        {
            sweepTime += dt;
            wantYaw = MathSin(sweepTime * 0.6) * idleSweep;
        }
        var dYaw = MathClamp(MathNormalizeAngle(wantYaw - yaw), -turnSpeed * dt, turnSpeed * dt);
        yaw = MathNormalizeAngle(yaw + dYaw);
        pitch = pitch + MathClamp(wantPitch - pitch, -pitchSpeed * dt, pitchSpeed * dt);
        EntitySetRotation(head, 0, yaw, 0);
        if (barrel != null && barrel >= 0) { EntitySetRotation(barrel, pitch, 0, 0); }
        aimError = target != null ? MathAbs(MathNormalizeAngle(wantYaw - yaw)) + MathAbs(wantPitch - pitch) : 180.0;
        if (target != null && aimError <= aimTolerance && cooldown <= 0) { Fire(); }
    }

    func Fire()
    {
        cooldown = 1.0 / MathMax(0.01, fireRate);
        shots++;
        var o = Origin();
        var f = EntityGetForward(barrel != null && barrel >= 0 ? barrel : head);
        if (muzzle != null && muzzle >= 0) { ParticleEmit(muzzle, 5); }
        for (var h in RaycastAll(o.x, o.y, o.z, f.x, f.y, f.z, range))
        {
            if (h.isTrigger || IsMine(h.entity)) { continue; }
            SendMessage(h.entity, "Damage", damage, GetEntityName());
            if (EntityHasComponent(h.entity, "Rigidbody")) { EntityAddImpulse(h.entity, f.x * 2, f.y * 2, f.z * 2, h.point.x, h.point.y, h.point.z); }
            DebugDrawLineC({x: o.x, y: o.y, z: o.z}, h.point, 0.05, {r: 1.0, g: 0.85, b: 0.3, a: 1.0});
            return;
        }
    }
}
