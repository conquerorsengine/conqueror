using nativebridge;

// Mimari gezinti (Unreal Archviz şablonu gibi): birinci şahıs, yumuşak yürüyüş, fareyle bakış (imleç kilitli,
// Esc bırakır), 1-4 hazır kamera noktaları (bakış açılarıyla), G gündüz / akşam ışığı, F serbest uçuş.
// Kök: Character Controller; çocuk "Camera".
script ArchvizWalker : ConquerorScript
{
    public float walkSpeed = 1.6;
    public float runSpeed = 3.2;
    public float sensitivity = 0.1;
    public float eyeHeight = 0.72;
    [Header("State")]
    public bool evening = false;
    public bool flying = false;

    private var cam = -1;
    private float yaw = 0.0;
    private float pitch = 0.0;
    private float vx = 0.0;
    private float vz = 0.0;
    private float vy = 0.0;
    private float bob = 0.0;

    func Start()
    {
        cam = EntityFindChild(GetEntityId(), "Camera");
        yaw = GetRotation().y;
        SetCursorMode(2);
        SetDaylight(false);
    }

    func GoToPoint(i)
    {
        var p = FindEntity("View " + i);
        if (p == null || p < 0) { return; }
        var q = EntityGetWorldPosition(p);
        Teleport(q.x, q.y, q.z);
        var r = EntityGetRotation(p);
        yaw = r.y;
        pitch = r.x;
        vx = 0.0;
        vz = 0.0;
    }

    // Gündüz: yüksek, hafif sıcak güneş + gökyüzü; pencere portal ışıkları serin beyaz.
    // Akşam (alacakaranlık): alçak turuncu güneş, gün batımı gökyüzü, ortam ışığı azalır; pencerelerden mavi
    // alacakaranlık ışığı girer, içeride sıcak lambalar (sarkıtlar, lambader, tavan spotları, tezgâh LED'i) yanar.
    func SetDaylight(ev)
    {
        evening = ev;
        var sun = FindEntity("Sun");
        SceneSetSkybox(ev ? "Assets/Sky/evening.hdr" : "Assets/Sky/day.hdr");
        RenderSettingSet("Environment.SkyboxIntensity", ev ? 0.16 : 0.5);
        if (sun >= 0)
        {
            EntitySetRotation(sun, ev ? -9.0 : -38.0, ev ? 165.0 : 125.0, 0);
            EntitySetComponentField(sun, "DirectionalLight", "Color", ev ? {r: 1.0, g: 0.56, b: 0.3} : {r: 1.0, g: 0.93, b: 0.84});
            EntitySetComponentField(sun, "DirectionalLight", "Intensity", ev ? 1.3 : 5.0);
        }
        foreach (var w in FindEntitiesWithTag("Window Light"))
        {
            EntitySetComponentField(w, "AreaLight", "Intensity", ev ? 0.35 : 2.0);
            EntitySetComponentField(w, "AreaLight", "Color", ev ? {r: 0.55, g: 0.64, b: 0.95} : {r: 0.9, g: 0.94, b: 1.0});
        }
        foreach (var gl in FindEntitiesWithTag("Garden Light")) { EntitySetComponentField(gl, "AreaLight", "Intensity", ev ? 0.2 : 1.2); }
        foreach (var l in FindEntitiesWithTag("Lamp")) { EntitySetComponentField(l, "PointLight", "Intensity", ev ? 2.6 : 0.6); }
        foreach (var g in FindEntitiesWithTag("Lamp Glow")) { EntitySetComponentField(g, "MeshRenderer", "EmissionStrength", ev ? 6.0 : 1.0); }
        foreach (var el in FindEntitiesWithTag("Evening Light"))
        {
            if (EntityHasComponent(el, "AreaLight")) { EntitySetComponentField(el, "AreaLight", "Intensity", ev ? 2.2 : 0.4); }
            if (EntityHasComponent(el, "PointLight")) { EntitySetComponentField(el, "PointLight", "Intensity", ev ? 2.4 : 0.0); }
        }
        foreach (var sg in FindEntitiesWithTag("Shade Glow")) { EntitySetComponentField(sg, "MeshRenderer", "EmissionStrength", ev ? 0.45 : 0.0); }
        foreach (var dl in FindEntitiesWithTag("Downlight")) { EntitySetComponentField(dl, "SpotLight", "Intensity", ev ? 5.0 : 0.0); }
        foreach (var dg in FindEntitiesWithTag("Downlight Glow")) { EntitySetComponentField(dg, "MeshRenderer", "EmissionStrength", ev ? 8.0 : 0.0); }
        RenderSettingSet("Post.Exposure", ev ? -0.2 : 0.25);
    }

    func Update(dt)
    {
        if (dt > 0.1) { dt = 0.1; }
        for (var i = 1; i <= 4; i++) { if (IsKeyDown("" + i)) { GoToPoint(i); } }
        if (IsKeyDown("G")) { SetDaylight(!evening); }
        if (IsKeyDown("F")) { flying = !flying; }
        // İmleç: Esc bırakır, görünüme tıklamak geri kilitler (motor yapar)
        var md = GetMouseDelta();
        yaw = MathNormalizeAngle(yaw - md.x * sensitivity);
        pitch = MathClamp(pitch - md.y * sensitivity, -80.0, 80.0);
        SetRotation(0, yaw, 0);
        var ix = 0.0;
        var iz = 0.0;
        if (IsKeyPressed("W") || IsKeyPressed("Up")) { iz += 1.0; }
        if (IsKeyPressed("S") || IsKeyPressed("Down")) { iz -= 1.0; }
        if (IsKeyPressed("D") || IsKeyPressed("Right")) { ix += 1.0; }
        if (IsKeyPressed("A") || IsKeyPressed("Left")) { ix -= 1.0; }
        var l = MathSqrt(ix * ix + iz * iz);
        if (l > 1.0) { ix /= l; iz /= l; }
        var r = MathDegToRad(yaw);
        var sp = IsKeyPressed("LeftShift") ? runSpeed : walkSpeed;
        var tx = (-MathSin(r) * iz + MathCos(r) * ix) * sp;
        var tz = (-MathCos(r) * iz - MathSin(r) * ix) * sp;
        var k = 1.0 - MathExp(-8.0 * dt);
        vx += (tx - vx) * k;
        vz += (tz - vz) * k;
        if (flying)
        {
            var fy = (IsKeyPressed("E") ? 1.0 : 0.0) - (IsKeyPressed("Q") ? 1.0 : 0.0);
            var pr = MathDegToRad(pitch);
            CharacterMove(vx * dt * MathCos(pr), (fy * sp + MathSin(pr) * iz * sp) * dt, vz * dt * MathCos(pr));
            vy = 0.0;
        }
        else
        {
            vy = CharacterIsGrounded() ? -2.0 : vy - 20.0 * dt;
            CharacterMove(vx * dt, vy * dt, vz * dt);
        }
        // Yürürken çok hafif kafa salınımı
        var speed = MathSqrt(vx * vx + vz * vz);
        bob += dt * speed * 4.0;
        if (cam >= 0)
        {
            EntitySetPosition(cam, 0, eyeHeight + MathSin(bob * 2.0) * 0.012 * MathMin(speed, 1.0), 0);
            EntitySetRotation(cam, pitch, 0, 0);
        }
    }
}
