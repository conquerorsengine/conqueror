var l = [5, 3, 8];
l.Add(1); l.Insert(0, 9); l.RemoveAt(1);
print(l, l.Contains(8), l.IndexOf(8), l.Count);
l.Sort();
print(l, l.First, l.Last, l[-1]);
l.Sort((a, b) => b - a);
print(l.Join("-"), l.Slice(1, 3), l.Pop(), l);
print([1, 2, 3, 4, 5, 6].Where(x => x % 2 == 0).Select(x => x * 10));
print([3, 1, 2].Any(x => x > 2), [3, 1, 2].All(x => x > 2), [1, 2, 3].Find(x => x > 1));
print(["b", "a", "c"].SortBy(s => s), [[2, "b"], [1, "a"]].SortBy(p => p[0]));
var m = new Dictionary<string, int>();
m["one"] = 1; m.Set("two", 2); m.Add("three", 3);
print(m.Count, m.Keys(), m.Values(), m.ContainsKey("two"), m.Get("nope", -1));
m.Remove("one");
print(m, m.one, m.two);
var grid = new int[3];
grid[1] = 7;
print(grid, new string[2], new bool[1]);
var nested = [[1, 2], [3, [4, 5]]];
print(nested[1][1][0], nested);
var s = "  Hello, World  ";
print(s.Trim().ToUpper(), s.Trim().Length, s.Contains("World"), s.Trim().Split(", "));
print("abc".Substring(1), "abcdef".Slice(-3), "a-b-c".Replace("-", "+"), "x".Repeat(3));
print("{0} + {1} = {2:F1}".Format(1, 2, 3), "7".PadLeft(3, "0"), "Ab".ToLower());
print("line1\nline2".Lines(), "tab\there", "quote\"inside\"", "unicode: \u00e7\u011f");
var name = "Ada";
var score = 1234.5678;
print($"{name} scored {score:F2} ({score:N0}) hex {255:X} pct {0.256:P1} pad {7:D3} custom {score:0.0}");
print($"braces {{}} expr {[1,2].Count + 1} ternary {(score > 1000 ? "high" : "low")}");
print(@"C:\path\file" + "", "multi" "part");
var r = 1..5;
print(r, r.Count, r.Contains(3), r.ToList(), r[0]);
print(len("abc"), len([1]), len({a: 1}), str(12) + "3", range(3).ToList());
var lst = List(1, 2, 3);
lst.AddRange([4, 5]);
print(lst, lst.Sum(), lst.Average(), lst.Min());
var copy = lst.Copy();
copy.Clear();
print(lst.Count, copy.Count);
var dedup = [1, 1, 2, 3, 3].Distinct();
print(dedup);
var v = Vector3(1, 2, 3);
var w = v + Vector3(1, 1, 1) * 2;
print(w.x, w.y, w.z, (w - v).x);
print({ "key with space": 1, nested: { deep: true } });
