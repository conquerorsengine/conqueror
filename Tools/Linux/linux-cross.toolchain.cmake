# Linux oyuncusunu x86_64 Linux'tan başka işlemcilere çapraz derleme (clang + lld + Tools/Linux/make-linux-sysroot.sh sistem kökü):
#   Tools/Linux/make-linux-sysroot.sh riscv64 ~/riscv64-sysroot
#   cmake -S . -B build-riscv64 -G Ninja -DCMAKE_TOOLCHAIN_FILE=Tools/Linux/linux-cross.toolchain.cmake \
#         -DCQ_LINUX_ARCH=riscv64 -DCQ_LINUX_SYSROOT=~/riscv64-sysroot [-DCQ_LINUX_LLD=/path/to/ld.lld] \
#         -DCQ_RUNTIME_ONLY=ON -DGLFW_BUILD_WAYLAND=OFF
# CQ_LINUX_ARCH: arm64, armhf, i386, riscv64, ppc64el, loong64 (Debian adları)
set(CMAKE_SYSTEM_NAME Linux)

foreach(_v CQ_LINUX_ARCH CQ_LINUX_SYSROOT CQ_LINUX_LLD)
    if(NOT ${_v} AND DEFINED ENV{${_v}})
        set(${_v} "$ENV{${_v}}")
    endif()
endforeach()
if(NOT CQ_LINUX_ARCH OR NOT CQ_LINUX_SYSROOT)
    message(FATAL_ERROR "Set CQ_LINUX_ARCH (arm64, armhf, i386, riscv64, ppc64el, loong64) and CQ_LINUX_SYSROOT "
                        "(a sysroot made with Tools/Linux/make-linux-sysroot.sh)")
endif()
set(ENV{CQ_LINUX_ARCH} "${CQ_LINUX_ARCH}")
set(ENV{CQ_LINUX_SYSROOT} "${CQ_LINUX_SYSROOT}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CQ_LINUX_ARCH CQ_LINUX_SYSROOT CQ_LINUX_LLD)

if(CQ_LINUX_ARCH STREQUAL "arm64")
    set(_triple aarch64-linux-gnu)
    set(_multiarch aarch64-linux-gnu)
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
elseif(CQ_LINUX_ARCH STREQUAL "armhf")
    set(_triple armv7a-linux-gnueabihf)
    set(_multiarch arm-linux-gnueabihf)
    set(CMAKE_SYSTEM_PROCESSOR armv7)
    set(_flags "-mfpu=neon -mfloat-abi=hard")
elseif(CQ_LINUX_ARCH STREQUAL "i386")
    set(_triple i686-linux-gnu)
    set(_multiarch i386-linux-gnu)
    set(CMAKE_SYSTEM_PROCESSOR i686)
    # SSE2 (Pentium 4+): Jolt ve glm SIMD yolları; x87 kayan noktası sonuçları kare kare değiştirir
    set(_flags "-msse2 -mfpmath=sse")
elseif(CQ_LINUX_ARCH STREQUAL "riscv64")
    set(_triple riscv64-linux-gnu)
    set(_multiarch riscv64-linux-gnu)
    set(CMAKE_SYSTEM_PROCESSOR riscv64)
elseif(CQ_LINUX_ARCH STREQUAL "ppc64el")
    set(_triple powerpc64le-linux-gnu)
    set(_multiarch powerpc64le-linux-gnu)
    set(CMAKE_SYSTEM_PROCESSOR ppc64le)
elseif(CQ_LINUX_ARCH STREQUAL "loong64")
    set(_triple loongarch64-linux-gnu)
    set(_multiarch loongarch64-linux-gnu)
    set(CMAKE_SYSTEM_PROCESSOR loongarch64)
else()
    message(FATAL_ERROR "Unknown CQ_LINUX_ARCH '${CQ_LINUX_ARCH}'")
endif()

set(CMAKE_SYSROOT "${CQ_LINUX_SYSROOT}")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET ${_triple})
set(CMAKE_CXX_COMPILER_TARGET ${_triple})
set(CMAKE_LIBRARY_ARCHITECTURE ${_multiarch})
if(_flags)
    set(CMAKE_C_FLAGS_INIT "${_flags}")
    set(CMAKE_CXX_FLAGS_INIT "${_flags}")
endif()
# Debian'ın GCC kitaplıkları <sysroot>/usr/lib/gcc/<multiarch>/<sürüm> altında; clang üçlü adı farklı olduğunda (armv7a, i686)
# bulamaz: açıkça göster
file(GLOB _gccdirs LIST_DIRECTORIES true "${CQ_LINUX_SYSROOT}/usr/lib/gcc/${_multiarch}/*")
if(_gccdirs)
    list(SORT _gccdirs COMPARE NATURAL ORDER DESCENDING)
    list(GET _gccdirs 0 _gccdir)
    string(APPEND CMAKE_C_FLAGS_INIT " --gcc-install-dir=${_gccdir}")
    string(APPEND CMAKE_CXX_FLAGS_INIT " --gcc-install-dir=${_gccdir}")
endif()

if(NOT CQ_LINUX_LLD)
    find_program(CQ_LINUX_LLD NAMES ld.lld lld)
endif()
if(CQ_LINUX_LLD)
    set(ENV{CQ_LINUX_LLD} "${CQ_LINUX_LLD}")
    set(CMAKE_EXE_LINKER_FLAGS_INIT "--ld-path=${CQ_LINUX_LLD}")
    set(CMAKE_SHARED_LINKER_FLAGS_INIT "--ld-path=${CQ_LINUX_LLD}")
    set(CMAKE_MODULE_LINKER_FLAGS_INIT "--ld-path=${CQ_LINUX_LLD}")
endif()

set(CMAKE_FIND_ROOT_PATH "${CQ_LINUX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
