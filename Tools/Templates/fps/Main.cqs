// First Person arena: ızgaralı zemin, duvarlar, platformlar, fizik küpleri ve atış hedefleri;
// oyuncu: birinci şahıs kollar + tabanca + keskin nişancı tüfeği.
// @EditorCamera 40 33 0 0 1 0   (proje açıldığında editör görünümü: uzaklık, eğim, yön, odak)
OutdoorLighting(-50, -40);
ShooterFX();

Box("Floor", 0, -1, 0, 60, 1, 60, GRID);
Box("Wall North", 0, 0, -30.5, 62, 4, 1, GRID_DARK);
Box("Wall South", 0, 0, 30.5, 62, 4, 1, GRID_DARK);
Box("Wall East", 30.5, 0, 0, 1, 4, 60, GRID_DARK);
Box("Wall West", -30.5, 0, 0, 1, 4, 60, GRID_DARK);
Box("Platform", 10, 0, -12, 12, 3, 10, GRID);
Ramp("Ramp", 10, 0, 0, 7, 3, 4, 180, GRID);
Box("High Platform", -11, 0, -14, 8, 3, 8, GRID);
Stairs("Steps", -11, 0, -4, 12, 0.25, 0.5, 4, 180, GRID);
Box("Bridge", -0.5, 2.6, -14, 13, 0.4, 3, GRID);
Cylinder("Cylinder A", 18, 0, 10, 2.5, 2.5, GRID);
Cylinder("Cylinder B", -20, 0, 8, 2, 3.5, GRID);
for (var i = 0; i < 4; i++) { PhysicsCube("Cube " + i, -3 + i * 1.05, 0, 2, 1, 55); }
// Piramit: her sıra alttaki iki küpün ortasına oturur (küpler iç içe başlamaz; Play'de kımıldamaz)
for (var i = 0; i < 3; i++) { PhysicsCube("Cube " + (4 + i), -2.475 + i * 1.05, 1, 2, 1, 55); }
PhysicsCube("Cube 7", -1.95, 2, 2, 1, 55);
PhysicsCube("Cube 8", -0.9, 2, 2, 1, 55);
PhysicsCube("Cube 9", -1.425, 3, 2, 1, 55);

// Atış poligonu: duvar önünde sabit ve kayan hedefler
for (var i = 0; i < 6; i++) { Target("Target " + i, -12 + i * 4.8, 0, -27, 0, false); }
for (var i = 0; i < 3; i++) { Target("Moving Target " + i, -8 + i * 8, 0, -22, 0, true); }
Target("Platform Target", 10, 3, -16, 0, false);

var player = FPPlayer("Player", 0, 0, 14, 0, ["Pistol", "Rifle"], "Blue", 100, 3);
// Silah duvara / kübe yaklaşınca geri çekilip iner (içine girmez); yürürken kamera yatması hafif. Hız varsayılanın 1.3 katı;
// küpler daha ağır (55 kg): hızlı oyuncu küpleri savuramaz
SetFields(player, {avoidWalls: true, crispStop: true, bobRoll: 0.32, walkSpeed: 5.46, sprintSpeed: 8.84, crouchSpeed: 2.86});
Game("Range", 0, 0);
ShooterHUD();
