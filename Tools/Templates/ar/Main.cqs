// Augmented Reality (Unreal Handheld AR / Unity AR Mobile şablonu karşılığı): elde tutulan cihazla mobilya yerleştirme.
// AR Session yüzeyleri bulur (öznitelik noktaları + büyüyen düzlemler), dokunulan düzleme katalogdan seçilen mobilya
// yerleşir; seç, sürükle, boyutlandır, döndür, sil. Cihaz kamerası yokken "AR Simulation Environment" (pencereli
// oturma odası) gerçek dünyanın yerini tutar (Unity XR Simulation gibi); gerçek AR derlemesinde bu kök kapatılır,
// kamera görüntüsü arka plan olur.
// @EditorCamera 3.9 20 32 0.0 0.5 -1.1   (proje açıldığında editör görünümü: uzaklık, eğim, yön, odak)
RenderSettingSet("Environment.Sky", "Atmosphere");
RenderSettingSet("Environment.AtmosphereIntensity", 1.0);
RenderSettingSet("Environment.SkyboxIntensity", 0.6);
RenderSettingSet("Shadows.Enabled", true);
RenderSettingSet("Shadows.Quality", "Soft");
RenderSettingSet("Shadows.Distance", 25);
RenderSettingSet("Post.Tonemap", "ACES");
RenderSettingSet("Post.AntiAliasing", "TAA");
RenderSettingSet("Post.AmbientOcclusion", true);
RenderSettingSet("Post.AORadius", 0.5);
RenderSettingSet("Post.AOIntensity", 1.1);
RenderSettingSet("Post.ScreenSpaceGI", true);
RenderSettingSet("Post.SSGIIntensity", 1.3);
RenderSettingSet("Post.ScreenSpaceReflections", true);
RenderSettingSet("Post.SSRIntensity", 0.6);
RenderSettingSet("Post.Bloom", true);
RenderSettingSet("Post.BloomIntensity", 0.15);
RenderSettingSet("Post.Vignette", true);
RenderSettingSet("Post.VignetteIntensity", 0.12);
RenderSettingSet("Post.Exposure", 0.3);
RenderSettingSet("Post.DepthOfField", false);
RenderSettingSet("Fog.Enabled", false);

var SURFACE = "AR Surface";
var W = 3.5;      // oda yarı genişliği (x)
var D = 3.0;      // oda yarı derinliği (z)
var HC = 2.7;     // tavan
var T = 0.2;      // duvar kalınlığı
var PLASTER = "Assets/Textures/white_plaster.jpg";
var WHITE_WALL = {r: 1, g: 1, b: 1, a: 1};

// Simülasyon ortamı: gerçek dünyanın yerine geçen her şey bu kökün altında
var env = CreateEntity("AR Simulation Environment");
func Env(e) { EntitySetParent(e, env); return e; }
func Tex(e, tex, tiling, color, rough)
{
    EntitySetComponentField(e, "MeshRenderer", "Texture", tex);
    EntitySetComponentField(e, "MeshRenderer", "WorldAlignedUV", true);
    EntitySetComponentField(e, "MeshRenderer", "Tiling", {x: tiling, y: tiling});
    EntitySetColor(e, color);
    EntitySetComponentField(e, "MeshRenderer", "Roughness", rough);
    return e;
}
func Solid(name, x, y, z, sx, sy, sz, tex, tiling, color, rough)
{
    var e = Static(Mesh(name, "Cube", x, y, z, sx, sy, sz, "", color));
    if (tex != "") { Tex(e, tex, tiling, color, rough); }
    else { EntitySetComponentField(e, "MeshRenderer", "Roughness", rough); }
    return Env(e);
}
// Görünmez çarpıştırıcı: mobilya modellerinin AR'ın "gördüğü" yüzeyi (etiketli olanlarda düzlem bulunur)
func Collider(name, x, y, z, sx, sy, sz, tag)
{
    var e = CreateEntity(name);
    EntitySetPosition(e, x, y, z);
    EntityAddComponent(e, "Rigidbody");
    EntitySetComponentField(e, "Rigidbody", "BodyType", "Static");
    EntityAddComponent(e, "BoxCollider");
    EntitySetComponentField(e, "BoxCollider", "Size", {x: sx, y: sy, z: sz});
    EntitySetComponentField(e, "BoxCollider", "Offset", {x: 0, y: 0, z: 0});
    if (tag != "") { EntitySetTag(e, tag); }
    return Env(e);
}
// Mobilya (Poly Haven, ön yüz +Z; yaw = önün baktığı yön)
func Furn(name, file, x, y, z, yaw, scale)
{
    var e = CreateEntity(name);
    EntitySetPosition(e, x, y, z);
    EntitySetRotation(e, 0, yaw, 0);
    EntitySetScale(e, scale, scale, scale);
    EntityAddComponent(e, "Model");
    EntitySetComponentField(e, "Model", "FilePath", "Assets/Furniture/" + file + ".glb");
    return Env(e);
}

// ---------------------------------------------------------------- oda: 7 x 6 m, doğu duvarında geniş pencere
var floor = Solid("Floor", 0, -0.1, 0, 2 * W + 0.4, 0.2, 2 * D + 0.4, "Assets/Textures/laminate_floor_02.jpg", 0.45, {r: 1, g: 1, b: 1, a: 1}, 0.45);
EntitySetTag(floor, SURFACE);
Solid("Ceiling", 0, HC + 0.1, 0, 2 * W + 0.4, 0.2, 2 * D + 0.4, "", 1, {r: 0.95, g: 0.95, b: 0.94, a: 1}, 0.9);
Solid("Wall North", 0, HC / 2.0, -D - T / 2.0, 2 * W + 0.4, HC, T, PLASTER, 0.5, WHITE_WALL, 0.85);
Solid("Wall South", 0, HC / 2.0, D + T / 2.0, 2 * W + 0.4, HC, T, PLASTER, 0.5, WHITE_WALL, 0.85);
Solid("Wall West", -W - T / 2.0, HC / 2.0, 0, T, HC, 2 * D, PLASTER, 0.5, WHITE_WALL, 0.85);
var wx = W + T / 2.0;
Solid("Wall East North", wx, HC / 2.0, -2.2, T, HC, 1.6, PLASTER, 0.5, WHITE_WALL, 0.85);
Solid("Wall East South", wx, HC / 2.0, 2.2, T, HC, 1.6, PLASTER, 0.5, WHITE_WALL, 0.85);
Solid("Window Sill Wall", wx, 0.225, 0, T, 0.45, 2.8, PLASTER, 0.5, WHITE_WALL, 0.85);
Solid("Window Header", wx, 2.525, 0, T, 0.35, 2.8, PLASTER, 0.5, WHITE_WALL, 0.85);
var FRAME = {r: 0.08, g: 0.08, b: 0.09, a: 1};
Solid("Window Frame Bottom", wx, 0.47, 0, 0.12, 0.05, 2.8, "", 1, FRAME, 0.4);
Solid("Window Frame Top", wx, 2.33, 0, 0.12, 0.05, 2.8, "", 1, FRAME, 0.4);
Solid("Window Mullion", wx, 1.4, 0, 0.12, 1.86, 0.05, "", 1, FRAME, 0.4);
var glass = Env(Mesh("Window Glass", "Cube", wx, 1.4, 0, 0.02, 1.86, 2.75, "", {r: 0.02, g: 0.03, b: 0.03, a: 0.15}));
EntitySetComponentField(glass, "MeshRenderer", "Roughness", 0.02);
EntitySetComponentField(glass, "MeshRenderer", "CastShadows", false);
Solid("Window Ledge", W - 0.07, 0.465, 0, 0.16, 0.03, 2.9, "", 1, {r: 0.95, g: 0.95, b: 0.94, a: 1}, 0.4);
foreach (var sk in [{x: 0, z: -D + 0.01, sx: 2 * W, sz: 0.02}, {x: 0, z: D - 0.01, sx: 2 * W, sz: 0.02}, {x: -W + 0.01, z: 0, sx: 0.02, sz: 2 * D}])
{
    Solid("Skirting", sk.x, 0.05, sk.z, sk.sx, 0.1, sk.sz, "", 1, {r: 0.96, g: 0.96, b: 0.95, a: 1}, 0.5);
}
// Pencereden görünen bahçe
Solid("Garden Lawn", W + 20.0, -0.32, 0, 40, 0.3, 60, "Assets/Textures/lawn_grass.jpg", 0.3, {r: 0.92, g: 1.0, b: 0.88, a: 1}, 0.95);

// ---------------------------------------------------------------- mobilyalar (gerçek dünya)
// Oturma alanı (kuzey): kanepe duvara dayalı, önünde halı ve sehpa
var rug = Env(Mesh("Rug", "Cube", 0.2, 0.002, -1.25, 2.8, 0.004, 1.9, "", {r: 1, g: 1, b: 1, a: 1}));
EntitySetComponentField(rug, "MeshRenderer", "Texture", "Assets/Textures/fabric_pattern_07.jpg");
EntitySetComponentField(rug, "MeshRenderer", "Tiling", {x: 1.5, y: 1.0});
EntitySetComponentField(rug, "MeshRenderer", "Roughness", 0.95);
Furn("Sofa", "sofa_03", 0.2, 0, -2.5, 0, 1.0);
Furn("Throw Pillows", "throw_pillows_01", 0.2, 0.45, -2.45, 0, 1.0);
Collider("Sofa Seat", 0.2, 0.22, -2.45, 2.6, 0.44, 0.85, "");
Collider("Sofa Back", 0.2, 0.5, -2.82, 2.7, 1.0, 0.26, "");
