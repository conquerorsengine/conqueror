// Car Configurator (Unreal Automotive / Product Configurator karşılığı): yuvarlak stüdyo sikloraması (zemin kavisle
// duvara döner, ufuk çizgisi yok; beyaz ya da koyu), HDR yansımalar, LED halkalı krom kenarlı döner platform üstünde
// Khronos CarConcept, aracın altında yumuşak temas gölgesi. Varyant setleri: boya, iç döşeme,
// jant kaplaması, fren kaliperi; ortam (beyaz / koyu stüdyo, dış mekân), hazır kamera açıları + sürücü koltuğu,
// araç üstündeki hotspot'lar (jant, kokpit, farlar), farlar, alan derinliği, fiyat.
// @EditorCamera 8.5 14 -145 0 0.7 0   (proje açıldığında editör görünümü: uzaklık, eğim, yön, odak)
SceneSetSkybox("Assets/Studio/studio_small_09.hdr");
RenderSettingSet("Environment.Sky", "Auto");
RenderSettingSet("Environment.SkyboxIntensity", 1.0);
RenderSettingSet("Environment.ReflectionIntensity", 1.0);
RenderSettingSet("Shadows.Enabled", true);
RenderSettingSet("Shadows.Quality", "VerySoft");
RenderSettingSet("Shadows.Distance", 40);
RenderSettingSet("Post.Tonemap", "ACES");
RenderSettingSet("Post.Exposure", -0.35);
RenderSettingSet("Post.AntiAliasing", "TAA");
RenderSettingSet("Post.AmbientOcclusion", true);
RenderSettingSet("Post.AORadius", 0.8);
RenderSettingSet("Post.ScreenSpaceReflections", true);
RenderSettingSet("Post.SSRIntensity", 1.0);
RenderSettingSet("Post.SSRMaxRoughness", 0.5);
RenderSettingSet("Post.ScreenSpaceGI", true);
RenderSettingSet("Post.SSGIIntensity", 0.6);
RenderSettingSet("Post.Bloom", true);
RenderSettingSet("Post.BloomIntensity", 0.15);
RenderSettingSet("Post.Vignette", true);
RenderSettingSet("Post.VignetteIntensity", 0.18);
RenderSettingSet("Post.DepthOfField", true);
RenderSettingSet("Post.Aperture", 4.0);
RenderSettingSet("Post.FocalLength", 50.0);
RenderSettingSet("Post.FocusDistance", 7.2);
// Siklorama arka planı kendisi oluşturur: sis yok
RenderSettingSet("Fog.Enabled", false);

var key = CreateEntity("Key Light");
EntityAddComponent(key, "DirectionalLight");
EntitySetComponentField(key, "DirectionalLight", "Intensity", 1.2);
EntitySetComponentField(key, "DirectionalLight", "Color", {r: 1.0, g: 0.98, b: 0.95});
EntitySetComponentField(key, "DirectionalLight", "CastShadows", true);
EntitySetRotation(key, -70, 20, 0);
func Softbox(name, x, y, z, pitch, yaw, w, h, intensity)
{
    var a = CreateEntity(name);
    EntitySetPosition(a, x, y, z);
    EntityAddComponent(a, "AreaLight");
    EntitySetComponentField(a, "AreaLight", "Intensity", intensity);
    EntitySetComponentField(a, "AreaLight", "Size", {x: w, y: h});
    EntitySetComponentField(a, "AreaLight", "Range", 13);   // siklorama duvarları (15 m) gölgede kalır: yumuşak ışık düşüşü
    EntitySetComponentField(a, "AreaLight", "Color", {r: 1, g: 0.98, b: 0.96});
    EntitySetRotation(a, pitch, yaw, 0);
    EntitySetTag(a, "Softbox");
    return a;
}
Softbox("Softbox Top", 0, 5.5, 0, -90, 0, 6, 3, 9);
Softbox("Softbox Left", -6.5, 2.8, 0, -10, -90, 3, 2.2, 5);
Softbox("Softbox Right", 6.5, 2.8, 0, -10, 90, 3, 2.2, 5);
Softbox("Softbox Back", 0, 2.6, 7, -12, 0, 4, 2, 3.5);

// Stüdyo: 15 m yarıçaplı yuvarlak siklorama (zemin 10 m'den sonra 5 m yarıçapla kavislenip duvara döner).
// Beyaz ve koyu iki kopya; ortam seçimi hangisinin açık olacağını belirler. Dış mekânda ikisi de kapanır, geniş zemin açılır.
func StudioModel(name, path)
{
    var e = CreateEntity(name);
    EntityAddComponent(e, "Model");
    EntitySetComponentField(e, "Model", "FilePath", path);
    return e;
}
StudioModel("Studio Cyc", "Assets/Studio/Cyclorama.glb");
var darkCyc = StudioModel("Dark Cyc", "Assets/Studio/Cyclorama_Dark.glb");
EntitySetActive(darkCyc, false);
var ground = Mesh("Outdoor Ground", "Cylinder", 0, -0.05, 0, 240, 0.1, 240, "", {r: 0.32, g: 0.33, b: 0.34, a: 1});
EntitySetComponentField(ground, "MeshRenderer", "Roughness", 0.75);
EntitySetActive(ground, false);
// Döner platform (koyu grafit üst, krom kenar, tabanda LED şerit); araç bunun çocuğu
var table = StudioModel("Turntable", "Assets/Studio/Turntable.glb");

// Araç (platformun çocuğu, fizik yok): gövde, iç döşeme, kaliperler, 4 tekerlek + jant, farlar, hotspot'lar
func AddPart(name, parent, path, x, y, z)
{
    var e = CreateEntity(name);
    EntitySetParent(e, parent);
    EntitySetPosition(e, x, y, z);
    EntityAddComponent(e, "Model");
    EntitySetComponentField(e, "Model", "FilePath", path);
    return e;
}
var MP = "Assets/Vehicles/Models/ConceptCar/";
var car = CreateEntity("Car");
EntitySetParent(car, table);
EntitySetPosition(car, 0, 0.075, 0);   // platformun üst yüzü
AddPart("Car Body", car, MP + "Body_Carmine.glb", 0, 0, 0);
AddPart("Car Interior", car, MP + "Interior_Carmine.glb", 0, 0, 0);
AddPart("Car Calipers", car, MP + "Calipers_Red.glb", 0, 0, 0);
var wheels = [{n: "FL", x: -0.976, z: -1.485}, {n: "FR", x: 0.977, z: -1.484}, {n: "RL", x: -0.982, z: 1.314}, {n: "RR", x: 0.982, z: 1.314}];
foreach (var w in wheels)
{
    var wh = AddPart("Wheel " + w.n, car, MP + "Wheel_" + w.n + ".glb", w.x, 0.384, w.z);
    AddPart("Rim " + w.n, wh, MP + "Rim_" + w.n + "_Chrome.glb", 0, 0, 0);
}
for (var s = -1; s <= 1; s += 2)
{
    var hl = CreateEntity("Headlight " + (s < 0 ? "L" : "R"));
    EntitySetParent(hl, car);
    EntitySetPosition(hl, s * 0.72, 0.7, -2.2);
    EntityAddComponent(hl, "SpotLight");
    EntitySetComponentField(hl, "SpotLight", "Color", {r: 0.85, g: 0.92, b: 1.0});
    EntitySetComponentField(hl, "SpotLight", "Intensity", 0.0);
    EntitySetComponentField(hl, "SpotLight", "Range", 18);
    EntitySetComponentField(hl, "SpotLight", "InnerConeAngle", 14);
    EntitySetComponentField(hl, "SpotLight", "OuterConeAngle", 28);
    EntitySetComponentField(hl, "SpotLight", "CastShadows", false);
    EntitySetTag(hl, "Headlight");
    EntitySetRotation(hl, -6, 0, 0);
}
// Temas gölgesi: aracın altında yarı saydam siyah elips düzlem (ışıksız, son rengin üstüne harmanlanır: parlak
// platformun yansımalarını da karartır; albedo karartan decal koyu parlak yüzeyde görünmüyordu). Araçla döner,
// tekerlek altları daha koyu.
var shadow = Mesh("Contact Shadow", "Plane", 0, 0, 0, 2.5, 1.0, 5.2, "", {r: 0, g: 0, b: 0, a: 0.92});
EntitySetParent(shadow, car);
EntitySetPosition(shadow, 0, 0.004, -0.08);
EntitySetComponentField(shadow, "MeshRenderer", "Texture", "Assets/Studio/ContactShadow.png");
EntitySetComponentField(shadow, "MeshRenderer", "Unlit", true);
EntitySetComponentField(shadow, "MeshRenderer", "CastShadows", false);
EntitySetComponentField(shadow, "MeshRenderer", "ReceiveShadows", false);
// Hotspot'lar: kameraya dönük halka simgesi (Configurator ışın ile seçer, nabız gibi atar)
foreach (var hp in [{n: "Wheel", x: -1.12, y: 0.42, z: -1.485}, {n: "Interior", x: 0, y: 1.2, z: -0.3}, {n: "Lights", x: -0.72, y: 0.72, z: -2.3}])
{
    var h = CreateEntity("Hotspot " + hp.n);
    EntitySetParent(h, car);
    EntitySetPosition(h, hp.x, hp.y, hp.z);
    EntityAddComponent(h, "BillboardRenderer");
    EntitySetComponentField(h, "BillboardRenderer", "Texture", "Assets/Studio/Hotspot.png");
    EntitySetComponentField(h, "BillboardRenderer", "Color", {r: 0.6, g: 0.85, b: 1.0, a: 1});
    EntitySetComponentField(h, "BillboardRenderer", "Size", {x: 0.24, y: 0.24});
    EntitySetComponentField(h, "BillboardRenderer", "Alignment", "FaceCamera");
    EntitySetComponentField(h, "BillboardRenderer", "PivotAtBottom", false);
    EntitySetComponentField(h, "BillboardRenderer", "AlphaCutoff", 0.25);
    EntitySetComponentField(h, "BillboardRenderer", "Lit", false);
    EntityAddComponent(h, "Rigidbody");
    EntitySetComponentField(h, "Rigidbody", "BodyType", "Kinematic");   // platformla döner
    EntityAddComponent(h, "SphereCollider");
    EntitySetComponentField(h, "SphereCollider", "Radius", 0.13);   // tıklaması kolay
    EntitySetTag(h, "Hotspot");
}

var cam = CreateEntity("Camera");
EntitySetPosition(cam, 4.1, 2.25, -5.8);
EntityAddComponent(cam, "Camera");
EntitySetComponentField(cam, "Camera", "Primary", true);
EntitySetComponentField(cam, "Camera", "FieldOfView", 45);
EntitySetComponentField(cam, "Camera", "NearClip", 0.05);
EntitySetComponentField(cam, "Camera", "Background", "SolidColor");
EntitySetComponentField(cam, "Camera", "BackgroundColor", {r: 0.86, g: 0.87, b: 0.88, a: 1});
EntityAddComponent(cam, "AudioListener");
AddScript(cam, "Assets/Scripts/OrbitCamera.cqs");
EntitySetRotation(cam, -12, 145, 0);

var game = CreateEntity("Configurator");
AddScript(game, "Assets/Scripts/Configurator.cqs");

// Arayüz: solda model / seçim / fiyat, sağda seçenek paneli
var ui = UICreateCanvas("UI");
EntitySetComponentField(ui, "CanvasScaler", "ReferenceResolution", {x: 1920, y: 1080});
EntitySetComponentField(ui, "CanvasScaler", "MatchWidthOrHeight", 0.5);
var flash = HudImage("Flash", ui, "", 0, 0, 0, 0, 0, 0);
EntitySetComponentField(flash, "RectTransform", "AnchorMax", {x: 1, y: 1});
EntitySetComponentField(flash, "RectTransform", "SizeDelta", {x: 0, y: 0});
EntitySetColor(flash, 1, 1, 1, 1);
UISetAlpha(flash, 0);
var titleBack = HudImage("Title Back", ui, "", 330, -120, 600, 190, 0, 1);
EntitySetColor(titleBack, 0.03, 0.035, 0.04, 0.6);
EntitySetComponentField(titleBack, "UIImage", "CornerRadius", 14);
HudText("ModelName", ui, "CONCEPT GT", 330, -75, 540, 70, 58, "Left", 0, 1);
HudText("PaintName", ui, "", 330, -132, 540, 36, 22, "Left", 0, 1);
HudText("PriceText", ui, "", 330, -172, 540, 40, 30, "Left", 0, 1);
var panel = HudImage("Options Panel", ui, "", -190, 0, 340, 1000, 1, 0.5);
EntitySetColor(panel, 0.03, 0.035, 0.04, 0.66);
EntitySetComponentField(panel, "UIImage", "CornerRadius", 14);

func Swatch(set, option, col, x, y)
{
    var ring = HudImage(set + " Ring " + option, ui, "", x, y, 70, 70, 1, 0.5);
    EntitySetColor(ring, 1, 1, 1, 1);
    EntitySetComponentField(ring, "UIImage", "CornerRadius", 35);
    var b = UICreateElement("Button", ui, set + " " + option);
    UISetPosition(b, x, y);
    UISetSize(b, 58, 58);
    EntitySetColor(b, col.r, col.g, col.b, 1);
    EntitySetComponentField(b, "UIImage", "CornerRadius", 29);
    EntitySetComponentField(b, "RectTransform", "AnchorMin", {x: 1, y: 0.5});
    EntitySetComponentField(b, "RectTransform", "AnchorMax", {x: 1, y: 0.5});
    UISetText(b, "");
}
func Row(header, set, options, y)
{
    HudText(set + " Header", ui, header, -190, y + 52, 290, 30, 22, "Left", 1, 0.5);
    for (var i = 0; i < options.Count; i++) { Swatch(set, options[i].n, options[i].c, -280 + i * 88, y); }
}
Row("PAINT", "Paint", [{n: "Carmine", c: {r: 0.55, g: 0.02, b: 0.03}}, {n: "Pearl", c: {r: 0.86, g: 0.85, b: 0.82}}, {n: "Graphite", c: {r: 0.12, g: 0.12, b: 0.13}}], 400);
Row("INTERIOR", "Interior", [{n: "Carmine", c: {r: 0.5, g: 0.04, b: 0.02}}, {n: "Pearl", c: {r: 0.92, g: 0.92, b: 0.9}}, {n: "Graphite", c: {r: 0.05, g: 0.1, b: 0.2}}], 270);
Row("WHEELS", "Rims", [{n: "Chrome", c: {r: 0.78, g: 0.8, b: 0.83}}, {n: "Black", c: {r: 0.04, g: 0.04, b: 0.05}}, {n: "Bronze", c: {r: 0.55, g: 0.36, b: 0.16}}], 140);
Row("CALIPERS", "Calipers", [{n: "Red", c: {r: 0.75, g: 0.04, b: 0.03}}, {n: "Yellow", c: {r: 0.95, g: 0.7, b: 0.05}}, {n: "Black", c: {r: 0.05, g: 0.05, b: 0.05}}], 10);

func TextButton(name, label, x, y, w)
{
    var b = UICreateElement("Button", ui, name);
    UISetPosition(b, x, y);
    UISetSize(b, w, 46);
    EntitySetColor(b, 0.12, 0.13, 0.15, 0.8);
    EntitySetComponentField(b, "RectTransform", "AnchorMin", {x: 1, y: 0.5});
    EntitySetComponentField(b, "RectTransform", "AnchorMax", {x: 1, y: 0.5});
    UISetText(b, label);
    UISetFontSize(b, 20);
    UISetTextColor(b, 0.92, 0.92, 0.94, 1);
    return b;
}
HudText("View Header", ui, "CAMERA", -190, -78, 290, 30, 22, "Left", 1, 0.5);
var views = ["Orbit", "Front", "Side", "Rear", "Top", "Interior"];
for (var v = 0; v < views.Count; v++) { TextButton("View " + views[v], StringToUpper(views[v]), -260 + (v % 2) * 140, -125 - MathFloor(v / 2) * 54, 128); }
HudText("Env Header", ui, "ENVIRONMENT", -190, -305, 290, 30, 22, "Left", 1, 0.5);
var envs = [{n: "Studio", l: "STUDIO"}, {n: "Dark", l: "DARK"}, {n: "Outdoor", l: "OUTDOOR"}];
for (var e = 0; e < envs.Count; e++) { var eb = TextButton("Env " + envs[e].n, envs[e].l, -284 + e * 94, -352, 90); UISetFontSize(eb, 16); }
TextButton("Turntable", "TURNTABLE  ON", -190, -418, 270);
TextButton("Lights", "HEADLIGHTS  OFF", -190, -470, 270);
var hintBack = HudImage("Hint Back", ui, "", -170, 26, 1260, 44, 0.5, 0);
EntitySetColor(hintBack, 0.03, 0.035, 0.04, 0.55);
EntitySetComponentField(hintBack, "UIImage", "CornerRadius", 12);
HudText("HintText", ui, "DRAG  ORBIT      WHEEL  ZOOM      CLICK GLOWING POINTS  DETAILS      1-3  PAINT      F / S / R / T / I / O  VIEWS", -170, 30, 1240, 30, 22, "Center", 0.5, 0);
