Station(14, "INSTANCING + LOD", "Multi Mesh draws 12000 cubes in one call; LOD Groups switch meshes by on-screen size", 112, 14, false);
var turntable = Mesh("Instancing Turntable", "Cylinder", 115.3, 0.35, 14.8, 5.8, 0.1, 5.8, "", Col(0.08, 0.085, 0.095));
EntitySetComponentField(turntable, "MeshRenderer", "Roughness", 0.45);
var field = CreateEntity("Instanced Field");
EntitySetPosition(field, 115.3, 1.1, 14.8);
EntityAddComponent(field, "MultiMesh");
EntitySetComponentField(field, "MultiMesh", "Primitive", "Cube");
EntitySetComponentField(field, "MultiMesh", "Color", {r: 0.35, g: 0.7, b: 1.0, a: 1});
EntitySetComponentField(field, "MultiMesh", "Roughness", 0.4);
EntitySetComponentField(field, "MultiMesh", "Mode", "Scatter");
EntitySetComponentField(field, "MultiMesh", "Count", 12000);
EntitySetComponentField(field, "MultiMesh", "Area", {x: 4.2, y: 1.0, z: 4.2});   // dönen küp bulutu
EntitySetComponentField(field, "MultiMesh", "ScaleRange", {x: 0.02, y: 0.05});
EntitySetComponentField(field, "MultiMesh", "RandomYaw", true);
EntitySetComponentField(field, "MultiMesh", "ColorVariation", 0.55);
EntitySetComponentField(field, "MultiMesh", "Seed", 7);
