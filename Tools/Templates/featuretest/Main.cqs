EntitySetComponentField(door, "HingeJoint", "Axis", {x: 0, y: 1, z: 0});
EntitySetComponentField(door, "HingeJoint", "UseLimits", true);
EntitySetComponentField(door, "HingeJoint", "MinAngle", -110);
