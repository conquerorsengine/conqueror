Station(18, "FORCES", "explosion force throws a crate pyramid; Constant Force balloons pull on Spring Joint strings", -112, 14, false);
var blastCrates = 0;
for (var br = 0; br < 4; br++)
{
    for (var bc = 0; bc < 4 - br; bc++)
    {
        var bx = -110.2 + (bc - (3 - br) / 2.0) * 0.62;
        var bcr = DynBody("Blast Crate " + br + bc, "Cube", bx, 0.6 + br * 0.61, 15.0, 0.6, 0.6, 0.6, WHITE, 10);
        EntitySetComponentField(bcr, "MeshRenderer", "Texture", GRID_ORANGE);
        EntitySetComponentField(bcr, "MeshRenderer", "WorldAlignedUV", true);
        EntitySetComponentField(bcr, "MeshRenderer", "AlignToObject", true);
        EntitySetComponentField(bcr, "MeshRenderer", "Offset", {x: 0.5, y: 0.5});
        blastCrates++;
    }
}
var blast = CreateEntity("Blast Point");
EntitySetPosition(blast, -110.2, 0.45, 14.3);
AddScript(blast, "Assets/Scripts/ExplosionDemo.cqs");
var bflash = CreateEntity("Blast Flash");
EntitySetPosition(bflash, -110.2, 0.9, 14.1);
EntityAddComponent(bflash, "PointLight");
EntitySetComponentField(bflash, "PointLight", "Color", {r: 1.0, g: 0.6, b: 0.25});
EntitySetComponentField(bflash, "PointLight", "Intensity", 0.0);
EntitySetComponentField(bflash, "PointLight", "Range", 9.0);
var bsparks = Particles("Blast Sparks", null, {RateOverTime: 0, StartLifetime: {x: 0.4, y: 1.0}, StartSpeed: {x: 4, y: 10}, StartSize: {x: 0.04, y: 0.1},
    StartColorA: {r: 1, g: 0.8, b: 0.35, a: 1}, StartColorB: {r: 1, g: 0.45, b: 0.1, a: 1}, Shape: "Sphere", Radius: 0.2, GravityModifier: 1.2,
    Blend: "Additive", EmissiveIntensity: 8, MaxParticles: 400});
EntitySetPosition(bsparks, -110.2, 0.6, 14.3);
var bsmoke = Particles("Blast Smoke", null, {RateOverTime: 0, StartLifetime: {x: 1.2, y: 2.4}, StartSpeed: {x: 0.6, y: 2.2}, StartSize: {x: 0.6, y: 1.2},
    StartColorA: {r: 0.62, g: 0.6, b: 0.57, a: 0.35}, StartColorB: {r: 0.45, g: 0.44, b: 0.42, a: 0.25}, Shape: "Sphere", Radius: 0.4, GravityModifier: -0.05,
    SizeOverLifetimeEnabled: true, SizeOverLifetimeKeys: "0:0.6; 1:2.2", MaxParticles: 200});
EntitySetPosition(bsmoke, -110.2, 0.7, 14.3);
FloorLabel("EXPLOSION FORCE", -110.2, 9.4, false);
// Balonlar: Constant Force yukarı çeker, Spring Joint (en çok ip boyu) zemindeki ağırlığa bağlar
Box("Balloon Weight", -115.4, 0.3, 14.6, 0.5, 0.3, 0.5, GRID_DARK);
var bcols = [Col(0.95, 0.15, 0.2), Col(1.0, 0.8, 0.1), Col(0.2, 0.5, 1.0)];
for (var bl = 0; bl < 3; bl++)
{
    var ax = -115.4 + (bl - 1) * 0.12;
    var bxp = -115.4 + (bl - 1) * 0.75;
    var byp = 2.1 + (bl % 2) * 0.25;
    var balloon = Mesh("Balloon " + bl, "Sphere", bxp, byp, 14.6 + (bl == 1 ? 0.3 : 0.0), 0.62, 0.74, 0.62, "", bcols[bl]);
    EntitySetComponentField(balloon, "MeshRenderer", "Roughness", 0.22);
    EntityAddComponent(balloon, "Rigidbody");
    EntitySetComponentField(balloon, "Rigidbody", "BodyType", "Dynamic");
    EntitySetComponentField(balloon, "Rigidbody", "Mass", 0.25);
    EntitySetComponentField(balloon, "Rigidbody", "LinearDrag", 1.2);
    EntitySetComponentField(balloon, "Rigidbody", "AngularDrag", 2.0);
    EntitySetComponentField(balloon, "Rigidbody", "AllowSleep", false);
    EntityAddComponent(balloon, "SphereCollider");
    EntityAddComponent(balloon, "ConstantForce");
    EntitySetComponentField(balloon, "ConstantForce", "Force", {x: 0, y: 4.2, z: 0});
    EntityAddComponent(balloon, "SpringJoint");
    EntitySetComponentField(balloon, "SpringJoint", "Anchor", {x: 0, y: -1, z: 0});
    EntitySetComponentField(balloon, "SpringJoint", "AutoConfigureConnectedAnchor", false);
    EntitySetComponentField(balloon, "SpringJoint", "ConnectedAnchor", {x: ax, y: 0.6, z: 14.6});
    EntitySetComponentField(balloon, "SpringJoint", "Spring", 60);
    EntitySetComponentField(balloon, "SpringJoint", "Damper", 0.6);
    EntitySetComponentField(balloon, "SpringJoint", "MaxDistance", 1.45 + (bl % 2) * 0.25);
    var str = CreateEntity("Balloon String " + bl);
    EntityAddComponent(str, "LineRenderer");
    EntitySetComponentField(str, "LineRenderer", "UseWorldSpace", true);
    EntitySetComponentField(str, "LineRenderer", "StartWidth", 0.012);
    EntitySetComponentField(str, "LineRenderer", "EndWidth", 0.012);
    EntitySetComponentField(str, "LineRenderer", "StartColor", {r: 0.92, g: 0.92, b: 0.92, a: 1});
    EntitySetComponentField(str, "LineRenderer", "EndColor", {r: 0.92, g: 0.92, b: 0.92, a: 1});
    AddScript(balloon, "Assets/Scripts/Balloon.cqs");
    SetFields(balloon, {anchorX: ax, anchorY: 0.6, anchorZ: 14.6, radius: 0.34, phase: bl * 2.1, stringName: "Balloon String " + bl});
}
FloorLabel("CONSTANT FORCE + SPRING", -115.4, 9.4, false);
