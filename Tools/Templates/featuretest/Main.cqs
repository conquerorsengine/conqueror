EntitySetComponentField(rider, "SplineAnimate", "AlignToPath", true);
EntitySetComponentField(rider, "SplineAnimate", "PlayOnAwake", true);
EntityAddComponent(rider, "TrailRenderer");
EntitySetComponentField(rider, "TrailRenderer", "Time", 1.2);
EntitySetComponentField(rider, "TrailRenderer", "StartWidth", 0.25);
EntitySetComponentField(rider, "TrailRenderer", "EndWidth", 0.0);
EntitySetComponentField(rider, "TrailRenderer", "StartColor", {r: 1, g: 0.6, b: 0.1, a: 1});
EntitySetComponentField(rider, "TrailRenderer", "EndColor", {r: 1, g: 0.2, b: 0.05, a: 0});
EntitySetComponentField(rider, "TrailRenderer", "Emissive", 3.0);
var line = CreateEntity("Line Renderer");
EntitySetPosition(line, 56, 0.3, 14);
EntityAddComponent(line, "LineRenderer");
var pts = [];
for (var k = 0; k <= 24; k++) { var a2 = k / 24.0 * 3.1415926; pts.Add({x: MathCos(a2) * 5.0, y: 0.05 + MathSin(a2) * 4.0, z: 4.5}); }
EntitySetComponentField(line, "LineRenderer", "Positions", pts);
EntitySetComponentField(line, "LineRenderer", "UseWorldSpace", false);
EntitySetComponentField(line, "LineRenderer", "StartWidth", 0.08);
EntitySetComponentField(line, "LineRenderer", "EndWidth", 0.08);
EntitySetComponentField(line, "LineRenderer", "StartColor", {r: 0.2, g: 0.8, b: 1, a: 1});
EntitySetComponentField(line, "LineRenderer", "EndColor", {r: 0.8, g: 0.3, b: 1, a: 1});
EntitySetComponentField(line, "LineRenderer", "Emissive", 2.0);
// ---------------------------------------------------------------- 11 Eklemler
Station(11, "JOINTS", "ball-joint chain + wrecking ball, motor hinge, slider piston, spring-loaded door, spring joint", 84, -14, true);
// Yıkım topu: Ball Joint zinciri portal kirişinden sarkar; WreckingBall betiği sola çekip bırakır, sandık yığınına çarpar
var PIVOT_X = 79.8;
var PIVOT_Y = 4.85;
var PIVOT_Z = -14.0;
Box("Gantry Post A", PIVOT_X, 0.3, -15.75, 0.22, 4.85, 0.22, GRID_DARK);
Box("Gantry Post B", PIVOT_X, 0.3, -12.25, 0.22, 4.85, 0.22, GRID_DARK);
Box("Gantry Beam", PIVOT_X, 4.85, PIVOT_Z, 0.3, 0.3, 3.72, GRID_DARK);
var prevLink = -1;
for (var ci = 0; ci < 8; ci++)
{
    var link = Steel(DynBody("Chain Link " + ci, "Cylinder", PIVOT_X, PIVOT_Y - (ci + 0.5) * 0.36, PIVOT_Z, 0.08, 0.36, 0.08, Col(0.3, 0.31, 0.33), 30), 0.35);
    EntityAddComponent(link, "BallJoint");
    EntitySetComponentField(link, "BallJoint", "Anchor", {x: 0, y: 1, z: 0});   // halkanın üst ucu (yerel: birim silindir -1..1)
    if (prevLink >= 0) { EntitySetComponentField(link, "BallJoint", "ConnectedBody", prevLink); }
    prevLink = link;
}
var wball = Steel(DynBody("Wrecking Ball", "Sphere", PIVOT_X, PIVOT_Y - 8 * 0.36 - 0.45, PIVOT_Z, 0.9, 0.9, 0.9, Col(0.13, 0.13, 0.14), 160), 0.3);
EntityAddComponent(wball, "BallJoint");
EntitySetComponentField(wball, "BallJoint", "Anchor", {x: 0, y: 1, z: 0});
EntitySetComponentField(wball, "BallJoint", "ConnectedBody", prevLink);
var wrig = CreateEntity("Wrecking Ball Rig");
EntitySetPosition(wrig, PIVOT_X, PIVOT_Y, PIVOT_Z);
AddScript(wrig, "Assets/Scripts/WreckingBall.cqs");
for (var cy = 0; cy < 4; cy++)
{
    for (var cx = 0; cx < 2; cx++)
    {
        for (var cz = 0; cz < 2; cz++)
        {
            var crate = DynBody("Joint Crate " + cy + cx + cz, "Cube", 80.56 + cx * 0.52, 0.55 + cy * 0.505, -14.26 + cz * 0.52, 0.5, 0.5, 0.5, WHITE, 12);
            EntitySetComponentField(crate, "MeshRenderer", "Texture", GRID_ORANGE);
            EntitySetComponentField(crate, "MeshRenderer", "WorldAlignedUV", true);
            EntitySetComponentField(crate, "MeshRenderer", "AlignToObject", true);
            EntitySetComponentField(crate, "MeshRenderer", "Offset", {x: 0.5, y: 0.5});
            EntitySetComponentField(crate, "MeshRenderer", "Roughness", 0.55);
        }
    }
}
FloorLabel("BALL JOINT CHAIN", 80.9, -11.5, true);
// Motorlu menteşe: pervane göbeği Hinge Joint (Z ekseni) + motor; kanatlar göbeğin çocuk çarpıştırıcıları (bileşik gövde)
Box("Windmill Post", 88.8, 0.3, -18.15, 0.18, 1.95, 0.18, GRID_DARK);
var hub = Mesh("Windmill Hub", "Sphere", 88.8, 2.25, -17.78, 0.26, 0.26, 0.26, "", Col(0.85, 0.86, 0.88));
Steel(hub, 0.3);
EntityAddComponent(hub, "Rigidbody");
EntitySetComponentField(hub, "Rigidbody", "BodyType", "Dynamic");
EntitySetComponentField(hub, "Rigidbody", "Mass", 20);
EntitySetComponentField(hub, "Rigidbody", "AllowSleep", false);
EntityAddComponent(hub, "SphereCollider");
for (var wb = 0; wb < 4; wb++)
{
    var ang = wb * 90.0;
    var ar = MathDegToRad(ang);
    var blade = Mesh("Windmill Blade " + wb, "Cube", 88.8 + MathCos(ar) * 0.78, 2.25 + MathSin(ar) * 0.78, -17.78, 1.2, 0.26, 0.05, "", wb % 2 == 0 ? Col(0.92, 0.25, 0.18) : Col(0.95, 0.95, 0.95));
    EntitySetRotation(blade, 0, 0, ang);
    EntitySetComponentField(blade, "MeshRenderer", "Roughness", 0.5);
    EntityAddComponent(blade, "BoxCollider");
    EntitySetParent(blade, hub);
}
EntityAddComponent(hub, "HingeJoint");
EntitySetComponentField(hub, "HingeJoint", "Axis", {x: 0, y: 0, z: 1});
EntitySetComponentField(hub, "HingeJoint", "UseMotor", true);
EntitySetComponentField(hub, "HingeJoint", "MotorTargetVelocity", 55);
EntitySetComponentField(hub, "HingeJoint", "MotorForce", 3000);
FloorLabel("HINGE + MOTOR", 88.6, -16.2, true);
// Piston (Slider Joint + motor, PistonDemo yönünü değiştirir) yaylı kapıyı (Hinge Joint + spring + limit) iter
