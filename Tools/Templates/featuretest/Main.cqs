// ---------------------------------------------------------------- 12 IK + kısıtlar
Station(12, "IK + CONSTRAINTS", "Animation Rigging: Two Bone IK hands and Multi-Aim head follow the orb; Aim and Look At constraints", 84, 14, false);
var ikActor = Actor("IK Mannequin", 84, 0.3, 15.3, 180, "Mannequin_Male", "idle");
var ikOrb = Mesh("IK Orb", "Sphere", 84, 1.38, 14.95, 0.26, 0.26, 0.26, "", Col(1.0, 0.55, 0.15));
EntitySetComponentField(ikOrb, "MeshRenderer", "EmissionColor", {r: 1.0, g: 0.55, b: 0.15});
EntitySetComponentField(ikOrb, "MeshRenderer", "EmissionStrength", 6.0);
EntitySetComponentField(ikOrb, "MeshRenderer", "CastShadows", false);
EntityAddComponent(ikOrb, "PointLight");
EntitySetComponentField(ikOrb, "PointLight", "Color", {r: 1.0, g: 0.6, b: 0.25});
EntitySetComponentField(ikOrb, "PointLight", "Intensity", 2.5);
EntitySetComponentField(ikOrb, "PointLight", "Range", 3.0);
AddScript(ikOrb, "Assets/Scripts/IKOrb.cqs");
// Baş küreye bakar (Multi-Aim: kafa kemiğinin +Z ekseni yüz yönü, +Y yukarı)
var headAim = CreateEntity("Head Aim");
EntitySetParent(headAim, ikActor);
EntityAddComponent(headAim, "MultiAimConstraint");
EntitySetComponentField(headAim, "MultiAimConstraint", "Bone", "Head");
EntitySetComponentField(headAim, "MultiAimConstraint", "Target", ikOrb);
EntitySetComponentField(headAim, "MultiAimConstraint", "AimAxis", "Z");
EntitySetComponentField(headAim, "MultiAimConstraint", "UpAxis", "Y");
EntitySetComponentField(headAim, "MultiAimConstraint", "MaxAngle", 75);
// Eller: Two Bone IK, dirsek ipuçları arkada ve dışarıda; ağırlıkları IKOrb sürer
for (var hs = 0; hs < 2; hs++)
{
    var sfx = hs == 0 ? "r" : "l";
    var sx = hs == 0 ? 1.0 : -1.0;     // manken -Z'ye bakıyor: sağ eli +X tarafında
    var tgt = CreateEntity("IK Target " + StringToUpper(sfx));
    EntitySetPosition(tgt, 84 + sx * 0.3, 1.3, 14.7);
    var hint = CreateEntity("Elbow Hint " + StringToUpper(sfx));
    EntitySetPosition(hint, 84 + sx * 0.75, 1.0, 15.9);
    var ik = CreateEntity("IK Hand " + StringToUpper(sfx));
    EntitySetParent(ik, ikActor);
    EntityAddComponent(ik, "TwoBoneIKConstraint");
    EntitySetComponentField(ik, "TwoBoneIKConstraint", "Root", "upperarm_" + sfx);
    EntitySetComponentField(ik, "TwoBoneIKConstraint", "Mid", "lowerarm_" + sfx);
    EntitySetComponentField(ik, "TwoBoneIKConstraint", "Tip", "hand_" + sfx);
    EntitySetComponentField(ik, "TwoBoneIKConstraint", "Target", tgt);
    EntitySetComponentField(ik, "TwoBoneIKConstraint", "Hint", hint);
    EntitySetComponentField(ik, "TwoBoneIKConstraint", "TargetRotationWeight", 0.0);
    EntitySetComponentField(ik, "TwoBoneIKConstraint", "Weight", 0.0);
}
// Taretler küreyi namluyla izler (Aim Constraint: yerel -Z küreye)
func Turret(name, x, z, target)
{
    var pedestalT = Mesh(name + " Base", "Cylinder", x, 0.3 + 0.4, z, 0.42, 0.8, 0.42, "", Col(0.16, 0.17, 0.19));
    EntitySetComponentField(pedestalT, "MeshRenderer", "Roughness", 0.5);
    var head = CreateEntity(name + " Head");
    EntitySetPosition(head, x, 1.25, z);
    var housing = Steel(Mesh(name + " Housing", "Cube", x, 1.25, z, 0.46, 0.3, 0.52, "", Col(0.85, 0.86, 0.9)), 0.35);
    EntitySetComponentField(housing, "MeshRenderer", "Metallic", 0.6);
    EntitySetParent(housing, head);
    var barrel = Steel(Mesh(name + " Barrel", "Cylinder", x, 1.27, z - 0.55, 0.09, 0.62, 0.09, "", Col(0.2, 0.2, 0.22)), 0.3);
    EntitySetRotation(barrel, 90, 0, 0);
    EntitySetParent(barrel, head);
    var lens = Mesh(name + " Lens", "Sphere", x, 1.27, z - 0.87, 0.06, 0.06, 0.06, "", Col(1.0, 0.2, 0.15));
    EntitySetComponentField(lens, "MeshRenderer", "EmissionColor", {r: 1.0, g: 0.15, b: 0.1});
    EntitySetComponentField(lens, "MeshRenderer", "EmissionStrength", 5.0);
    EntitySetParent(lens, head);
    EntityAddComponent(head, "AimConstraint");
    EntitySetComponentField(head, "AimConstraint", "Source", target);
    EntitySetComponentField(head, "AimConstraint", "AimVector", {x: 0, y: 0, z: -1});
    EntitySetComponentField(head, "AimConstraint", "UpVector", {x: 0, y: 1, z: 0});
    EntitySetComponentField(head, "AimConstraint", "WorldUpVector", {x: 0, y: 1, z: 0});
    return head;
}
Turret("Turret A", 80.5, 16.6, ikOrb);
Turret("Turret B", 87.5, 16.6, ikOrb);
// Takip ışığı: Look At Constraint ile spot ışık küreyi aydınlatır (mankenin gölgesi zeminde dolaşır)
