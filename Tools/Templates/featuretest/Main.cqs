// ---------------------------------------------------------------- 5 Yıkım
Station(5, "DESTRUCTION", "Fracture: the wall breaks into pieces when the falling ball hits it", 56, -14, true);
for (var wi = 0; wi < 3; wi++)
{
    var wall = Mesh("Fracture Block " + wi, "Cube", 54 + wi * 2.1, 0.3 + 1.0, -14, 2, 2, 0.6, "", Col(0.8, 0.78, 0.74));
    EntityAddComponent(wall, "Rigidbody");
    EntitySetComponentField(wall, "Rigidbody", "BodyType", "Static");
    EntityAddComponent(wall, "BoxCollider");
    EntityAddComponent(wall, "Fracture");
    EntitySetComponentField(wall, "Fracture", "Pieces", 24);
    EntitySetComponentField(wall, "Fracture", "BreakImpulse", 40);
    EntitySetComponentField(wall, "Fracture", "PieceLifetime", 0);
    var wrecker = Mesh("Wrecking Ball " + wi, "Sphere", 54 + wi * 2.1, 6 + wi * 2.5, -14, 0.9, 0.9, 0.9, "", Col(0.15, 0.15, 0.17));
    EntitySetComponentField(wrecker, "MeshRenderer", "Metallic", 1.0);
    EntitySetComponentField(wrecker, "MeshRenderer", "Roughness", 0.3);
    EntityAddComponent(wrecker, "Rigidbody");
    EntitySetComponentField(wrecker, "Rigidbody", "BodyType", "Dynamic");
    EntitySetComponentField(wrecker, "Rigidbody", "Mass", 200);
    EntityAddComponent(wrecker, "SphereCollider");
}
// ---------------------------------------------------------------- 6 Parçacıklar
Station(6, "PARTICLES", "GPU-friendly particle systems: fire, smoke and a spark fountain", -56, 14, false);
var fire = Particles("Fire", null, {RateOverTime: 60, StartLifetime: {x: 0.6, y: 1.1}, StartSpeed: {x: 0.8, y: 1.8}, StartSize: {x: 0.35, y: 0.7},
    StartColorA: {r: 1, g: 0.55, b: 0.15, a: 1}, StartColorB: {r: 1, g: 0.3, b: 0.05, a: 1}, Shape: "Cone", Radius: 0.35, GravityModifier: -0.4,
    Blend: "Additive", EmissiveIntensity: 5, MaxParticles: 300, ColorOverLifetimeEnabled: true, ColorOverLifetimeKeys: "0:1,1,1,1; 1:1,0.3,0.1,0",
    SizeOverLifetimeEnabled: true, SizeOverLifetimeKeys: "0:1; 1:0.2"});
EntitySetPosition(fire, -59, 0.4, 14);
EntitySetRotation(fire, -90, 0, 0);
var fireLight = CreateEntity("Fire Light");
EntitySetPosition(fireLight, -59, 1.2, 14);
EntityAddComponent(fireLight, "PointLight");
EntitySetComponentField(fireLight, "PointLight", "Color", {r: 1, g: 0.55, b: 0.2});
EntitySetComponentField(fireLight, "PointLight", "Intensity", 8);
EntitySetComponentField(fireLight, "PointLight", "Range", 6);
var smoke = Particles("Smoke", null, {RateOverTime: 14, StartLifetime: {x: 3, y: 5}, StartSpeed: {x: 0.4, y: 1.0}, StartSize: {x: 0.6, y: 1.2},
    StartColorA: {r: 0.4, g: 0.4, b: 0.42, a: 0.5}, StartColorB: {r: 0.25, g: 0.25, b: 0.27, a: 0.35}, Shape: "Cone", Radius: 0.4, GravityModifier: -0.08,
    Drag: 0.3, Blend: "Alpha", MaxParticles: 200, ColorOverLifetimeEnabled: true, ColorOverLifetimeKeys: "0:1,1,1,0; 0.2:1,1,1,1; 1:1,1,1,0",
    SizeOverLifetimeEnabled: true, SizeOverLifetimeKeys: "0:0.5; 1:3"});
EntitySetPosition(smoke, -56, 0.4, 14);
EntitySetRotation(smoke, -90, 0, 0);
var sparks = Particles("Spark Fountain", null, {RateOverTime: 120, StartLifetime: {x: 0.8, y: 1.6}, StartSpeed: {x: 5, y: 8}, StartSize: {x: 0.04, y: 0.08},
    StartColorA: {r: 1, g: 0.85, b: 0.4, a: 1}, StartColorB: {r: 0.6, g: 0.8, b: 1, a: 1}, Shape: "Cone", Radius: 0.05, GravityModifier: 1.0,
    Blend: "Additive", EmissiveIntensity: 6, MaxParticles: 600});
EntitySetPosition(sparks, -53, 0.4, 14);
EntitySetRotation(sparks, -90, 0, 0);
// ---------------------------------------------------------------- 7 Animasyon
Station(7, "ANIMATION", "skinned meshes with animation state machines: idle, walk, dance, talk", -28, 14, false);
var clips = ["idle", "walk", "dance", "talk"];
for (var ai = 0; ai < 4; ai++) { Actor("Actor " + clips[ai], -32 + ai * 2.6, 0.3, 14, 0, ai % 2 == 0 ? "Mannequin_Male" : "Mannequin_Female", clips[ai]); }
// ---------------------------------------------------------------- 8 Ragdoll
Station(8, "RAGDOLL", "physics ragdoll built from the skeleton (capsules + character joints), tumbling down steps", 0, 14, false);
// Merdiven izleyiciye doğru iner (en üst basamak arkada); manken en üstten düşüp yuvarlanır
// Gerçekçi dik merdiven (9 basamak, 25 cm rıht, 38 cm basamak) + tepede sahanlık; manken sahanlıktan merdivene itilir
Stairs("Ragdoll Steps", 0, 0.3, 10.6, 9, 0.25, 0.38, 5, 0, GRID);
// Merdiven z 10.6 + 9 x 0.38 = 14.02 m'de biter: sahanlık tam orada başlar (arada boşluk kalmaz), arka kenar 15.92
Box("Ragdoll Landing", 0, 0.3, 14.97, 5, 2.25, 1.9, GRID);
var rd = Actor("Ragdoll Mannequin", 0, 2.56, 14.45, 180, "Mannequin_Male", "idle");   // sahanlığın ön kenarından 43 cm geride, izleyiciye dönük
EntitySetRotation(rd, 0, 180, 0);
EntityAddComponent(rd, "Ragdoll");
AddScript(rd, "Assets/Scripts/RagdollDemo.cqs");   // tepeden izleyiciye doğru itilir, 7 sn'de bir başa döner
// ---------------------------------------------------------------- 9 NavMesh
Station(9, "NAVIGATION", "NavMesh baked on Play; agents wander, avoid each other and the obstacles", 28, 14, false);
// Engellerin üstü yürünemez (NavMesh Modifier varsayılanı: Not Walkable); ajanlar yalnız çevresinden dolaşır
foreach (var ob in [Box("Nav Obstacle A", 26, 0.3, 13, 1.2, 1.2, 3, GRID_ORANGE), Box("Nav Obstacle B", 30.5, 0.3, 15.5, 2.5, 1.2, 1.2, GRID_ORANGE)])
{
    EntityAddComponent(ob, "NavMeshModifier");
}
for (var ni = 0; ni < 5; ni++)
{
    var ag = Mesh("Agent " + ni, "Cylinder", 24 + ni * 1.8, 0.3 + 0.9, 11, 0.6, 1.8, 0.6, "", Col(0.3 + ni * 0.12, 0.6, 1.0 - ni * 0.12));
    EntityAddComponent(ag, "NavMeshAgent");
    EntitySetComponentField(ag, "NavMeshAgent", "Speed", 2.2);
    EntitySetComponentField(ag, "NavMeshAgent", "Radius", 0.35);
    EntitySetComponentField(ag, "NavMeshAgent", "Height", 1.8);
    AddScript(ag, "Assets/Scripts/NavWanderer.cqs");
    IgnoreFromNav(ag);
}
NavSurface();
// ---------------------------------------------------------------- 10 Spline'lar, iz ve çizgi
Station(10, "SPLINES + TRAILS", "Spline Extrude tube, an object riding the spline, trail and line renderers", 56, 14, false);
