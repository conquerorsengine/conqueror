// Feature Test (Flax / Stride örnek sahneleri gibi): motorun özelliklerini çalışırken gösteren istasyon salonu.
// Her istasyon kendi kaidesinde, başlığı ve kısa açıklamasıyla: PBR malzemeler, ışıklar, fizik, kumaş, yıkım,
// parçacıklar, animasyon, ragdoll, NavMesh, spline'lar, iz / çizgi, eklemler, IK + kısıtlar, render target,
// instancing + LOD, yüzeyler, CSG, tetikleyici + ışın, kuvvetler; koridorda 3D ses, Post Process Volume, Decal.
// Kamera: serbest uçuş (sağ tık bak, WASD, Q / E, Shift), 1-9 ve 0 istasyonlara atlar, Tab sonraki istasyon.
// @EditorCamera 150 40 0 0 0 0   (proje açıldığında editör görünümü: uzaklık, eğim, yön, odak)
OutdoorLighting(-42, -35);
RenderSettingSet("Post.CloudCoverage", 0.35);

Box("Floor", 0, -1, 0, 252, 1, 60, GRID);

var STATIONS = [];
func Station(i, title, desc, x, z, faceNorth)
{
    var s = CreateEntity("Station " + i);
    EntitySetPosition(s, x, 0, z);
    var pedestal = Box("Station " + i + " Base", x, 0, z, 12, 0.3, 12, GRID_DARK);
    EntitySetComponentField(pedestal, "MeshRenderer", "Roughness", 0.6);
    // Başlık panosu kaidenin arka kenarında, ziyaretçiye dönük
    var dz = faceNorth ? -6.6 : 6.6;
    var board = Mesh("Station " + i + " Board", "Cube", x, 3.3, z + dz, 11, 2.0, 0.2, "", {r: 0.06, g: 0.065, b: 0.075, a: 1});
    EntitySetComponentField(board, "MeshRenderer", "Roughness", 0.4);
    EntitySetComponentField(board, "MeshRenderer", "CastShadows", false);   // pano, sergilenen şeyin üstüne gölge düşürmesin
    var t = CreateEntity("Station " + i + " Title");
    EntitySetPosition(t, x, 3.7, z + dz + (faceNorth ? 0.12 : -0.12));
    EntityAddComponent(t, "TextRenderer");
    EntitySetComponentField(t, "TextRenderer", "Text", i + "  " + title);
    EntitySetComponentField(t, "TextRenderer", "FontSize", 0.85);
    EntitySetComponentField(t, "TextRenderer", "Color", {r: 1, g: 1, b: 1, a: 1});
    EntitySetComponentField(t, "TextRenderer", "Alignment", "Center");
    EntitySetRotation(t, 0, faceNorth ? 0 : 180, 0);
    var d = CreateEntity("Station " + i + " Info");
    EntitySetPosition(d, x, 2.85, z + dz + (faceNorth ? 0.12 : -0.12));
    EntityAddComponent(d, "TextRenderer");
    EntitySetComponentField(d, "TextRenderer", "Text", desc);
    EntitySetComponentField(d, "TextRenderer", "FontSize", 0.33);
    EntitySetComponentField(d, "TextRenderer", "Color", {r: 0.75, g: 0.8, b: 0.86, a: 1});
    EntitySetComponentField(d, "TextRenderer", "Alignment", "Center");
    EntitySetRotation(d, 0, faceNorth ? 0 : 180, 0);
    // İstasyonun "önü": FreeFlyCamera buradan bakar (kuzeydekiler güneye, güneydekiler kuzeye)
    EntitySetRotation(s, 0, faceNorth ? 180 : 0, 0);
    STATIONS.Add(s);
    return s;
}
func Col(r, g, b) { return {r: r, g: g, b: b, a: 1}; }
// Koyu panel üstünde ortalı yazı (gökyüzü önünde de okunur); izleyici tarafına bakar
func InfoText(name, text, x, y, z, faceNorth, size, color)
{
    var panel = Mesh(name + " Panel", "Cube", x, y + size * 0.3, z, StringLength(text) * size * 0.36 + 0.35, size * 1.5, 0.04, "", {r: 0.05, g: 0.055, b: 0.065, a: 1});
    EntitySetComponentField(panel, "MeshRenderer", "Roughness", 0.5);
    EntitySetComponentField(panel, "MeshRenderer", "CastShadows", false);
    EntitySetRotation(panel, 0, faceNorth ? 0 : 180, 0);
    var t = CreateEntity(name);
    EntitySetPosition(t, x, y, z + (faceNorth ? 0.03 : -0.03));
    EntityAddComponent(t, "TextRenderer");
    EntitySetComponentField(t, "TextRenderer", "Text", text);
    EntitySetComponentField(t, "TextRenderer", "FontSize", size);
    EntitySetComponentField(t, "TextRenderer", "Color", color);
    EntitySetComponentField(t, "TextRenderer", "Alignment", "Center");
    EntitySetRotation(t, 0, faceNorth ? 0 : 180, 0);
    return t;
}

// Dinamik gövde: Mesh + Rigidbody (Dynamic) + çarpıştırıcı; PhysicsReset ile istasyon tekrarlarında başa döner
func DynBody(name, kind, x, y, z, sx, sy, sz, color, mass)
{
    var e = Mesh(name, kind, x, y, z, sx, sy, sz, "", color);
    EntityAddComponent(e, "Rigidbody");
    EntitySetComponentField(e, "Rigidbody", "BodyType", "Dynamic");
    EntitySetComponentField(e, "Rigidbody", "Mass", mass);
    EntityAddComponent(e, kind == "Sphere" ? "SphereCollider" : "BoxCollider");
    AddScript(e, "Assets/Scripts/PhysicsReset.cqs");
    return e;
}
func Steel(e, rough)
{
    EntitySetComponentField(e, "MeshRenderer", "Metallic", 1.0);
    EntitySetComponentField(e, "MeshRenderer", "Roughness", rough);
    return e;
}
// Sergi tabelası: kaidenin üstünde arkaya yatık küçük koyu levha + sarı yazı (izleyicinin bakış yönünden okunur)
func FloorLabel(text, x, z, faceNorth)
{
    var yaw = faceNorth ? 0 : 180;
    var plate = Mesh("Plaque " + text, "Cube", x, 0.55, z, StringLength(text) * 0.088 + 0.45, 0.42, 0.04, "", {r: 0.05, g: 0.055, b: 0.065, a: 1});
    EntitySetComponentField(plate, "MeshRenderer", "Roughness", 0.5);
    EntitySetComponentField(plate, "MeshRenderer", "CastShadows", false);
    EntitySetRotation(plate, -22, yaw, 0);
    var legs = Mesh("Plaque Stand " + text, "Cube", x, 0.4, z + (faceNorth ? -0.07 : 0.07), 0.06, 0.2, 0.06, "", {r: 0.05, g: 0.055, b: 0.065, a: 1});
    // Yazı levhanın yatık ön yüzünde: levha merkezine göre (0, -0.1, 0.035) noktası 22 derece döndürülmüş
    var t = CreateEntity("Label " + text);
    var tilt = MathDegToRad(22.0);
    var oy = -0.1 * MathCos(tilt) + 0.035 * MathSin(tilt);
    var oz = 0.1 * MathSin(tilt) + 0.035 * MathCos(tilt);
    EntitySetPosition(t, x, 0.55 + oy, z + (faceNorth ? oz : -oz));
    EntityAddComponent(t, "TextRenderer");
    EntitySetComponentField(t, "TextRenderer", "Text", text);
    EntitySetComponentField(t, "TextRenderer", "FontSize", 0.26);
    EntitySetComponentField(t, "TextRenderer", "Color", {r: 1.0, g: 0.78, b: 0.3, a: 1});
    EntitySetComponentField(t, "TextRenderer", "Alignment", "Center");
    EntitySetRotation(t, -22, yaw, 0);
    return t;
}

// ---------------------------------------------------------------- 1 PBR malzemeler
Station(1, "PBR MATERIALS", "metallic 0 -> 1 (left to right), roughness 0.05 / 0.45 / 0.9 (top to bottom)", -56, -14, true);
for (var mi = 0; mi < 5; mi++)
{
    for (var ri = 0; ri < 3; ri++)
    {
        var sp = Mesh("PBR Sphere " + mi + "-" + ri, "Sphere", -60 + mi * 2.0, 3.0 - ri * 1.05, -14, 0.9, 0.9, 0.9, "", Col(0.95, 0.72, 0.35));
        EntitySetComponentField(sp, "MeshRenderer", "Metallic", mi / 4.0);
        EntitySetComponentField(sp, "MeshRenderer", "Roughness", [0.05, 0.45, 0.9][ri]);
    }
}
// ---------------------------------------------------------------- 2 Işıklar
Station(2, "LIGHTS", "point, spot and area lights with shadows, emissive surfaces, lens flare", -28, -14, true);
var orbit = CreateEntity("Light Orbit");
EntitySetPosition(orbit, -28, 1.6, -14);
EntityAddComponent(orbit, "Rotator");
EntitySetComponentField(orbit, "Rotator", "RotationRate", {x: 0, y: 40, z: 0});
var lc = [Col(1, 0.25, 0.2), Col(0.25, 1, 0.35), Col(0.3, 0.5, 1)];
for (var li = 0; li < 3; li++)
{
    var a = li * 2.094;
    var orb = Mesh("Light Orb " + li, "Sphere", 0, 0, 0, 0.25, 0.25, 0.25, "", lc[li]);
    EntitySetParent(orb, orbit);
    EntitySetPosition(orb, MathCos(a) * 3.0, 0, MathSin(a) * 3.0);
    EntitySetComponentField(orb, "MeshRenderer", "EmissionColor", {r: lc[li].r, g: lc[li].g, b: lc[li].b});
    EntitySetComponentField(orb, "MeshRenderer", "EmissionStrength", 8.0);
    EntitySetComponentField(orb, "MeshRenderer", "CastShadows", false);
    EntityAddComponent(orb, "PointLight");
    EntitySetComponentField(orb, "PointLight", "Color", {r: lc[li].r, g: lc[li].g, b: lc[li].b});
    EntitySetComponentField(orb, "PointLight", "Intensity", 6.0);
    EntitySetComponentField(orb, "PointLight", "Range", 6.0);
    EntitySetComponentField(orb, "PointLight", "CastShadows", true);
}
Box("Light Pillar", -28, 0.3, -14, 0.8, 2.2, 0.8, GRID);
var spot = CreateEntity("Spot Light");
EntitySetPosition(spot, -32, 4.5, -11);
EntityAddComponent(spot, "SpotLight");
EntitySetComponentField(spot, "SpotLight", "Color", {r: 1, g: 0.85, b: 0.6});
EntitySetComponentField(spot, "SpotLight", "Intensity", 25.0);
EntitySetComponentField(spot, "SpotLight", "Range", 10.0);
EntitySetComponentField(spot, "SpotLight", "OuterConeAngle", 30);
EntitySetComponentField(spot, "SpotLight", "CastShadows", true);
EntitySetRotation(spot, -60, 30, 0);
var area = CreateEntity("Area Light");
EntitySetPosition(area, -24, 3.0, -17);
EntityAddComponent(area, "AreaLight");
EntitySetComponentField(area, "AreaLight", "Intensity", 6.0);
EntitySetComponentField(area, "AreaLight", "Size", {x: 3, y: 1.2});
EntitySetComponentField(area, "AreaLight", "Range", 10);
EntitySetRotation(area, -30, 180, 0);
var lamp = Mesh("Emissive Panel", "Cube", -24, 3.0, -17.1, 3, 1.2, 0.05, "", Col(1, 1, 1));
EntitySetComponentField(lamp, "MeshRenderer", "EmissionColor", {r: 1, g: 0.97, b: 0.9});
EntitySetComponentField(lamp, "MeshRenderer", "EmissionStrength", 4.0);
// ---------------------------------------------------------------- 3 Fizik
Station(3, "RIGID BODIES", "stacked boxes, rolling balls and dominoes (Jolt): click Play and watch them settle", 0, -14, true);
for (var row = 0; row < 5; row++)
{
    // Piramit sola yaslı: ortalanmış başlık panosu arkada görünür kalsın
    for (var c = 0; c <= 4 - row; c++) { PhysicsCube("Pyramid " + row + "-" + c, -5.1 + c * 1.02 + row * 0.51, 0.3 + row * 1.0, -15, 1, 20); }
}
for (var di = 0; di < 9; di++)
{
    var dom = Mesh("Domino " + di, "Cube", 1.5 + di * 0.45, 0.3 + 0.5, -12.5, 0.12, 1.0, 0.5, "", Col(0.95, 0.95, 0.95));
    EntityAddComponent(dom, "Rigidbody");
    EntitySetComponentField(dom, "Rigidbody", "BodyType", "Dynamic");
    EntitySetComponentField(dom, "Rigidbody", "Mass", 2);
    EntityAddComponent(dom, "BoxCollider");
}
var pusher = Mesh("Domino Ball", "Sphere", 0.9, 3.0, -12.5, 0.5, 0.5, 0.5, "", Col(0.95, 0.3, 0.2));
EntityAddComponent(pusher, "Rigidbody");
EntitySetComponentField(pusher, "Rigidbody", "BodyType", "Dynamic");
EntitySetComponentField(pusher, "Rigidbody", "Mass", 6);
EntityAddComponent(pusher, "SphereCollider");
Ramp("Ball Ramp", -0.4, 0.3, -12.5, 1.2, 1.4, 1.0, 90, GRID_DARK);
for (var bi = 0; bi < 6; bi++)
{
    var ball = Mesh("Ball " + bi, "Sphere", 3 + (bi % 3) * 0.7, 4 + bi * 0.8, -16 + (bi / 3) * 0.6, 0.6, 0.6, 0.6, "", Col(0.25, 0.5, 0.95));
    EntityAddComponent(ball, "Rigidbody");
    EntitySetComponentField(ball, "Rigidbody", "BodyType", "Dynamic");
    EntitySetComponentField(ball, "Rigidbody", "Mass", 3);
    EntityAddComponent(ball, "SphereCollider");
}
// ---------------------------------------------------------------- 4 Kumaş
Station(4, "CLOTH + WIND", "position based cloth pinned on a bar, pushed by a pulsing Wind Zone", 28, -14, true);
