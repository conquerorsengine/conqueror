EntitySetComponentField(trackSpot, "SpotLight", "OuterConeAngle", 18);
EntitySetComponentField(trackSpot, "SpotLight", "CastShadows", true);
var spotCan = Steel(Mesh("Tracking Spot Housing", "Cylinder", 79.6, 4.3, 11.4 + 0.12, 0.3, 0.34, 0.3, "", Col(0.12, 0.12, 0.13)), 0.4);
EntitySetRotation(spotCan, 90, 0, 0);
EntitySetParent(spotCan, trackSpot);
EntityAddComponent(trackSpot, "LookAtConstraint");
EntitySetComponentField(trackSpot, "LookAtConstraint", "Source", ikOrb);
EntitySetComponentField(trackSpot, "LookAtConstraint", "UseWorldUp", true);
FloorLabel("TWO BONE IK + MULTI-AIM", 84, 9.0, false);
FloorLabel("AIM CONSTRAINT", 87.5, 15.0, false);
FloorLabel("AIM CONSTRAINT", 80.5, 15.0, false);
