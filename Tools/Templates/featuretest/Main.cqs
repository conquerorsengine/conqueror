FloorLabel("SLIDER + MOTOR", 88.7, -9.05, true);
FloorLabel("HINGE + SPRING", 85.6, -9.05, true);
// Yay: ağırlık askı kolundan Spring Joint ile sarkar (doğal boy 0.7 m); SpringBungee aşağı çekip bırakır, bobini çizer
Box("Spring Post", 78.7, 0.3, -9.0, 0.14, 3.2, 0.14, GRID_DARK);
Box("Spring Arm", 79.3, 3.38, -9.0, 1.3, 0.12, 0.12, GRID_DARK);
var weight = Steel(DynBody("Spring Weight", "Sphere", 79.8, 3.38 - 0.7 - 0.22, -9.0, 0.44, 0.44, 0.44, Col(0.95, 0.3, 0.2), 5), 0.25);
EntitySetComponentField(weight, "MeshRenderer", "Metallic", 0.0);
