Box("Door Post", 86.0, 0.3, -11.13, 0.12, 1.8, 0.12, GRID_DARK);
var door = Mesh("Spring Door", "Cube", 86.0, 1.15, -10.3, 0.08, 1.6, 1.4, "", Col(0.25, 0.55, 0.95));
EntitySetComponentField(door, "MeshRenderer", "Roughness", 0.45);
EntityAddComponent(door, "Rigidbody");
