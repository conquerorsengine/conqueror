Box("Cloth Post R", 31.4, 0.3, -14, 0.25, 2.95, 0.25, GRID_DARK);
Box("Cloth Bar", 28, 3.15, -14, 7.2, 0.15, 0.15, GRID_DARK);
var cloth = CreateEntity("Cloth Banner");
