// ---------------------------------------------------------------- 13 Render Target
Station(13, "RENDER TARGETS", "cameras rendering into textures: a panning security camera and a top-down orthographic overview", 112, -14, true);
// Ekranlar: çerçeve + ışıksız (Unlit) ekran yüzeyi; doku yolu rt://<Render Target adı>
func Monitor(name, x, y, z, w, h, rt)
{
    var bezel = Mesh(name + " Bezel", "Cube", x, y, z, w + 0.2, h + 0.2, 0.12, "", Col(0.035, 0.037, 0.042));
    EntitySetComponentField(bezel, "MeshRenderer", "Roughness", 0.35);
    var screen = Mesh(name, "Cube", x, y, z + 0.065, w, h, 0.01, "", WHITE);
    EntitySetComponentField(screen, "MeshRenderer", "Texture", "rt://" + rt);
    EntitySetComponentField(screen, "MeshRenderer", "Unlit", true);
    EntitySetComponentField(screen, "MeshRenderer", "CastShadows", false);
    Box(name + " Stand", x, 0.3, z - 0.02, 0.16, y - h / 2.0 - 0.1 - 0.3, 0.16, GRID_DARK);
    return screen;
}
Monitor("Security Monitor", 108.7, 1.5, -16.6, 2.88, 1.62, "SecurityCam");
Monitor("Overview Monitor", 115.5, 1.25, -16.6, 4.0, 1.0, "Overview");
