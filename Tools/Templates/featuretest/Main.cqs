EntitySetComponentField(field, "Rotator", "RotationRate", {x: 0, y: 14, z: 0});
var stats = InfoText("Instance Stats", "12000 INSTANCES  /  1 DRAW CALL", 115.3, 2.05, 14.8, false, 0.26, {r: 0.55, g: 0.85, b: 1.0, a: 1});
AddScript(stats, "Assets/Scripts/InstanceStats.cqs");
// LOD: aynı nesne üç derinlikte; yeşil küre (LOD 0), sarı silindir (LOD 1), kırmızı küp (LOD 2) ekrandaki boyuta göre
var lodColors = [Col(0.3, 0.9, 0.4), Col(1.0, 0.8, 0.2), Col(1.0, 0.3, 0.25)];
var lodMeshes = ["Sphere", "Cylinder", "Cube"];
for (var lo = 0; lo < 3; lo++)
{
    var lz = 10.2 + lo * 3.4;
    Box("LOD Plinth " + lo, 109.2, 0.3, lz, 0.9, 0.5, 0.9, GRID_DARK);
    var lodObj = CreateEntity("LOD Object " + lo);
    EntitySetPosition(lodObj, 109.2, 1.42, lz);
    var levels = [];
    for (var lv = 0; lv < 3; lv++)
    {
        var m = Mesh("LOD" + lv, lodMeshes[lv], 109.2, 1.42, lz, 1.1, 1.1, 1.1, "", lodColors[lv]);
        EntitySetComponentField(m, "MeshRenderer", "Roughness", 0.35);
        EntitySetParent(m, lodObj);
        levels.Add(m);
    }
    EntityAddComponent(lodObj, "LODGroup");
    EntitySetComponentField(lodObj, "LODGroup", "LOD0", levels[0]);
    EntitySetComponentField(lodObj, "LODGroup", "Threshold0", 10.5);
    EntitySetComponentField(lodObj, "LODGroup", "LOD1", levels[1]);
    EntitySetComponentField(lodObj, "LODGroup", "Threshold1", 7.0);
    EntitySetComponentField(lodObj, "LODGroup", "LOD2", levels[2]);
    EntitySetComponentField(lodObj, "LODGroup", "Threshold2", 0.5);
    EntitySetComponentField(lodObj, "LODGroup", "Size", 1.1);
    InfoText("LOD Label " + lo, "LOD 0", 109.2, 2.2, lz, false, 0.26, {r: 1, g: 1, b: 1, a: 1});
}
FloorLabel("MULTI MESH (GPU INSTANCING)", 115.3, 9.3, false);
FloorLabel("LOD GROUP", 109.2, 8.9, false);
// ---------------------------------------------------------------- 15 Yüzeyler
Station(15, "SURFACES", "transparency, alpha clip (cutout), emissive + bloom, scrolling UVs, world-aligned vs object UVs", -84, -14, true);
func Plinth(name, x, z) { var p = Box(name, x, 0.3, z, 1.3, 0.4, 1.3, GRID_DARK); return p; }
