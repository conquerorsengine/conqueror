// ---------------------------------------------------------------- 16 CSG
Station(16, "CSG", "constructive solid geometry: union, subtraction, intersection and a quick level blockout", -84, 14, false);
func CSGShape(name, parent, shape, op, x, y, z, sizeOrRadius, height)
{
    var e = CreateEntity(name);
    if (parent != null) { EntitySetParent(e, parent); }
    EntitySetPosition(e, x, y, z);
    EntityAddComponent(e, "CSGShape");
    EntitySetComponentField(e, "CSGShape", "Shape", shape);
    EntitySetComponentField(e, "CSGShape", "Operation", op);
    if (shape == "Box") { EntitySetComponentField(e, "CSGShape", "Size", sizeOrRadius); }
    else
    {
        EntitySetComponentField(e, "CSGShape", "Radius", sizeOrRadius);
        EntitySetComponentField(e, "CSGShape", "Height", height);
        EntitySetComponentField(e, "CSGShape", "Sides", 40);
        EntitySetComponentField(e, "CSGShape", "SmoothFaces", true);
    }
    EntitySetComponentField(e, "CSGShape", "UseCollision", false);
    return e;
}
func CSGExhibit(name, x, color)
{
    Box(name + " Plinth", x, 0.3, 14.2, 1.5, 0.4, 1.5, GRID_DARK);
    var spin = CreateEntity(name + " Turntable");
    EntitySetPosition(spin, x, 1.45, 14.2);
    EntityAddComponent(spin, "Rotator");
    EntitySetComponentField(spin, "Rotator", "RotationRate", {x: 0, y: 22, z: 0});
    return spin;
}
var cu = CSGExhibit("CSG Union", -79.6, null);
var cuRoot = CSGShape("CSG Union Shape", cu, "Box", "Union", 0, 0, 0, {x: 0.9, y: 0.9, z: 0.9}, 0);
EntitySetPosition(cuRoot, 0, 0, 0);
CSGShape("Union Sphere", cuRoot, "Sphere", "Union", 0, 0.38, 0, 0.42, 0);
CSGShape("Union Cylinder", cuRoot, "Cylinder", "Union", 0, 0, 0, 0.2, 1.5);
var cs = CSGExhibit("CSG Subtraction", -82.5, null);
var csRoot = CSGShape("CSG Subtraction Shape", cs, "Box", "Union", 0, 0, 0, {x: 1.0, y: 1.0, z: 1.0}, 0);
EntitySetPosition(csRoot, 0, 0, 0);
CSGShape("Subtract Sphere", csRoot, "Sphere", "Subtraction", 0, 0, 0, 0.64, 0);
var ci = CSGExhibit("CSG Intersection", -85.5, null);
var ciRoot = CSGShape("CSG Intersection Shape", ci, "Box", "Union", 0, 0, 0, {x: 0.95, y: 0.95, z: 0.95}, 0);
EntitySetPosition(ciRoot, 0, 0, 0);
CSGShape("Intersect Sphere", ciRoot, "Sphere", "Intersection", 0, 0, 0, 0.64, 0);
// Hızlı blokaj: duvar kutusundan kapı ve pencereler çıkarılır, dört kenarlı koni çatı eklenir
var ch = CSGExhibit("CSG Blockout", -88.4, null);
var chRoot = CSGShape("CSG House", ch, "Box", "Union", 0, 0, 0, {x: 1.5, y: 0.95, z: 1.2}, 0);
EntitySetPosition(chRoot, 0, -0.1, 0);
CSGShape("House Inside", chRoot, "Box", "Subtraction", 0, 0.05, 0, {x: 1.36, y: 0.9, z: 1.06}, 0);
CSGShape("House Door", chRoot, "Box", "Subtraction", 0.25, -0.12, -0.6, {x: 0.3, y: 0.62, z: 0.3}, 0);
CSGShape("House Window L", chRoot, "Box", "Subtraction", -0.4, 0.08, -0.6, {x: 0.3, y: 0.26, z: 0.3}, 0);
CSGShape("House Window R", chRoot, "Box", "Subtraction", 0.75, 0.08, 0.0, {x: 0.3, y: 0.26, z: 0.4}, 0);
var roof = CSGShape("House Roof", chRoot, "Cone", "Union", 0, 0.82, 0, 1.08, 0.7);
EntitySetComponentField(roof, "CSGShape", "Sides", 4);
EntitySetComponentField(roof, "CSGShape", "SmoothFaces", false);
EntitySetRotation(roof, 0, 45, 0);
var csgColors = [Col(0.3, 0.75, 1.0), Col(1.0, 0.55, 0.2), Col(0.4, 0.9, 0.5), Col(0.92, 0.9, 0.85)];
var csgRoots = [cuRoot, csRoot, ciRoot, chRoot];
for (var cc = 0; cc < 4; cc++)
{
    EntityAddComponent(csgRoots[cc], "MeshRenderer");
    EntitySetColor(csgRoots[cc], csgColors[cc]);
    EntitySetComponentField(csgRoots[cc], "MeshRenderer", "Texture", "");
    EntitySetComponentField(csgRoots[cc], "MeshRenderer", "Roughness", 0.35);
}
