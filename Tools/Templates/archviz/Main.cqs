// Archviz Interior (Unreal Archviz şablonu karşılığı): 10 x 8 m döşenmiş daire. Kuzey duvarında iki büyük pencere
// (güneş içeri düşer, gökyüzü HDR'si görünür), laminat parke, sıva duvarlar, oturma alanı (kanepe, berjer, sehpa,
// halı, TV ünitesi, raf), yemek alanı (masa + 6 sandalye, sarkıt lambalar), mermer tezgâhlı mutfak bloğu, bitkiler,
// tablolar. Işık: güneş + gökyüzü ortam ışığı + ekran uzayı GI ve yansımalar; G gündüz / akşam. Birinci şahıs gezinti.
// @EditorCamera 4 15 0 0 1.2 -0.5   (proje açıldığında editör görünümü: uzaklık, eğim, yön, odak)
SceneSetSkybox("Assets/Sky/day.hdr");
RenderSettingSet("Environment.Sky", "Auto");
RenderSettingSet("Environment.SkyboxIntensity", 0.5);
RenderSettingSet("Shadows.Enabled", true);
RenderSettingSet("Shadows.Quality", "Soft");
RenderSettingSet("Shadows.Distance", 30);
RenderSettingSet("Post.Tonemap", "ACES");
RenderSettingSet("Post.AntiAliasing", "TAA");
RenderSettingSet("Post.AmbientOcclusion", true);
RenderSettingSet("Post.AORadius", 0.6);
RenderSettingSet("Post.AOIntensity", 1.1);
RenderSettingSet("Post.ScreenSpaceGI", true);
RenderSettingSet("Post.SSGIIntensity", 1.4);
RenderSettingSet("Post.ScreenSpaceReflections", true);
RenderSettingSet("Post.SSRIntensity", 0.8);
RenderSettingSet("Post.Bloom", true);
RenderSettingSet("Post.BloomIntensity", 0.2);
RenderSettingSet("Post.Vignette", true);
RenderSettingSet("Post.VignetteIntensity", 0.15);
RenderSettingSet("Post.Exposure", 0.25);
RenderSettingSet("Fog.Enabled", false);

var W = 5.0;     // yarı genişlik (x)
var D = 4.0;     // yarı derinlik (z)
var HC = 2.9;    // tavan
var WHITE_WALL = {r: 1, g: 1, b: 1, a: 1};
func Tex(e, tex, tiling, color, rough)
{
    EntitySetComponentField(e, "MeshRenderer", "Texture", tex);
    EntitySetComponentField(e, "MeshRenderer", "WorldAlignedUV", true);
    EntitySetComponentField(e, "MeshRenderer", "Tiling", {x: tiling, y: tiling});
    EntitySetColor(e, color);
    EntitySetComponentField(e, "MeshRenderer", "Roughness", rough);
    return e;
}
func Solid(name, x, y, z, sx, sy, sz, tex, tiling, color, rough)
{
    var e = Static(Mesh(name, "Cube", x, y, z, sx, sy, sz, "", color));
    if (tex != "") { Tex(e, tex, tiling, color, rough); }
    else { EntitySetComponentField(e, "MeshRenderer", "Roughness", rough); }
    return e;
}
var PLASTER = "Assets/Textures/white_plaster.jpg";   // make_plaster.py

// Zemin, tavan, dış zemin
Solid("Floor", 0, -0.1, 0, 2 * W + 0.6, 0.2, 2 * D + 0.6, "Assets/Textures/laminate_floor_02.jpg", 0.45, {r: 1, g: 1, b: 1, a: 1}, 0.45);
Solid("Ceiling", 0, HC + 0.1, 0, 2 * W + 0.6, 0.2, 2 * D + 0.6, "", 1, {r: 0.95, g: 0.95, b: 0.94, a: 1}, 0.9);

// Duvarlar: güney (kapılı), doğu, batı; kuzey iki pencereli
var T = 0.2;
Solid("Wall South L", -2.8, HC / 2.0, D + T / 2.0, 4.8, HC, T, PLASTER, 0.5, WHITE_WALL, 0.85);
Solid("Wall South R", 2.9, HC / 2.0, D + T / 2.0, 4.6, HC, T, PLASTER, 0.5, WHITE_WALL, 0.85);
Solid("Wall South Door Top", 0.1, 2.5, D + T / 2.0, 1.0, 0.8, T, PLASTER, 0.5, WHITE_WALL, 0.85);
// Giriş kapısı (kapalı): ahşap kanat, koyu kasa, metal kol
var TRIM = {r: 0.16, g: 0.13, b: 0.11, a: 1};
Solid("Door Jamb L", -0.375, 1.05, D + T / 2.0, 0.05, 2.1, T + 0.04, "", 1, TRIM, 0.5);
Solid("Door Jamb R", 0.575, 1.05, D + T / 2.0, 0.05, 2.1, T + 0.04, "", 1, TRIM, 0.5);
Solid("Door Head", 0.1, 2.125, D + T / 2.0, 1.0, 0.05, T + 0.04, "", 1, TRIM, 0.5);
Solid("Front Door", 0.1, 1.05, D + T / 2.0, 0.9, 2.1, 0.045, "Assets/Textures/laminate_floor_02.jpg", 0.9, {r: 0.78, g: 0.66, b: 0.55, a: 1}, 0.55);
var handle = Mesh("Door Handle", "Cube", 0.46, 1.0, D + T / 2.0 - 0.05, 0.14, 0.025, 0.025, "", {r: 0.75, g: 0.75, b: 0.74, a: 1});
EntitySetComponentField(handle, "MeshRenderer", "Metallic", 1.0);
EntitySetComponentField(handle, "MeshRenderer", "Roughness", 0.25);
Solid("Wall East", W + T / 2.0, HC / 2.0, 0, T, HC, 2 * D + 0.4, PLASTER, 0.5, WHITE_WALL, 0.85);
Solid("Wall West", -W - T / 2.0, HC / 2.0, 0, T, HC, 2 * D + 0.4, PLASTER, 0.5, WHITE_WALL, 0.85);
var wz = -D - T / 2.0;
Solid("Wall North Pier W", -4.25, HC / 2.0, wz, 1.5, HC, T, PLASTER, 0.5, WHITE_WALL, 0.85);
Solid("Wall North Pier C", 0, HC / 2.0, wz, 1.0, HC, T, PLASTER, 0.5, WHITE_WALL, 0.85);
Solid("Wall North Pier E", 4.25, HC / 2.0, wz, 1.5, HC, T, PLASTER, 0.5, WHITE_WALL, 0.85);
foreach (var wx in [-2.0, 2.0])
{
    Solid("Wall North Sill " + wx, wx, 0.2, wz, 3.0, 0.4, T, PLASTER, 0.5, WHITE_WALL, 0.85);
    Solid("Wall North Header " + wx, wx, 2.7, wz, 3.0, 0.4, T, PLASTER, 0.5, WHITE_WALL, 0.85);
    // Pencere: ince koyu çerçeve + cam (yarı saydam, parlak)
    var FRAME = {r: 0.08, g: 0.08, b: 0.09, a: 1};
    Solid("Window Frame Bottom " + wx, wx, 0.42, wz, 3.0, 0.05, 0.12, "", 1, FRAME, 0.4);
    Solid("Window Frame Top " + wx, wx, 2.48, wz, 3.0, 0.05, 0.12, "", 1, FRAME, 0.4);
    Solid("Window Mullion " + wx, wx, 1.45, wz, 0.05, 2.05, 0.12, "", 1, FRAME, 0.4);
    var glass = Mesh("Window Glass " + wx, "Cube", wx, 1.45, wz, 2.95, 2.0, 0.02, "", {r: 0.02, g: 0.03, b: 0.03, a: 0.15});
    EntitySetComponentField(glass, "MeshRenderer", "Roughness", 0.02);
    EntitySetComponentField(glass, "MeshRenderer", "CastShadows", false);
}
Solid("Skirting East", W - 0.01, 0.05, 0, 0.02, 0.1, 2 * D, "", 1, {r: 0.95, g: 0.95, b: 0.95, a: 1}, 0.5);
Solid("Skirting West", -W + 0.01, 0.05, 0, 0.02, 0.1, 2 * D, "", 1, {r: 0.95, g: 0.95, b: 0.95, a: 1}, 0.5);

// ---------------------------------------------------------------- Dış mekân
// Pencerelerin önünde 5 m taş döşeli teras (bir basamak aşağıda), kenar taşı, ötesinde çim bahçe; bahçenin sonunda
// iki sıra çit çalısı (Poly Haven shrub, farklı boy / açı), terasta bahçe masası ve çiçeklikler.
func Ext(name, file, x, y, z, yaw, scale)
{
    var e = CreateEntity(name);
    EntitySetPosition(e, x, y, z);
    EntitySetRotation(e, 0, yaw, 0);
    EntitySetScale(e, scale, scale, scale);
    EntityAddComponent(e, "Model");
    EntitySetComponentField(e, "Model", "FilePath", "Assets/Exterior/" + file + ".glb");
    return e;
}
func Hash01(i)
{
    var v = MathSin(i * 12.9898 + 78.233) * 43758.5453;
    return v - MathFloor(v);
}
var NZ = -D - T;
Solid("Patio", 0, -0.25, NZ - 2.6, 14, 0.2, 5.2, "Assets/Textures/patio_stone.jpg", 0.45, {r: 0.95, g: 0.95, b: 0.93, a: 1}, 0.7);
Solid("Patio Kerb", 0, -0.2, NZ - 5.25, 14.3, 0.14, 0.18, "", 1, {r: 0.62, g: 0.62, b: 0.6, a: 1}, 0.8);
Solid("Lawn", 0, -0.4, -20, 180, 0.3, 120, "Assets/Textures/lawn_grass.jpg", 0.3, {r: 0.92, g: 1.0, b: 0.88, a: 1}, 0.95);
// Budanmış şimşir çit bahçeyi üç yandan çevreler (doku: make_hedge.py); önünde serbest çalılar
var HEDGE = "Assets/Textures/hedge_leaves.jpg";
Solid("Hedge North", 0, 0.85, -16, 24, 2.2, 1.0, HEDGE, 1.0, {r: 1, g: 1, b: 1, a: 1}, 0.9);
Solid("Hedge West", -11.5, 0.85, -10.2, 1.0, 2.2, 11.6, HEDGE, 1.0, {r: 1, g: 1, b: 1, a: 1}, 0.9);
Solid("Hedge East", 11.5, 0.85, -10.2, 1.0, 2.2, 11.6, HEDGE, 1.0, {r: 1, g: 1, b: 1, a: 1}, 0.9);
for (var i = 0; i < 8; i++)
{
    var hx = -9.5 + i * 2.7 + (Hash01(i) - 0.5) * 0.8;
    Ext("Garden Shrub", "shrub_02", hx, -0.3, -14.8 + (Hash01(i + 40) - 0.5) * 0.5, Hash01(i + 80) * 360.0, 0.75 + Hash01(i + 120) * 0.3);
}
Ext("Garden Table", "outdoor_table_chair_set_01", 2.6, -0.15, NZ - 2.6, 20, 1.0);
var fill = CreateEntity("Garden Fill Light");
EntitySetPosition(fill, 0, 3.2, NZ - 1.0);
EntitySetRotation(fill, -12, 0, 0);
EntityAddComponent(fill, "AreaLight");
EntitySetComponentField(fill, "AreaLight", "Size", {x: 22, y: 4});
EntitySetComponentField(fill, "AreaLight", "Intensity", 1.2);
EntitySetComponentField(fill, "AreaLight", "Range", 24);
EntitySetComponentField(fill, "AreaLight", "Color", {r: 0.9, g: 0.94, b: 1.0});
EntitySetTag(fill, "Garden Light");
foreach (var px in [-5.6, 5.6])
{
    Ext("Garden Planter", "planter_box_02", px, -0.15, NZ - 0.6, 90, 1.0);
    for (var k = 0; k < 3; k++) { Ext("Planter Shrub", "shrub_03", px, 0.25, NZ - 0.2 - k * 0.4, k * 70.0, 1.6); }
}
foreach (var bx in [-3.4, -1.0, 1.4, 4.2])
{
    Ext("Lawn Shrub", "shrub_04", bx, -0.25, NZ - 6.2 - Hash01(bx * 3.0) * 1.5, bx * 40.0, 2.2);
}

// Mobilyalar (Poly Haven, ön yüzleri +Z; yaw = önün baktığı yön)
func Furn(name, file, x, y, z, yaw, scale)
{
    var e = CreateEntity(name);
    EntitySetPosition(e, x, y, z);
    EntitySetRotation(e, 0, yaw, 0);
    EntitySetScale(e, scale, scale, scale);
    EntityAddComponent(e, "Model");
    EntitySetComponentField(e, "Model", "FilePath", "Assets/Furniture/" + file + ".glb");
    return e;
}
func Solidify(e)
{
    EntityAddComponent(e, "Rigidbody");
    EntitySetComponentField(e, "Rigidbody", "BodyType", "Static");
    EntityAddComponent(e, "BoxCollider");
    return e;
}
