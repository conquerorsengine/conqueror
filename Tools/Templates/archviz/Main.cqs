// Tavan spotları (gömme): mutfak, giriş ve TV duvarı üstü; akşam açılır
foreach (var dl in [{x: -4.2, z: 3.1}, {x: -2.4, z: 3.1}, {x: 0.1, z: 3.0}, {x: 4.3, z: -0.4}, {x: 4.3, z: 1.6}])
{
    var trim = Mesh("Downlight Trim", "Cylinder", dl.x, HC - 0.004, dl.z, 0.14, 0.008, 0.14, "", {r: 0.9, g: 0.9, b: 0.9, a: 1});
    EntitySetComponentField(trim, "MeshRenderer", "Metallic", 0.6);
    EntitySetComponentField(trim, "MeshRenderer", "Roughness", 0.3);
    var lens = Mesh("Downlight Lens", "Cylinder", dl.x, HC - 0.009, dl.z, 0.09, 0.004, 0.09, "", {r: 1, g: 0.95, b: 0.88, a: 1});
    EntitySetComponentField(lens, "MeshRenderer", "EmissionColor", {r: 1.0, g: 0.84, b: 0.64});
    EntitySetComponentField(lens, "MeshRenderer", "EmissionStrength", 0.0);
    EntitySetComponentField(lens, "MeshRenderer", "CastShadows", false);
    EntitySetTag(lens, "Downlight Glow");
    var spot = CreateEntity("Downlight");
    EntitySetPosition(spot, dl.x, HC - 0.03, dl.z);
    EntitySetRotation(spot, -90, 0, 0);
    EntityAddComponent(spot, "SpotLight");
    EntitySetComponentField(spot, "SpotLight", "Color", {r: 1.0, g: 0.84, b: 0.64});
    EntitySetComponentField(spot, "SpotLight", "Intensity", 0.0);
    EntitySetComponentField(spot, "SpotLight", "Range", 5.0);
    EntitySetComponentField(spot, "SpotLight", "InnerConeAngle", 20);
    EntitySetComponentField(spot, "SpotLight", "OuterConeAngle", 42);
    EntitySetComponentField(spot, "SpotLight", "CastShadows", false);
    EntitySetTag(spot, "Downlight");
}

// Pencere portal ışıkları: gökyüzü ışığı pencereden odaya dolar (Unreal'ın sky light portal yaklaşımı); oda içi ortam
// ışığı pencereden uzaklaştıkça azalır, köşeler doğal biçimde koyulaşır
foreach (var wx in [-2.0, 2.0])
{
    var portal = CreateEntity("Window Light " + wx);
    EntitySetPosition(portal, wx, 1.45, -D + 0.1);
    EntitySetRotation(portal, 0, 180, 0);
    EntityAddComponent(portal, "AreaLight");
    EntitySetComponentField(portal, "AreaLight", "Size", {x: 2.9, y: 2.0});
    EntitySetComponentField(portal, "AreaLight", "Intensity", 2.0);
    EntitySetComponentField(portal, "AreaLight", "Range", 12);
    EntitySetComponentField(portal, "AreaLight", "Color", {r: 0.85, g: 0.92, b: 1.0});
    EntitySetTag(portal, "Window Light");
}

// Güneş (pencerelerden içeri)
var sun = CreateEntity("Sun");
EntityAddComponent(sun, "DirectionalLight");
EntitySetComponentField(sun, "DirectionalLight", "Intensity", 5.0);
EntitySetComponentField(sun, "DirectionalLight", "CastShadows", true);
EntitySetRotation(sun, -38, 125, 0);

// Gezinti noktaları (1-4): konum ve bakış
func ViewPoint(i, x, z, yaw, pitch)
{
    var v = CreateEntity("View " + i);
    EntitySetPosition(v, x, 0.9, z);
    EntitySetRotation(v, pitch, yaw, 0);
}
ViewPoint(1, -0.4, 3.2, 20, -6);
ViewPoint(2, 3.8, 3.0, 15, -8);
ViewPoint(3, -4.2, -2.6, -125, -6);
ViewPoint(4, 0.2, -3.0, 165, -5);

// Oyuncu: kapsül + kamera (göz 1.62 m)
var player = CreateEntity("Visitor");
EntitySetPosition(player, -0.4, 0.9, 3.2);
EntityAddComponent(player, "CharacterController");
EntitySetComponentField(player, "CharacterController", "Height", 1.8);
EntitySetComponentField(player, "CharacterController", "Radius", 0.25);
var cam = CreateEntity("Camera");
EntitySetParent(cam, player);
EntitySetPosition(cam, 0, 0.72, 0);
EntityAddComponent(cam, "Camera");
EntitySetComponentField(cam, "Camera", "Primary", true);
EntitySetComponentField(cam, "Camera", "FieldOfView", 75);
EntitySetComponentField(cam, "Camera", "NearClip", 0.05);
EntityAddComponent(cam, "AudioListener");
AddScript(player, "Assets/Scripts/ArchvizWalker.cqs");
EntitySetRotation(player, 0, 20, 0);

var hud = UICreateCanvas("HUD");
EntitySetComponentField(hud, "CanvasScaler", "ReferenceResolution", {x: 1920, y: 1080});
EntitySetComponentField(hud, "CanvasScaler", "MatchWidthOrHeight", 0.5);
HudText("HintText", hud, "WASD WALK     SHIFT FASTER     MOUSE LOOK     1-4 VIEWPOINTS     G DAY / EVENING     F FLY (Q / E)", 0, 26, 1800, 30, 22, "Center", 0.5, 0);
