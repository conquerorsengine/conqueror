// Tavan lambaları: sarkıt (model) + ışık; akşam modunda güçlenir
foreach (var lp in [{x: -3.1, z: 0.6}, {x: -2.1, z: 0.6}, {x: 2.7, z: 0.6}])
{
    Furn("Ceiling Lamp", "modern_ceiling_lamp_01", lp.x, HC - 0.95, lp.z, 0, 1.0);
    var l = CreateEntity("Lamp Light");
    EntitySetPosition(l, lp.x, HC - 0.95, lp.z);
    EntityAddComponent(l, "PointLight");
    EntitySetComponentField(l, "PointLight", "Color", {r: 1.0, g: 0.78, b: 0.52});
    EntitySetComponentField(l, "PointLight", "Intensity", 0.6);
    EntitySetComponentField(l, "PointLight", "Range", 6.0);
    EntitySetComponentField(l, "PointLight", "CastShadows", true);
    EntitySetTag(l, "Lamp");
    var bulb = Mesh("Lamp Glow", "Sphere", lp.x, HC - 0.9, lp.z, 0.08, 0.08, 0.08, "", {r: 1, g: 0.85, b: 0.6, a: 1});
    EntitySetComponentField(bulb, "MeshRenderer", "EmissionColor", {r: 1, g: 0.8, b: 0.55});
    EntitySetComponentField(bulb, "MeshRenderer", "EmissionStrength", 1.0);
    EntitySetComponentField(bulb, "MeshRenderer", "CastShadows", false);
    EntitySetTag(bulb, "Lamp Glow");
}

// Keten perdeler (pileli, iki yüzlü; make_soft_furnishings.py): her pencerenin iki yanında, tavana yakın ince rayda
foreach (var cwx in [-2.0, 2.0])
{
    var rod = Mesh("Curtain Rod " + cwx, "Cylinder", cwx, 2.79, -D + 0.14, 0.026, 3.8, 0.026, "", {r: 0.12, g: 0.12, b: 0.13, a: 1});
    EntitySetRotation(rod, 0, 0, 90);
    EntitySetComponentField(rod, "MeshRenderer", "Metallic", 0.9);
    EntitySetComponentField(rod, "MeshRenderer", "Roughness", 0.35);
    for (var cs = -1; cs <= 1; cs += 2)
    {
        var fin = Mesh("Curtain Finial", "Sphere", cwx + cs * 1.92, 2.79, -D + 0.14, 0.05, 0.05, 0.05, "", {r: 0.12, g: 0.12, b: 0.13, a: 1});
        EntitySetComponentField(fin, "MeshRenderer", "Metallic", 0.9);
        EntitySetComponentField(fin, "MeshRenderer", "Roughness", 0.35);
        Furn("Curtain", "linen_curtain", cwx + cs * 1.45, 0.04, -D + 0.14, 0, 1.0);
    }
}
