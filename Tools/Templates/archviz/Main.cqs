                    {x: -3.35, z: 1.45, y: 180}, {x: -2.6, z: 1.45, y: 180}, {x: -1.85, z: 1.45, y: 180}])
{
    Solidify(Furn("Dining Chair", "dining_chair_02", ch.x, 0, ch.z, ch.y, 1.0));
