Furn("Picture Frame", "standing_picture_frame_01", 0.6, 0.55, 2.2, 120, 1.0);
Solidify(Furn("Plant Corner", "potted_plant_01", 4.5, 0, -3.5, 0, 1.0));
Solidify(Furn("Shelves", "wooden_display_shelves_01", 4.75, 0, 2.9, -90, 1.0));
Furn("Vase Shelf", "ceramic_vase_01", 4.75, 1.56, 2.9, 0, 0.8);
