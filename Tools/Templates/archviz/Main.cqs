Solidify(Furn("Planter", "planter_box_01", -4.3, 0, -3.6, 0, 1.0));
// Duvar tabloları (güney duvarı, içe bakar)
Furn("Painting A", "hanging_picture_frame_01", 2.2, 1.2, D - 0.02, 180, 1.2);
Furn("Painting B", "hanging_picture_frame_02", -W + 0.02, 1.4, 0.6, 90, 1.4);    // batı duvarı, yemek masasının üstü
