func Rand()
{
    // Tekrarlanabilir sözde rastgele (LCG)
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 2147483648.0;
}

func Mesh(name, kind, x, y, z, sx, sy, sz, color)
{
    var e = CreateEntity(name);
    EntityAddComponent(e, "MeshRenderer");
    EntitySetComponentField(e, "MeshRenderer", "Mesh", kind);
    EntitySetPosition(e, x, y, z);
    EntitySetScale(e, sx / 2.0, sy / 2.0, sz / 2.0);
    EntitySetColor(e, color);
    EntitySetParent(e, level);
    return e;
}

func Solid(e)
{
    EntityAddComponent(e, "Rigidbody");
    EntitySetComponentField(e, "Rigidbody", "BodyType", "Static");
    EntityAddComponent(e, "BoxCollider");
    return e;
}

func Glow(e, c, strength)
{
    EntitySetComponentField(e, "MeshRenderer", "EmissionColor", {r: c.r, g: c.g, b: c.b});
    EntitySetComponentField(e, "MeshRenderer", "EmissionStrength", strength);
    EntitySetComponentField(e, "MeshRenderer", "CastShadows", false);
    return e;
}

// Yüzey malzemesi: doku metre başına sabit döşenir (nesne boyutundan bağımsız, nesneyle birlikte hareket eder).
// Böylece aynı yüzey türündeki tüm nesneler tek malzemeyi paylaşır (normal oyunlarda olduğu gibi).
func Surface(e, tex, perU, perV, metallic, roughness)
{
    EntitySetComponentField(e, "MeshRenderer", "Texture", tex);
    EntitySetComponentField(e, "MeshRenderer", "Tiling", {x: perU, y: perV});
    EntitySetComponentField(e, "MeshRenderer", "WorldAlignedUV", true);
    EntitySetComponentField(e, "MeshRenderer", "AlignToObject", true);
    EntitySetComponentField(e, "MeshRenderer", "Metallic", metallic);
    EntitySetComponentField(e, "MeshRenderer", "Roughness", roughness);
    return e;
}

// Kenar şeridi: dünya koordinatında kurulur, sonra platforma bağlanır (dünya dönüşümü korunur),
// böylece hareketli platformlarla birlikte gider.
func Strip(slab, name, x, y, z, sx, sy, sz, c, strength)
{
    var s = Glow(Mesh(name, "Cube", x, y, z, sx, sy, sz, dark), c, strength);
    EntitySetParent(s, slab);
    return s;
}

// Üst yüzeyi y=top olan platform + neon kenarlar + destek sütunları
func Platform(name, x, top, z, sx, sz, edge, pillars)
{
    var thick = 1.2;
    var p = Solid(Mesh(name, "Cube", x, top - thick / 2.0, z, sx, thick, sz, platColor));
    Surface(p, platTex, 0.3333, 0.3333, platMetal, platRough);
    var w = 0.16;
    var h = 0.08;
    var y = top + h / 2.0 - 0.02;
    Strip(p, name + " EdgeN", x, y, z - sz / 2.0 + w / 2.0, sx, h, w, edge, 7);
    Strip(p, name + " EdgeS", x, y, z + sz / 2.0 - w / 2.0, sx, h, w, edge, 7);
    Strip(p, name + " EdgeW", x - sx / 2.0 + w / 2.0, y, z, w, h, sz - 2 * w, edge, 7);
    Strip(p, name + " EdgeE", x + sx / 2.0 - w / 2.0, y, z, w, h, sz - 2 * w, edge, 7);
    // Yan yüzde ince ışık bandı
    Strip(p, name + " BandS", x, top - thick + 0.25, z + sz / 2.0 + 0.01, sx * 0.96, 0.06, 0.04, edge, 3);
    if (pillars)
    {
        var size = MathMin(sx, sz) * 0.32;
        var len = MathMax(sx, sz);
        var count = MathMax(1, MathFloor(len / 12.0));
        for (var i = 0; i < count; i++)
        {
            var t = (i + 0.5) / count - 0.5;
            var px = sx >= sz ? x + t * sx : x;
            var pz = sx >= sz ? z : z + t * sz;
            var col = Mesh(name + " Pillar" + i, "Cube", px, top - thick - 29.0, pz, size, 58, size, legColor);
            Surface(col, legTex, 0.5, 0.25, 0.6, 0.5);
            EntitySetComponentField(col, "MeshRenderer", "CastShadows", false);
        }
    }
    return p;
}

func Wall(name, x, bottom, z, sx, sy, sz, edge)
{
    var wl = Solid(Mesh(name, "Cube", x, bottom + sy / 2.0, z, sx, sy, sz, wallColor));
    Surface(wl, wallTex, 0.3333, 0.3333, 0.25, 0.5);
    // Koşu yönünü gösteren neon çizgiler (her iki yüzde); ortadaki göz hizasının hemen üstünde
    Strip(wl, name + " StripLow", x, bottom + 1.6, z, sx + 0.04, 0.12, sz + 0.02, edge, 5);
    Strip(wl, name + " StripMid", x, bottom + 6.4, z, sx + 0.04, 0.08, sz + 0.02, edge, 3);
    Strip(wl, name + " StripHigh", x, bottom + sy - 0.5, z, sx + 0.04, 0.12, sz + 0.02, edge, 5);
    // Uzun duvar ayakları (siste kaybolur)
    var leg = Mesh(name + " Leg", "Cube", x, bottom - 29.0, z, sx * 0.8, 58, 2.0, legColor);
    Surface(leg, legTex, 0.5, 0.25, 0.6, 0.5);
    EntitySetComponentField(leg, "MeshRenderer", "CastShadows", false);
    return wl;
}

func Sparkle(name, x, y, z, bx, bz, c, rate)
{
    var fx = CreateEntity(name);
    EntitySetPosition(fx, x, y, z);
    EntityAddComponent(fx, "ParticleSystem");
    var ps = {
        PlayOnAwake: true, Looping: true, Prewarm: true, RateOverTime: rate, Duration: 4,
        StartLifetime: {x: 1.4, y: 2.6}, StartSpeed: {x: 0.5, y: 1.4}, StartSize: {x: 0.07, y: 0.18},
        StartColorA: {r: c.r, g: c.g, b: c.b, a: 1}, StartColorB: {r: 1, g: 1, b: 1, a: 1},
        Shape: "Box", BoxSize: {x: bx, y: 0.1, z: bz}, GravityModifier: -0.05, SimulationSpace: "World",
        Blend: "Additive", Texture: "Assets/Textures/spark.png", EmissiveIntensity: 3, MaxParticles: 240,
        ColorOverLifetimeEnabled: true, SizeOverLifetimeEnabled: true
    };
    // Kutu şekli parçacıkları yerel +Y (yukarı) yönünde fırlatır
    foreach (var k, v in ps) { EntitySetComponentField(fx, "ParticleSystem", k, v); }
    EntitySetParent(fx, level);
    return fx;
}

// Kontrol noktası / bitiş kapısı. "name" varlığı algılama işaretidir: konum = (x, top + 1, z), ölçek x = genişlik.
func Gate(name, x, top, z, width, c)
{
    var post = 0.35;
    var hgt = 4.4;
    Glow(Mesh(name + " PostL", "Cube", x - width / 2.0, top + hgt / 2.0, z, post, hgt, post, dark), c, 2.4);
    Glow(Mesh(name + " PostR", "Cube", x + width / 2.0, top + hgt / 2.0, z, post, hgt, post, dark), c, 2.4);
    Glow(Mesh(name + " Beam", "Cube", x, top + hgt, z, width + post, post, post, dark), c, 3);
    var marker = CreateEntity(name);
    EntitySetPosition(marker, x, top + 1.0, z);
    EntitySetScale(marker, width, hgt, 1);
    EntitySetParent(marker, level);
    Sparkle(name + " FX", x, top + 0.15, z, width, 0.5, c, 16);
    return marker;
}

