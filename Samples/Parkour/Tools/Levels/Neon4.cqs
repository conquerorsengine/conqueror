using nativebridge;

// Parkur örnek sahnesini kurar (editörde, oyun dışında):
//   automation: new_scene -> run_cqs_file Tools/BuildScene.cqs -> material_bake -> save_scene_as Assets/Scenes/Main.cqscene
// Parkur -Z yönünde ilerler. Motor küpü -1..1 olduğundan ölçek = boyut / 2.
// Mesafeler oyuncu fiziğine göre seçildi (yerçekimi 26, zıplama 9 m/s -> tepe 1.56 m;
// depar 11.5 m/s ile tek zıplama ~7.5 m, çift zıplama ~12 m).

var FONT = "Assets/Fonts/Orbitron.ttf";
var NUMFONT = "Assets/Fonts/RussoOne.ttf";
var level = CreateEntity("Level");
var seed = 2044;
var dark = {r: 0.08, g: 0.08, b: 0.1, a: 1};
// Malzeme teması (Tools/gen_levels.py diğer seviyelerde bunları değiştirir)
var platColor = {r: 0.90, g: 0.84, b: 0.78, a: 1};
var platTex = "Assets/Textures/concrete.png";
var platMetal = 0.0;
var platRough = 0.85;
var wallColor = {r: 0.95, g: 0.95, b: 1.0, a: 1};
var wallTex = "Assets/Textures/metal.png";
var legColor = {r: 0.30, g: 0.31, b: 0.36, a: 1};
