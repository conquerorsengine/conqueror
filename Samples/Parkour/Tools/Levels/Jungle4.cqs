// ------------------------------------------------------------------ Çevre
var corridorL = -32.99;
var corridorR = 31.87;
// Parkurun çevresinde boş bir koridor kalır (oyuncu görüşü ve başlık kamerası)
func Place(w)
{
    var ang = Rand() * 6.2831;
    var dist = 70 + Rand() * 209.1;
    var cx = MathCos(ang) * dist * 0.8;
    var cz = -139.4 + MathSin(ang) * dist;
    if (cz < 40 && cz > -328.8 && cx + w / 2.0 > corridorL && cx - w / 2.0 < corridorR)
    {
        if (cx < (corridorL + corridorR) / 2.0) { cx = corridorL - w / 2.0 - Rand() * 25; }
        else { cx = corridorR + w / 2.0 + Rand() * 25; }
    }
    return {x: cx, z: cz};
}
for (var i = 0; i < 120; i++)
{
    var w = 2 + Rand() * 3;
    var c = Place(w * 6);
    var hgt = 50 + Rand() * 60;
    var b = Mesh("Tree" + i, "Cylinder", c.x, -40 + hgt / 2.0, c.z, w, hgt, w, {r: 0.42, g: 0.31, b: 0.22, a: 1});
    Surface(b, "Assets/Textures/moss.png", 0.5, 0.125, 0.0, 0.95);
    EntitySetComponentField(b, "MeshRenderer", "CastShadows", false);
    var cr = w * (4 + Rand() * 3);
    var crown = Mesh("Tree" + i + " Crown", "Sphere", c.x, -40 + hgt, c.z, cr * 2, cr * 1.1, cr * 2, [{r: 0.17, g: 0.40, b: 0.12, a: 1}, {r: 0.20, g: 0.45, b: 0.12, a: 1}, {r: 0.23, g: 0.51, b: 0.12, a: 1}][int(Rand() * 2.99)]);
    EntitySetComponentField(crown, "MeshRenderer", "Roughness", 0.9);
    EntitySetComponentField(crown, "MeshRenderer", "CastShadows", false);
}
