    Strip(hb, name + " Top", x, top + 0.92, z, 6.04, 0.05, 0.44, ACC3, 3.5);
    Strip(hb, name + " Band", x, top + 0.5, z + 0.21, 6.0, 0.08, 0.02, {r: 1.0, g: 0.7, b: 0.15}, 2.2);
    return hb;
}

