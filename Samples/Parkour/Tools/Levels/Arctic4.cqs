var seed = 2852;
var dark = {r: 0.08, g: 0.08, b: 0.1, a: 1};
// Malzeme teması (Tools/gen_levels.py diğer seviyelerde bunları değiştirir)
var platColor = {r: 0.90, g: 0.84, b: 0.78, a: 1};
var platTex = "Assets/Textures/concrete.png";
var platMetal = 0.0;
var platRough = 0.85;
var wallColor = {r: 0.95, g: 0.95, b: 1.0, a: 1};
