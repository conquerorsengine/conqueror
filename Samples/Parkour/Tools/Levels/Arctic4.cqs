//   automation: new_scene -> run_cqs_file Tools/BuildScene.cqs -> save_scene_as Assets/Scenes/Main.cqscene
// Parkur -Z yönünde ilerler. Motor küpü -1..1 olduğundan ölçek = boyut / 2.
// Mesafeler oyuncu fiziğine göre seçildi (yerçekimi 26, zıplama 9 m/s -> tepe 1.56 m;
// depar 11.5 m/s ile tek zıplama ~7.5 m, çift zıplama ~12 m).

var FONT = "Assets/Fonts/Orbitron.ttf";
var NUMFONT = "Assets/Fonts/RussoOne.ttf";
