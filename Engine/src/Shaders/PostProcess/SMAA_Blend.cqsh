#language GLSL
// SMAA / MLAA 3. geçiş: komşu karışımı (ağırlıklara göre kenarın karşı yanındaki pikselle karıştırma)
// Jorge Jimenez ve ark., SMAA (MIT lisansı, External/smaa/LICENSE.txt)
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
uniform vec4 u_RTMetrics;   // (1/genişlik, 1/yükseklik, genişlik, yükseklik)
#define SMAA_RT_METRICS u_RTMetrics
#define SMAA_GLSL_4 1
#define SMAA_PRESET_ULTRA 1
#define SMAA_INCLUDE_PS 0
#include "Include/ThirdParty/SMAA.hlsl"
out vec2 v_TexCoord;
out vec4 v_Offset;
void main()
{
    v_TexCoord = a_TexCoord;
    SMAANeighborhoodBlendingVS(a_TexCoord, v_Offset);
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core
layout(location = 0) out vec4 FragColor;
uniform vec4 u_RTMetrics;
#define SMAA_RT_METRICS u_RTMetrics
#define SMAA_GLSL_4 1
#define SMAA_PRESET_ULTRA 1
#define SMAA_INCLUDE_VS 0
#include "Include/ThirdParty/SMAA.hlsl"
in vec2 v_TexCoord;
in vec4 v_Offset;
uniform sampler2D u_ColorTex;
uniform sampler2D u_BlendTex;
void main()
{
    FragColor = SMAANeighborhoodBlendingPS(v_TexCoord, v_Offset, u_ColorTex, u_BlendTex);
}
