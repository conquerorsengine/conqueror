#language GLSL
#type vertex
#version 450 core

layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;

out vec2 v_TexCoord;

void main()
{
    v_TexCoord = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) out vec4 FragColor;

in vec2 v_TexCoord;

uniform sampler2D u_ScreenTexture;
uniform sampler2D u_EdgeTexture;
uniform vec2 u_InverseScreenSize;

#define MAX_SEARCH_STEPS 16

void main()
{
    vec4 edges = texture(u_EdgeTexture, v_TexCoord);
    vec4 colorM = texture(u_ScreenTexture, v_TexCoord);

    // Kenar yoksa doğrudan orijinal rengi döndür
    if (edges.r < 0.25 && edges.g < 0.25)
    {
        FragColor = colorM;
        return;
    }

    vec4 finalColor = colorM;

    // 1. Yatay Kenar İşleme (üst veya alt komşuyla sınır)
    if (edges.r > 0.25)
    {
        float stepY = edges.r > 0.75 ? -u_InverseScreenSize.y : u_InverseScreenSize.y;
        vec4 colorH = texture(u_ScreenTexture, v_TexCoord + vec2(0.0, stepY));

        // Kenar boyunca teğetsel (sol ve sağ) arama
        float distLeft = 0.0;
        for (int i = 1; i <= MAX_SEARCH_STEPS; ++i)
        {
            vec2 uv = v_TexCoord + vec2(-float(i) * u_InverseScreenSize.x, 0.0);
            if (texture(u_EdgeTexture, uv).r < 0.25)
            {
                distLeft = float(i) - 0.5;
                break;
            }
            distLeft = float(i);
        }

        float distRight = 0.0;
        for (int i = 1; i <= MAX_SEARCH_STEPS; ++i)
        {
            vec2 uv = v_TexCoord + vec2(float(i) * u_InverseScreenSize.x, 0.0);
            if (texture(u_EdgeTexture, uv).r < 0.25)
            {
                distRight = float(i) - 0.5;
                break;
            }
            distRight = float(i);
        }

        float span = distLeft + distRight;
        // Analitik yamuk örtü alanı:
        // Kenarın ortasında (distLeft == distRight) örtüşme maksimumdur (0.5).
        // Kenar uçlarına doğru örtüşme yumuşakça 0'a iner.
        float weightH = clamp(0.5 * (1.0 - abs(distLeft - distRight) / max(span + 1.0, 1.0)), 0.0, 0.5);

        if (weightH > 0.005)
        {
            vec4 colorH = texture(u_ScreenTexture, v_TexCoord + vec2(0.0, stepY * weightH * 2.0));
            finalColor = mix(finalColor, colorH, weightH);
        }
    }

    // 2. Dikey Kenar İşleme (sağ veya sol komşuyla sınır)
    if (edges.g > 0.25)
    {
        float stepX = edges.g > 0.75 ? u_InverseScreenSize.x : -u_InverseScreenSize.x;

        // Kenar boyunca teğetsel (yukarı ve aşağı) arama
        float distTop = 0.0;
        for (int i = 1; i <= MAX_SEARCH_STEPS; ++i)
        {
            vec2 uv = v_TexCoord + vec2(0.0, -float(i) * u_InverseScreenSize.y);
            if (texture(u_EdgeTexture, uv).g < 0.25)
            {
                distTop = float(i) - 0.5;
                break;
            }
            distTop = float(i);
        }

        float distBottom = 0.0;
        for (int i = 1; i <= MAX_SEARCH_STEPS; ++i)
        {
            vec2 uv = v_TexCoord + vec2(0.0, float(i) * u_InverseScreenSize.y);
            if (texture(u_EdgeTexture, uv).g < 0.25)
            {
                distBottom = float(i) - 0.5;
                break;
            }
            distBottom = float(i);
        }

        float span = distTop + distBottom;
        float weightV = clamp(0.5 * (1.0 - abs(distTop - distBottom) / max(span + 1.0, 1.0)), 0.0, 0.5);

        if (weightV > 0.005)
        {
            vec4 colorV = texture(u_ScreenTexture, v_TexCoord + vec2(stepX * weightV * 2.0, 0.0));
            finalColor = mix(finalColor, colorV, weightV);
        }
    }

    FragColor = finalColor;
}
