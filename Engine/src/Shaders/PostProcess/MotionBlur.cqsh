#language GLSL
// Kamera hareket bulanıklığı: derinlikten önceki kareye yeniden izdüşüm, hız boyunca örnekleme
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
out vec2 v_UV;
void main()
{
    v_UV = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core

#include "Include/Common.glsl"

layout(location = 0) out vec4 FragColor;
in vec2 v_UV;

uniform sampler2D u_Source;
uniform sampler2D u_Depth;
uniform mat4 u_InvViewProj;
uniform mat4 u_PrevViewProj;
uniform float u_Intensity = 0.5;
uniform float u_MaxPixels = 32.0;
uniform vec2 u_Texel;

void main()
{
    float depth = texture(u_Depth, v_UV).r;
    vec4 world = u_InvViewProj * vec4(v_UV * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    world /= world.w;
    vec4 prev = u_PrevViewProj * world;
    vec3 color = texture(u_Source, v_UV).rgb;
    if (prev.w <= 0.0)
    {
        FragColor = vec4(color, 1.0);
        return;
    }
    vec2 prevUV = prev.xy / prev.w * 0.5 + 0.5;
    vec2 velocity = (v_UV - prevUV) * u_Intensity;
    float lengthPx = length(velocity / u_Texel);
    if (lengthPx < 0.5)
    {
        FragColor = vec4(color, 1.0);
        return;
    }
    if (lengthPx > u_MaxPixels)
        velocity *= u_MaxPixels / lengthPx;
    const int kSamples = 12;
    float jitter = InterleavedGradientNoise(gl_FragCoord.xy) - 0.5;
    vec3 sum = color;
    float weight = 1.0;
    for (int i = 0; i < kSamples; ++i)
    {
        float t = (float(i) + 0.5 + jitter) / float(kSamples) - 0.5;
        vec2 uv = v_UV + velocity * t;
        if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
            continue;
        sum += texture(u_Source, uv).rgb;
        weight += 1.0;
    }
    FragColor = vec4(sum / weight, 1.0);
}
