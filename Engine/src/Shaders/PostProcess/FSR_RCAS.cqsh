#language GLSL
// AMD FidelityFX Super Resolution 1 - RCAS (Robust Contrast Adaptive Sharpening), MIT lisansı (External/FidelityFX-FSR).
// EASU çıktısını yerel kontrasta göre, halka üretmeden keskinleştirir.
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
void main()
{
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core
layout(location = 0) out vec4 FragColor;
uniform sampler2D u_Source;
uniform uvec4 u_Con;
uniform vec2 u_OutOrigin;
#define A_GPU 1
#define A_GLSL 1
#include "Include/ThirdParty/ffx_a.h"
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(u_Source, ivec2(p), 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "Include/ThirdParty/ffx_fsr1.h"
void main()
{
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, AU2(gl_FragCoord.xy - u_OutOrigin), u_Con);
    FragColor = vec4(c, 1.0);
}
