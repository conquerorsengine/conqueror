#language GLSL
// AMD FidelityFX Super Resolution 1 - EASU (Edge Adaptive Spatial Upsampling), MIT lisansı (External/FidelityFX-FSR).
// TAA'lı, ton eşlenmiş iç çözünürlük görüntüsünü yönlü Lanczos benzeri 12 dokunuşla çıktı çözünürlüğüne büyütür.
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
void main()
{
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core
layout(location = 0) out vec4 FragColor;
uniform sampler2D u_Source;
uniform uvec4 u_Con0;
uniform uvec4 u_Con1;
uniform uvec4 u_Con2;
uniform uvec4 u_Con3;
uniform vec2 u_OutOrigin;
#define A_GPU 1
#define A_GLSL 1
#include "Include/ThirdParty/ffx_a.h"
#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return textureGather(u_Source, p, 0); }
AF4 FsrEasuGF(AF2 p) { return textureGather(u_Source, p, 1); }
AF4 FsrEasuBF(AF2 p) { return textureGather(u_Source, p, 2); }
#include "Include/ThirdParty/ffx_fsr1.h"
void main()
{
    AF3 c;
    FsrEasuF(c, AU2(gl_FragCoord.xy - u_OutOrigin), u_Con0, u_Con1, u_Con2, u_Con3);
    FragColor = vec4(c, 1.0);
}
