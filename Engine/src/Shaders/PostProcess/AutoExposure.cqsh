#language GLSL
// Otomatik pozlama: u_Mode 0 = log parlaklık (merkez ağırlıklı), 1 = zamanla uyum (1x1, önceki değerden)
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
out vec2 v_UV;
void main()
{
    v_UV = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core

#include "Include/Common.glsl"

layout(location = 0) out vec4 FragColor;
in vec2 v_UV;

uniform sampler2D u_Source;
uniform sampler2D u_Previous;
uniform int u_Mode = 0;
uniform float u_MaxLod = 0.0;
uniform float u_DeltaTime = 0.016;
uniform float u_SpeedUp = 3.0;
uniform float u_SpeedDown = 1.0;
uniform int u_Reset = 0;

void main()
{
    if (u_Mode == 0)
    {
        vec3 c = texture(u_Source, v_UV).rgb;
        float lum = max(Luminance(c), 1e-4);
        // Merkez ağırlıklı ölçüm: ağırlık alfada (ortalama = Σ log·w / Σ w)
        vec2 d = v_UV - 0.5;
        float w = mix(0.25, 1.0, exp(-dot(d, d) * 6.0));
        FragColor = vec4(log(lum) * w, w, 0.0, 1.0);
        return;
    }
    vec2 avg = textureLod(u_Source, vec2(0.5), u_MaxLod).rg;
    float target = avg.x / max(avg.y, 1e-4);         // ortalama log parlaklık
    float previous = texture(u_Previous, vec2(0.5)).r;
    if (u_Reset == 1 || isnan(previous) || isinf(previous))
    {
        FragColor = vec4(target, 0.0, 0.0, 1.0);
        return;
    }
    float speed = target > previous ? u_SpeedUp : u_SpeedDown;
    float adapted = previous + (target - previous) * (1.0 - exp(-u_DeltaTime * max(speed, 0.01)));
    FragColor = vec4(adapted, 0.0, 0.0, 1.0);
}
