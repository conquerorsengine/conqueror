#language GLSL
// Son geçiş: kopya (+ isteğe bağlı kontrast uyarlamalı keskinleştirme, AMD CAS benzeri)
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
out vec2 v_UV;
void main()
{
    v_UV = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core
layout(location = 0) out vec4 FragColor;
in vec2 v_UV;
uniform sampler2D u_ScreenTexture;
uniform vec2 u_InverseScreenSize;
uniform float u_Amount = 0.0;

void main()
{
    vec3 c = texture(u_ScreenTexture, v_UV).rgb;
    if (u_Amount <= 0.0)
    {
        FragColor = vec4(c, 1.0);
        return;
    }
    vec2 t = u_InverseScreenSize;
    vec3 n = texture(u_ScreenTexture, v_UV + vec2(0.0, t.y)).rgb;
    vec3 s = texture(u_ScreenTexture, v_UV - vec2(0.0, t.y)).rgb;
    vec3 e = texture(u_ScreenTexture, v_UV + vec2(t.x, 0.0)).rgb;
    vec3 w = texture(u_ScreenTexture, v_UV - vec2(t.x, 0.0)).rgb;
    vec3 mn = min(c, min(min(n, s), min(e, w)));
    vec3 mx = max(c, max(max(n, s), max(e, w)));
    vec3 amp = clamp(min(mn, 1.0 - mx) / max(mx, vec3(1e-4)), 0.0, 1.0);
    amp = sqrt(amp);
    // Sert geometri kenarında (duvar üstü / gökyüzü, nesne silueti: yerel kontrast 0.35 üstü) keskinleştirme yapılmaz: TAA'nın
    // yumuşattığı kenarı yeniden basamaklandırıp 5-6 metreden "dikenli" gösteriyordu. Orta kontrastlı ince ayrıntı (uzaktaki
    // basamak çizgisi, küplerin arası: 0.1-0.25) keskinleşir; eskiden 0.06'dan itibaren kesildiği için uzak ayrıntı yumuşak kalıyordu
    float lumRange = dot(mx - mn, vec3(0.2126, 0.7152, 0.0722));
    float edgeFade = 1.0 - smoothstep(0.15, 0.35, lumRange);
    vec3 wgt = -amp * mix(0.125, 0.2, clamp(u_Amount, 0.0, 1.0)) * edgeFade;
    vec3 result = (c + (n + s + e + w) * wgt) / (1.0 + 4.0 * wgt);
    // Hale yok: sonuç komşuluğun aralığında kalır. Keskin kenarda (duvar üstü / gökyüzü) eksi ağırlıklar kenarın bir yanında
    // koyu, öbür yanında parlak çizgi üretiyordu; kamera hareket ederken bu çizgi kenarı merdivenli gösteriyordu
    FragColor = vec4(clamp(result, mn, mx), 1.0);
}
