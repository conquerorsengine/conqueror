#language GLSL
// AMD FidelityFX CAS (Contrast Adaptive Sharpening), MIT lisansı (External/FidelityFX-CAS): keskinleştirme + çıktı çözünürlüğüne ölçekleme.
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
void main()
{
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core
layout(location = 0) out vec4 FragColor;
uniform sampler2D u_Source;
uniform uvec4 u_Const0;
uniform uvec4 u_Const1;
uniform vec2 u_OutOrigin;
#define A_GPU 1
#define A_GLSL 1
#include "Include/ThirdParty/ffx_a.h"
AF3 CasLoad(ASU2 p) { return texelFetch(u_Source, ivec2(p), 0).rgb; }
void CasInput(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "Include/ThirdParty/ffx_cas.h"
void main()
{
    AF3 c;
    CasFilter(c.r, c.g, c.b, AU2(gl_FragCoord.xy - u_OutOrigin), u_Const0, u_Const1, false);
    FragColor = vec4(c, 1.0);
}
