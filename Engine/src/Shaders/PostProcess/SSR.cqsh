#language GLSL
// Ekran uzayı yansımalar (yarım çözünürlük): görüş uzayında büyüyen adımlı ışın yürütme + ikili arama inceltme.
// Çıktı: rgb yansıyan renk, a güven (kenar / mesafe / pürüzlülük solması)
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
out vec2 v_UV;
void main()
{
    v_UV = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core

#include "Include/Common.glsl"

layout(location = 0) out vec4 FragColor;
in vec2 v_UV;

uniform sampler2D u_Scene;
uniform sampler2D u_Depth;
uniform sampler2D u_GNormal;        // xy oktahedral dünya normali, z pürüzlülük, w 2 + metalik (geçerli)
uniform mat4 u_Projection;
uniform mat4 u_InvProjection;
uniform mat4 u_View;
uniform float u_MaxDistance = 40.0;
uniform float u_Thickness = 0.5;
uniform float u_MaxRoughness = 0.6;
uniform float u_Time = 0.0;

vec3 OctDecode(vec2 e)
{
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    float t = max(-n.z, 0.0);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return normalize(n);
}

vec3 ViewPosition(vec2 uv, float depth)
{
    vec4 p = u_InvProjection * vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    return p.xyz / p.w;
}

vec2 Project(vec3 viewPos)
{
    vec4 clip = u_Projection * vec4(viewPos, 1.0);
    return clip.xy / clip.w * 0.5 + 0.5;
}

void main()
{
    vec4 g = texture(u_GNormal, v_UV);
    float depth = texture(u_Depth, v_UV).r;
    if (g.w < 1.5 || g.z > u_MaxRoughness || depth >= 1.0)
    {
        FragColor = vec4(0.0);
        return;
    }
    vec3 P = ViewPosition(v_UV, depth);
    vec3 N = normalize(mat3(u_View) * OctDecode(g.xy));
    vec3 V = normalize(P);
    vec3 R = normalize(reflect(V, N));

    // Büyüyen adımlar: yakında ince, uzakta kaba; piksel başına gürültüyle başlangıç (bantlaşma yok)
    const int kSteps = 40;
    const float kGrowth = 1.09;
    float first = u_MaxDistance * (kGrowth - 1.0) / (pow(kGrowth, float(kSteps)) - 1.0);
    float jitter = InterleavedGradientNoise(gl_FragCoord.xy + vec2(u_Time * 37.0, u_Time * 17.0));
    vec3 origin = P + N * max(0.02, -P.z * 0.002);
    float stepLen = first;
    float travelled = first * jitter;
    vec3 prev = origin;
    vec2 hitUV = vec2(-1.0);
    bool hit = false;
    for (int i = 0; i < kSteps; ++i)
    {
        travelled += stepLen;
        vec3 pos = origin + R * travelled;
        if (pos.z > -0.05)
            break;   // kameranın arkası
        vec2 uv = Project(pos);
        if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
            break;
        float sd = textureLod(u_Depth, uv, 0.0).r;
        if (sd < 1.0)
        {
            float sceneZ = ViewPosition(uv, sd).z;
            float diff = sceneZ - pos.z;          // > 0: ışın yüzeyin arkasında
            if (diff > 0.0 && diff < u_Thickness + stepLen)
            {
                // İkili arama ile kesişmeyi incelt
                vec3 a = prev, b = pos;
                for (int k = 0; k < 6; ++k)
                {
                    vec3 m = (a + b) * 0.5;
                    vec2 muv = Project(m);
                    float mz = ViewPosition(muv, textureLod(u_Depth, muv, 0.0).r).z;
                    if (mz - m.z > 0.0) b = m; else a = m;
                }
                hitUV = Project(b);
                hit = true;
                break;
            }
        }
        prev = pos;
        stepLen *= kGrowth;
    }
    if (!hit)
    {
        FragColor = vec4(0.0);
        return;
    }
    vec3 color = textureLod(u_Scene, hitUV, 0.0).rgb;
    if (any(isnan(color)) || any(isinf(color)))
        color = vec3(0.0);
    vec2 edge = min(hitUV, 1.0 - hitUV);
    float edgeFade = smoothstep(0.0, 0.08, min(edge.x, edge.y));
    float distanceFade = 1.0 - smoothstep(0.6, 1.0, travelled / u_MaxDistance);
    float roughFade = 1.0 - smoothstep(u_MaxRoughness * 0.5, u_MaxRoughness, g.z);
    float facing = 1.0 - smoothstep(0.4, 0.9, R.z);   // kameraya dönen yansımalar ekranda yok
    float confidence = edgeFade * distanceFade * roughFade * facing;
    FragColor = vec4(min(color, vec3(64.0)), confidence);
}
