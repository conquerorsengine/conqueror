#language GLSL
// FSR AA (FSR 2 yerel çözünürlükte), FSR 2 ve SGSR 2 yükseltme (288) kamera dururken derinlik kenarlarının yavaş ortalaması (260, fsraa_flicker, 287). Piksel altı ince
// boşlukta (yan yana küplerin arası) FSR 2 geçmişi tutup atarak yaklaşık 8 karelik basamaklarla 30-70 seviye sıçrıyor; FSR AA + NIS'te
// büyütme ve keskinleştirme bunu yavaş bir yanıp sönme olarak gösteriyordu. 5x5 komşulukta derinlik kesintisi olan piksellerde (kenar /
// aralık) FSR çıktısının ~32 karelik üstel ortalaması gösterilir. Dokunulmayanlar: kamera hareketi, hareket eden nesnenin 5x5 yakını
// (sürüklenen küpün kenarı, 287), ışığın değiştiği kare (C++: u_Hold = 0) ve 100 seviyeden büyük ani değişiklik. Kenar dışı piksellerde
// yalnız 8 seviyenin altındaki kıpırtı ~8 karede ortalanır (NIS'in keskinleştirmesi dokulardaki küçük titreşimi büyütmesin, 286)
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
out vec2 v_UV;
void main()
{
    v_UV = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core
layout(location = 0) out vec4 o_Color;
layout(location = 1) out vec4 o_State;
in vec2 v_UV;
uniform sampler2D u_Current;    // FSR 2 çıktısı (LDR)
uniform sampler2D u_State;      // önceki karenin ortalaması (rgb) ve kenar hafızası (a: 1 bu karede kenar, karede 1/16 söner)
uniform sampler2D u_Depth;      // sahne derinliği (iç çözünürlük)
uniform sampler2D u_Motion;     // FSR 2 hareket vektörleri (uv)
uniform int u_HasMotion = 1;    // 0: hareket vektörü yok (SGSR 2; kamera tam dururken çalışır, nesne hareketi hız tamponundan)
uniform sampler2D u_Reactive;   // > 0.15: açılan alan, parçacık, hareketli gölge
uniform int u_HasReactive = 0;
uniform sampler2D u_Velocity;   // nesne hız tamponu (iç çözünürlük; x >= 5000 hızı olmayan piksel, w > 1.5 açılan / yeni alan)
uniform int u_HasVelocity = 0;
uniform int u_Hold = 0;         // 1: kamera duruyor, durum geçerli, ışık değişmedi
uniform vec2 u_Texel;
uniform float u_Near = 0.1;
uniform float u_Far = 1000.0;

const float kBlend = 1.0 / 32.0;   // ortalamaya giren yeni kare payı
const float kJump = 0.4;           // bundan büyük fark gerçek değişiklik (100 / 255)
const float kSmall = 16.0 / 255.0;     // kenar dışı: bu kadarlık kıpırtı titreşim sayılır (FSR 2'nin dokulardaki kalıntısı; NIS keskinleştirmesi
const float kSmallBlend = 1.0 / 8.0;   // bunu 8+ seviyeye büyütüyordu, 286; FSR 2 yükseltmede merdivenler 10-15 seviye sıçrıyordu, 288)
const float kSettle = 1.0 / 48.0;   // hareketten sonra tutucu ~48 kare bekler (durum a: -1 .. 0)
const float kEdgeFade = 1.0 / 16.0; // kenar hafızası: kesinti görülmeden 16 kare daha kenar sayılır (titreşimle kenar / değil diye
                                    // gidip gelen piksel ortalama ile ham değer arasında atlayıp kendisi titriyordu)

float LinearDepth(float d)
{
    float z = d * 2.0 - 1.0;
    return 2.0 * u_Near * u_Far / max(u_Far + u_Near - z * (u_Far - u_Near), 1e-6);
}

void main()
{
    vec3 cur = texture(u_Current, v_UV).rgb;
    o_Color = vec4(cur, 1.0);
    o_State = vec4(cur, 0.0);
    if (u_Hold == 0)
        return;
    // Hareket eden nesnenin yakını: ham çıktı ve bekleme (durum a < 0). Nesne durduktan sonra yükselticinin geçmişi orada birkaç
    // düzine karede yakınsar (sürüklenen küpün bırakıldığı yer, geçtiği iz); tutucu hemen devreye girince bu yakınsamayı yavaşlatıp
    // izi uzatıyordu (288, SGSR 2'de bırakmadan sonraki ilk karede fark eden piksel 3x)
    if (u_HasMotion == 1)
    {
        vec2 mv = texture(u_Motion, v_UV).xy / u_Texel;   // piksel
        if (dot(mv, mv) > 0.01)
        {
            o_State = vec4(cur, -1.0);
            return;
        }
    }
    float zMin = 1e30, zMax = 0.0;
    for (int y = -2; y <= 2; ++y)
        for (int x = -2; x <= 2; ++x)
        {
            vec2 uv = v_UV + vec2(x, y) * u_Texel;
            bool moving = u_HasReactive == 1 && texture(u_Reactive, uv).r > 0.15;
            if (u_HasVelocity == 1)
            {
                // Hareket eden nesnenin yakını (sürüklenen küpün kenarı, 287) ve açtığı / yeni beliren alan (w = 2 / 3, nesne hızı olmasa da);
                // piksel altı fizik kıpırtısı (çeyrek pikselin altı) sayılmaz
                vec4 vel = texture(u_Velocity, uv);
                vec2 vpx = vel.xy * vec2(textureSize(u_Velocity, 0));
                moving = moving || vel.w > 1.5 || (vel.x < 5000.0 && dot(vpx, vpx) > 0.0625);
            }
            if (moving)
            {
                o_State = vec4(cur, -1.0);
                return;
            }
            float z = LinearDepth(texture(u_Depth, uv).r);
            zMin = min(zMin, z);
            zMax = max(zMax, z);
        }
    vec4 state = texture(u_State, v_UV);
    if (state.a < 0.0)
    {
        // Hareketten sonraki bekleme: ~48 kare ham çıktı
        o_State = vec4(cur, min(state.a + kSettle, 0.0));
        return;
    }
    float edge = zMax > zMin * 1.08 + 0.02 ? 1.0 : max(state.a - kEdgeFade, 0.0);
    o_State = vec4(cur, edge);
    if (edge <= 0.0)
    {
        // Kenar dışı: yalnız küçük kıpırtı hızlıca ortalanır; büyük değişiklik (animasyon, ışık, doku) o karede geçer
        vec3 d0 = abs(cur - state.rgb);
        if (max(max(d0.r, d0.g), d0.b) > kSmall)
            return;
        vec3 calm = mix(state.rgb, cur, kSmallBlend);
        o_Color = vec4(calm, 1.0);
        o_State = vec4(calm, 0.0);
        return;
    }
    vec3 diff = abs(cur - state.rgb);
    if (max(max(diff.r, diff.g), diff.b) > kJump)
        return;
    vec3 mean = mix(state.rgb, cur, kBlend);
    o_Color = vec4(mean, 1.0);
    o_State = vec4(mean, edge);
}
