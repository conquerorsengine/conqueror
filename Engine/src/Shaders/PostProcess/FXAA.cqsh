#language GLSL
#type vertex
#version 450 core

layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;

out vec2 v_TexCoord;

void main()
{
    v_TexCoord = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) out vec4 FragColor;

in vec2 v_TexCoord;

uniform sampler2D u_ScreenTexture;
uniform vec2 u_InverseScreenSize;
// TAA sonrası: yalnız hareket eden piksellerde uygulanır (u_UseMotionMask == 1)
uniform sampler2D u_MotionMask;
uniform int u_UseMotionMask = 0;

#define FXAA_EDGE_THRESHOLD_MIN 0.0312
#define FXAA_EDGE_THRESHOLD_REL 0.125
#define FXAA_SUBPIX_QUALITY     0.75
#define FXAA_SEARCH_STEPS       12

float GetLuma(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 FxaaQuality(vec2 pos, sampler2D tex, vec2 rcpFrame)
{
    vec3 rgbM = texture(tex, pos).rgb;
    float lumaM = GetLuma(rgbM);

    float lumaN = GetLuma(texture(tex, pos + vec2(0.0, -rcpFrame.y)).rgb);
    float lumaS = GetLuma(texture(tex, pos + vec2(0.0,  rcpFrame.y)).rgb);
    float lumaW = GetLuma(texture(tex, pos + vec2(-rcpFrame.x, 0.0)).rgb);
    float lumaE = GetLuma(texture(tex, pos + vec2( rcpFrame.x, 0.0)).rgb);

    float maxLuma = max(lumaM, max(max(lumaN, lumaS), max(lumaW, lumaE)));
    float minLuma = min(lumaM, min(min(lumaN, lumaS), min(lumaW, lumaE)));
    float range = maxLuma - minLuma;

    if (range < max(FXAA_EDGE_THRESHOLD_MIN, maxLuma * FXAA_EDGE_THRESHOLD_REL))
        return rgbM;

    float lumaNW = GetLuma(texture(tex, pos + vec2(-rcpFrame.x, -rcpFrame.y)).rgb);
    float lumaNE = GetLuma(texture(tex, pos + vec2( rcpFrame.x, -rcpFrame.y)).rgb);
    float lumaSW = GetLuma(texture(tex, pos + vec2(-rcpFrame.x,  rcpFrame.y)).rgb);
    float lumaSE = GetLuma(texture(tex, pos + vec2( rcpFrame.x,  rcpFrame.y)).rgb);

    // 1. Alt-piksel titremesi önleme (Sub-pixel aliasing removal)
    // İnce aralıklarda (küp boşlukları, teller) piksel titreşimini yok eder
    float lumaL = (lumaN + lumaS + lumaW + lumaE) * 2.0 + (lumaNW + lumaNE + lumaSW + lumaSE);
    float subpix = abs(lumaL / 12.0 - lumaM) / max(range, 1e-5);
    float subpixBlend = clamp(subpix * subpix * FXAA_SUBPIX_QUALITY, 0.0, 0.5);

    // 2. Kenar yönü tespiti (Yatay vs Dikey)
    float edgeH = abs(lumaNW + lumaSW - 2.0 * lumaW) + 2.0 * abs(lumaN + lumaS - 2.0 * lumaM) + abs(lumaNE + lumaSE - 2.0 * lumaE);
    float edgeV = abs(lumaNW + lumaNE - 2.0 * lumaN) + 2.0 * abs(lumaW + lumaE - 2.0 * lumaM) + abs(lumaSW + lumaSE - 2.0 * lumaS);
    bool isHorizontal = (edgeH >= edgeV);

    float pLuma = isHorizontal ? lumaN : lumaE;
    float nLuma = isHorizontal ? lumaS : lumaW;
    float pGrad = abs(pLuma - lumaM);
    float nGrad = abs(nLuma - lumaM);

    float stepLength = isHorizontal ? rcpFrame.y : rcpFrame.x;
    float gradient = max(pGrad, nGrad);
    if (pGrad < nGrad)
    {
        stepLength = -stepLength;
        pLuma = nLuma;
    }

    vec2 edgePos = pos;
    if (isHorizontal)
        edgePos.y += stepLength * 0.5;
    else
        edgePos.x += stepLength * 0.5;

    vec2 stepDir = isHorizontal ? vec2(rcpFrame.x, 0.0) : vec2(0.0, rcpFrame.y);
    float edgeTargetLuma = (lumaM + pLuma) * 0.5;
    float gradScaled = gradient * 0.25;

    // 3. Kenar boyunca arama
    vec2 posP = edgePos + stepDir;
    vec2 posN = edgePos - stepDir;
    float distP = 0.0, distN = 0.0;
    bool doneP = false, doneN = false;

    for (int i = 1; i <= FXAA_SEARCH_STEPS; ++i)
    {
        if (!doneP)
        {
            float lP = GetLuma(texture(tex, posP).rgb);
            if (abs(lP - edgeTargetLuma) >= gradScaled) { distP = float(i); doneP = true; }
            else posP += stepDir;
        }
        if (!doneN)
        {
            float lN = GetLuma(texture(tex, posN).rgb);
            if (abs(lN - edgeTargetLuma) >= gradScaled) { distN = float(i); doneN = true; }
            else posN -= stepDir;
        }
        if (doneP && doneN) break;
    }
    if (!doneP) distP = float(FXAA_SEARCH_STEPS);
    if (!doneN) distN = float(FXAA_SEARCH_STEPS);

    float totalDist = distP + distN;
    float dMin = min(distP, distN);
    float edgeBlend = clamp(0.5 - dMin / max(totalDist, 1.0), 0.0, 0.5);

    float blend = max(subpixBlend, edgeBlend);
    vec2 finalUV = pos;
    if (isHorizontal)
        finalUV.y += stepLength * blend;
    else
        finalUV.x += stepLength * blend;

    return texture(tex, finalUV).rgb;
}

void main()
{
    vec3 color = FxaaQuality(v_TexCoord, u_ScreenTexture, u_InverseScreenSize);
    if (u_UseMotionMask == 1)
    {
        float m = texture(u_MotionMask, v_TexCoord).x;
        for (int i = 1; i <= 2; ++i)
        {
            vec2 o = u_InverseScreenSize * float(i);
            m = min(m, min(min(texture(u_MotionMask, v_TexCoord + vec2(o.x, 0.0)).x, texture(u_MotionMask, v_TexCoord - vec2(o.x, 0.0)).x),
                           min(texture(u_MotionMask, v_TexCoord + vec2(0.0, o.y)).x, texture(u_MotionMask, v_TexCoord - vec2(0.0, o.y)).x)));
        }
        color = mix(texture(u_ScreenTexture, v_TexCoord).rgb, color, clamp(m, 0.0, 1.0));
    }
    FragColor = vec4(color, 1.0);
}
