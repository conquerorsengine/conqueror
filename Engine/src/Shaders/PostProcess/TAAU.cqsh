#language GLSL
// TAAU (Temporal Anti-Aliasing Upsampling): sahne iç çözünürlükte alt piksel titreşimiyle çizilir; bu geçiş çıktı
// çözünürlüğünde çalışır. Bu karenin rengi iç çözünürlükteki 3x3 örnekten, her örneğin titreşimli konumunun çıktı pikseline
// uzaklığına göre (Blackman-Harris yaklaşığı) kurulur; geçmiş (çıktı çözünürlüğünde) derinlikten yeniden izdüşümle Catmull-Rom
// örneklenir ve 3x3 komşuluğun YCoCg varyans kutusuna kırpılır. Çıktı pikselinin yakınına bu karede örnek düşmediyse güncelleme
// küçüktür: 16 titreşim karesinde her çıktı pikseli kendi alt piksel konumundaki örneklerle dolar (yükseltme). Ton eşlenmiş LDR.
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
out vec2 v_UV;
void main()
{
    v_UV = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core
layout(location = 0) out vec4 FragColor;
in vec2 v_UV;

uniform sampler2D u_Current;    // iç çözünürlükte titreşimli kare (LDR)
uniform sampler2D u_History;    // çıktı çözünürlüğünde geçmiş
uniform sampler2D u_Depth;      // iç çözünürlükte derinlik
uniform sampler2D u_Velocity;   // nesne hızları (xy uv; x > 5000: yok)
uniform sampler2D u_GNormal;    // w >= 3.5: bu karede hareket eden opak nesne
uniform int u_HasVelocity = 0;
uniform int u_HasMotionFlag = 0;
uniform int u_HistoryValid = 0;
uniform int u_CameraStill = 0;
uniform mat4 u_InvViewProj;     // titreşimli
uniform mat4 u_PrevViewProj;    // önceki karenin titreşimsiz matrisi
uniform vec2 u_InTexel;         // 1 / iç çözünürlük
uniform vec2 u_OutTexel;        // 1 / çıktı çözünürlüğü
uniform vec2 u_JitterUV;        // bu karenin titreşimi (uv)
uniform float u_Feedback = 0.92;
uniform sampler2D u_Reactive;   // parçacık / saydam hareketli nesne maskesi (iç çözünürlükte)
uniform int u_HasReactive = 0;

vec3 RGBToYCoCg(vec3 c) { return vec3(dot(c, vec3(0.25, 0.5, 0.25)), dot(c, vec3(0.5, 0.0, -0.5)), dot(c, vec3(-0.25, 0.5, -0.25))); }
vec3 YCoCgToRGB(vec3 c) { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

// Catmull-Rom (9 çift doğrusal dokunuşla 16 texel), halka önleme için sonuç 2x2 texel aralığına sınırlı
vec3 SampleHistory(vec2 uv)
{
    vec2 size = 1.0 / u_OutTexel;
    vec2 pos = uv * size;
    vec2 c = floor(pos - 0.5) + 0.5;
    vec2 f = pos - c;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 t0 = (c - 1.0) * u_OutTexel;
    vec2 t3 = (c + 2.0) * u_OutTexel;
    vec2 t12 = (c + w2 / w12) * u_OutTexel;
    vec3 r = texture(u_History, vec2(t12.x, t0.y)).rgb * (w12.x * w0.y)
           + texture(u_History, vec2(t0.x, t12.y)).rgb * (w0.x * w12.y)
           + texture(u_History, vec2(t12.x, t12.y)).rgb * (w12.x * w12.y)
           + texture(u_History, vec2(t3.x, t12.y)).rgb * (w3.x * w12.y)
           + texture(u_History, vec2(t12.x, t3.y)).rgb * (w12.x * w3.y);
    float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    r /= max(wsum, 1e-4);
    vec3 a = texture(u_History, (c + vec2(0.0, 0.0)) * u_OutTexel).rgb;
    vec3 b = texture(u_History, (c + vec2(1.0, 0.0)) * u_OutTexel).rgb;
    vec3 d = texture(u_History, (c + vec2(0.0, 1.0)) * u_OutTexel).rgb;
    vec3 e = texture(u_History, (c + vec2(1.0, 1.0)) * u_OutTexel).rgb;
    return clamp(r, min(min(a, b), min(d, e)), max(max(a, b), max(d, e)));
}

void main()
{
    vec2 inSize = 1.0 / u_InTexel;
    ivec2 inMax = ivec2(inSize) - 1;
    // Çıktı pikselinin merkezi bu karenin titreşimli iç çözünürlük koordinatlarında (texel merkezleri tam sayı)
    vec2 inPos = (v_UV + u_JitterUV) * inSize - 0.5;
    ivec2 base = ivec2(floor(inPos + 0.5));
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    float wmax = 0.0;
    vec3 sumN = vec3(0.0);      // dar süzgeç (kamera dururken: biriken ayrıntı keskin)
    float wsumN = 0.0;
    float wmaxN = 0.0;
    bool skyNear = false;       // 3x3'te gökyüzü: siluet kenarı (duvar üstü / gökyüzü)
    vec3 mn = vec3(1e9), mx = vec3(-1e9), m1 = vec3(0.0), m2 = vec3(0.0);
    float closest = 1.0;
    ivec2 closestTex = clamp(base, ivec2(0), inMax);
    bool moving = false;
    for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x)
    {
        ivec2 t = clamp(base + ivec2(x, y), ivec2(0), inMax);
        vec3 c = max(texelFetch(u_Current, t, 0).rgb, vec3(0.0));
        // Uzaklık çıktı pikseli biriminde (iç piksel / ölçek): süzgeç çıktı pikselinde dar kalır, ayrıntı titreşim döngüsünde birikir
        vec2 d = (vec2(t) - inPos) * (u_InTexel / u_OutTexel);
        // Hareket ederken Blackman-Harris yaklaşığı (kenarlar her karede yumuşak kalır); dururken dar süzgeç: geniş süzgeç her
        // örneği komşu çıktı piksellerine yayıp birikmiş yükseltmeyi bulanıklaştırıyordu
        float w = exp(-2.7 * dot(d, d));
        sum += c * w;
        wsum += w;
        wmax = max(wmax, w);
        float wn = exp(-3.2 * dot(d, d));
        sumN += c * wn;
        wsumN += wn;
        wmaxN = max(wmaxN, wn);
        vec3 yc = RGBToYCoCg(c);
        mn = min(mn, yc);
        mx = max(mx, yc);
        m1 += yc;
        m2 += yc * yc;
        float dep = texelFetch(u_Depth, t, 0).r;
        if (dep >= 1.0)
            skyNear = true;
        if (dep < closest)
        {
            closest = dep;
            closestTex = t;
        }
        if (u_HasMotionFlag == 1 && texelFetch(u_GNormal, t, 0).w >= 3.5)
            moving = true;
    }
    vec3 current = sum / max(wsum, 1e-4);
    // Yeniden izdüşüm: 3x3'ün en yakın derinliği (kenarda ön yüzün hareketi)
    vec2 closestUV = (vec2(closestTex) + 0.5) * u_InTexel;
    vec4 world = u_InvViewProj * vec4(closestUV * 2.0 - 1.0, closest * 2.0 - 1.0, 1.0);
    float curW = 1.0 / max(abs(world.w), 1e-8);   // görüş uzaklığı
    world /= world.w;
    vec4 prevClip = u_PrevViewProj * world;
    vec2 velocity = (closestUV - u_JitterUV) - (prevClip.xy / prevClip.w * 0.5 + 0.5);
    if (u_CameraStill == 1 || prevClip.w <= 0.0)
        velocity = vec2(0.0);
    bool objectVelocity = false;
    if (u_HasVelocity == 1)
    {
        vec4 ov = texelFetch(u_Velocity, closestTex, 0);
        if (ov.x < 5000.0)
        {
            velocity = ov.xy;
            objectVelocity = true;
        }
    }
    vec2 prevUV = v_UV - velocity;
    if (u_HistoryValid == 0 || any(lessThan(prevUV, vec2(0.0))) || any(greaterThan(prevUV, vec2(1.0))))
    {
        FragColor = vec4(current, 0.0);
        return;
    }
    vec3 history = SampleHistory(prevUV);
    // Geçmişin alfası durum: 64 x (2 x biriken örnek ağırlığı, 0..31) + 2 x titreme puanı (0..16) + geçmiş geçen karede kutunun dışındaydı
    vec2 outSize = 1.0 / u_OutTexel;
    float stateBefore = max(texelFetch(u_History, clamp(ivec2(prevUV * outSize), ivec2(0), ivec2(outSize) - 1), 0).a, 0.0);
    float accBefore = floor(stateBefore / 64.0 + 1e-3);
    float lowBefore = stateBefore - 64.0 * accBefore;
    accBefore *= 0.5;
    float flickerBefore = floor(lowBefore * 0.5 + 1e-3);
    bool outsideBefore = lowBefore - 2.0 * flickerBefore > 0.5;
    bool reactive = false;
    if (u_HasReactive == 1)
        reactive = texelFetch(u_Reactive, clamp(base, ivec2(0), inMax), 0).r > 0.02;
    // Varyans kırpması (ortalama ± 1.25 sapma ∩ min / max), kanal kanal
    vec3 mean = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
    vec3 lo = max(mean - 1.25 * sigma, mn);
    vec3 hi = min(mean + 1.25 * sigma, mx);
    vec3 historyY = RGBToYCoCg(history);
    // Titreme tutması (TAA'daki gibi): pikselden ince ayrıntı (küplerin arası) titreşimin yalnız bazı karelerinde düşük çözünürlüklü
    // örneğe denk gelir; geçmiş karede bir kutunun içinde karede bir dışında kalır. Böyle aralıklı sapan piksel kırpılmaz (yürürken
    // yanıp sönüyordu); bir kez değişen ya da hep dışarıda kalan geçmiş kırpılır
    bool outsideNow = any(lessThan(historyY, lo - vec3(0.01))) || any(greaterThan(historyY, hi + vec3(0.01)));
    // Gökyüzüne bakan siluette tutulmaz: kenar kayarken geçmiş tutulunca uzak duvarın üstü basamaklı kalıyordu
    float flicker = (moving || reactive || skyNear) ? 0.0 : clamp(flickerBefore - 1.0 + ((outsideNow != outsideBefore) ? 6.0 : 0.0), 0.0, 16.0);
    // Yalnız ince çizgi tutulur: bu karenin 3x3'ü düzgün (ayrıntı bu karede ıskalandı) ya da geçmiş kutunun aralığından çok
    // dışarıda. İki büyük yüzeyin kenarında (duvarın zemine değdiği yer) 3x3 iki rengi de içerir; orada basamak deseni kayarken
    // tutulunca kenar basamaklı kalıyordu
    float rangeY = mx.x - mn.x;
    float excessY = max(max(lo.x - historyY.x, historyY.x - hi.x), 0.0);
    bool hold = flicker >= 8.0 && (rangeY < 0.06 || excessY > rangeY);
    // Kamera duruyorken: geçmiş her karede bu düşük çözünürlüklü 3x3'ün aralığına kırpılınca çıktı çözünürlüğünde biriken ayrıntı
    // siliniyordu (yükseltme bulanık kalıyordu). Kutu küçük bir payla genişler (büyük değişim, namlu alevi ışığı yine kırpılır)
    bool settle = u_CameraStill == 1 && !moving && !reactive;
    if (!hold)
    {
        vec3 pad = settle ? vec3(0.06, 0.03, 0.03) : vec3(0.0);
        history = YCoCgToRGB(clamp(historyY, lo - pad, hi + pad));
    }
    // Hızlı harekette ve hareket eden nesnede geçmişe daha az güven; çıktı pikselinin yakınında örnek yoksa az güncelleme
    float speed = length(velocity * inSize);
    float feedback = mix(u_Feedback, 0.7, clamp(speed / 16.0, 0.0, 1.0));
    // Dururken: kamera durduğundan beri gelen örneklerin ağırlıklı ortalaması (her örneğin ağırlığı çıktı pikseline yakınlığı,
    // biriken ağırlık en çok 15.5). Oyun başlarken / durunca geçmiş yarım saniyede bu konumun ortalamasına oturur. Eskiden güncelleme
    // sabit 0.96 x yakınlıktı: yakınına örnek düşmeyen çıktı pikselleri 2 saniye boyunca yavaşça değişiyordu (küplerin arası başta
    // açık, bir iki saniye sonra koyu). Hareket ederken geçmiş 4 örnek değerinde sayılır (durunca ilk kare tek titreşimli kareye atlamaz)
    float acc = 4.0;
    float alphaSettle = -1.0;
    if (settle)
    {
        current = sumN / max(wsumN, 1e-4);
        alphaSettle = wmaxN / (min(accBefore, 15.5) + wmaxN);
        acc = min(accBefore + wmaxN, 15.5);
    }
    if (hold)
        feedback = max(feedback, 0.94);
    if (moving || reactive)
        feedback = min(feedback, 0.5);
    // Yaklaşırken geçmiş bu kareden düşük çözünürlüklüdür (TAA ile aynı ilke): ağırlık büyütme oranıyla sınırlı
    float magnify = (u_CameraStill == 0 && closest < 1.0 && !objectVelocity) ? max(prevClip.w / curW - 1.0, 0.0) : 0.0;
    if (magnify > 0.0)
        feedback = min(feedback, 0.12 / (0.12 + magnify));
    float alpha = alphaSettle >= 0.0 ? max(alphaSettle, 0.02) : max((1.0 - feedback) * wmax, 0.02);
    FragColor = vec4(max(mix(history, current, alpha), vec3(0.0)), floor(acc * 2.0) * 64.0 + flicker * 2.0 + (outsideNow ? 1.0 : 0.0));
}
