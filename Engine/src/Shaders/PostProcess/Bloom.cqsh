#language GLSL
// Bloom: 0 = ön filtre (yumuşak eşik + Karis ortalaması), 1 = aşağı örnekleme (13-tap), 2 = yukarı örnekleme (3x3 tent)
#type vertex
#version 450 core
layout(location = 0) in vec2 a_Position;
layout(location = 1) in vec2 a_TexCoord;
out vec2 v_UV;
void main()
{
    v_UV = a_TexCoord;
    gl_Position = vec4(a_Position, 0.0, 1.0);
}

#type fragment
#version 450 core

#include "Include/Common.glsl"

layout(location = 0) out vec4 FragColor;
in vec2 v_UV;

uniform sampler2D u_Source;
uniform vec2 u_TexelSize;          // kaynak dokunun 1/boyut
uniform int u_Mode = 0;
uniform vec4 u_Threshold;          // x eşik, y eşik - diz, z 2*diz, w 0.25/diz
uniform float u_Scatter = 0.7;
uniform sampler2D u_Higher;        // yukarı örneklemede bu seviyenin kendisi (ekleme için)

vec3 Downsample13(sampler2D tex, vec2 uv, vec2 t)
{
    vec3 a = texture(tex, uv + t * vec2(-2.0, -2.0)).rgb;
    vec3 b = texture(tex, uv + t * vec2( 0.0, -2.0)).rgb;
    vec3 c = texture(tex, uv + t * vec2( 2.0, -2.0)).rgb;
    vec3 d = texture(tex, uv + t * vec2(-2.0,  0.0)).rgb;
    vec3 e = texture(tex, uv).rgb;
    vec3 f = texture(tex, uv + t * vec2( 2.0,  0.0)).rgb;
    vec3 g = texture(tex, uv + t * vec2(-2.0,  2.0)).rgb;
    vec3 h = texture(tex, uv + t * vec2( 0.0,  2.0)).rgb;
    vec3 i = texture(tex, uv + t * vec2( 2.0,  2.0)).rgb;
    vec3 j = texture(tex, uv + t * vec2(-1.0, -1.0)).rgb;
    vec3 k = texture(tex, uv + t * vec2( 1.0, -1.0)).rgb;
    vec3 l = texture(tex, uv + t * vec2(-1.0,  1.0)).rgb;
    vec3 m = texture(tex, uv + t * vec2( 1.0,  1.0)).rgb;
    vec3 r = e * 0.125;
    r += (a + c + g + i) * 0.03125;
    r += (b + d + f + h) * 0.0625;
    r += (j + k + l + m) * 0.125;
    return r;
}

float KarisWeight(vec3 c) { return 1.0 / (1.0 + Luminance(c)); }

void main()
{
    if (u_Mode == 0)
    {
        // 4 alt bloğun Karis ağırlıklı ortalaması: güneş gibi tek parlak pikseller titremez
        vec2 t = u_TexelSize;
        vec3 s0 = texture(u_Source, v_UV + t * vec2(-1.0, -1.0)).rgb;
        vec3 s1 = texture(u_Source, v_UV + t * vec2( 1.0, -1.0)).rgb;
        vec3 s2 = texture(u_Source, v_UV + t * vec2(-1.0,  1.0)).rgb;
        vec3 s3 = texture(u_Source, v_UV + t * vec2( 1.0,  1.0)).rgb;
        float w0 = KarisWeight(s0), w1 = KarisWeight(s1), w2 = KarisWeight(s2), w3 = KarisWeight(s3);
        vec3 color = (s0 * w0 + s1 * w1 + s2 * w2 + s3 * w3) / max(w0 + w1 + w2 + w3, 1e-4);
        color = min(color, vec3(65000.0));
        if (any(isnan(color)) || any(isinf(color)))
            color = vec3(0.0);

        float br = max(color.r, max(color.g, color.b));
        float rq = clamp(br - u_Threshold.y, 0.0, u_Threshold.z);
        rq = u_Threshold.w * rq * rq;
        float contribution = max(rq, br - u_Threshold.x) / max(br, 1e-4);
        FragColor = vec4(color * contribution, 1.0);
    }
    else if (u_Mode == 1)
    {
        FragColor = vec4(Downsample13(u_Source, v_UV, u_TexelSize), 1.0);
    }
    else
    {
        vec2 t = u_TexelSize;
        vec3 sum = texture(u_Source, v_UV + vec2(-t.x, -t.y)).rgb;
        sum += texture(u_Source, v_UV + vec2(0.0, -t.y)).rgb * 2.0;
        sum += texture(u_Source, v_UV + vec2(t.x, -t.y)).rgb;
        sum += texture(u_Source, v_UV + vec2(-t.x, 0.0)).rgb * 2.0;
        sum += texture(u_Source, v_UV).rgb * 4.0;
        sum += texture(u_Source, v_UV + vec2(t.x, 0.0)).rgb * 2.0;
        sum += texture(u_Source, v_UV + vec2(-t.x, t.y)).rgb;
        sum += texture(u_Source, v_UV + vec2(0.0, t.y)).rgb * 2.0;
        sum += texture(u_Source, v_UV + vec2(t.x, t.y)).rgb;
        vec3 upsampled = sum / 16.0;
        vec3 current = texture(u_Higher, v_UV).rgb;
        FragColor = vec4(mix(current, upsampled, u_Scatter), 1.0);
    }
}
