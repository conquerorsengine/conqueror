}

vec2 ComputeEdgeLuma(int x, int y, float pixelLumas[8])
{
    vec2 temp;
    temp.x = abs(pixelLumas[x + (y * 3)] - pixelLumas[(x + 1) + (y * 3)]);
    temp.y = abs(pixelLumas[x + (y * 3)] - pixelLumas[x + ((y + 1) * 3)]);
    return temp;
}

