    e00.x = valV.x;
    e10.x = valV.y;
    e01.x = valV.z;
    e11.x = valV.w;
}

float ComputeLocalContrastH(int x, int y, vec2 neighbourhood[4][4])
{
    return max(max(neighbourhood[x + 0][y + 1].x, neighbourhood[x + 1][y + 1].x), max(neighbourhood[x + 0][y + 2].x, neighbourhood[x + 1][y + 2].x)) * 0.100000001490116119384765625;
}

float GetActualEdgeThreshold()
