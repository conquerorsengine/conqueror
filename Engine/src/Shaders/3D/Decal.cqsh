#language GLSL
#type vertex
#version 450 core

layout(location = 0) in vec3 a_Position;

uniform mat4 u_ViewProjection;
uniform mat4 u_Transform;

void main()
{
    gl_Position = u_ViewProjection * u_Transform * vec4(a_Position, 1.0);
}

#type fragment
#version 450 core

#include "Include/Common.glsl"
#include "Include/FrameData.glsl"

// Ekran uzayı çıkartma: derinlikten dünya konumu kurulur, çıkartma kutusunun (-1..1) yerel uzayına
// çevrilir; kutu dışı atılır. Doku yerel XY düzlemine, -Z yönünde yansıtılır.
layout(location = 0) out vec4 FragColor;

uniform sampler2D u_Depth;
uniform sampler2D u_Albedo;
uniform int u_UseTexture = 0;
uniform mat4 u_InvTransform;
uniform vec4 u_Color = vec4(1.0);
uniform vec2 u_Tiling = vec2(1.0);
uniform vec2 u_Offset = vec2(0.0);
uniform float u_AngleFadeCos = 0.17;
uniform float u_Emission = 0.0;
uniform vec2 u_ViewportOrigin;
uniform vec2 u_ViewportSize;
uniform mat4 u_Transform;

vec3 WorldFromDepth(vec2 uv, float depth)
{
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 view = CQ_Frame.InvProjection * ndc;
    view /= view.w;
    return (CQ_Frame.InvView * view).xyz;
}

void main()
{
    vec2 uv = (gl_FragCoord.xy - u_ViewportOrigin) / u_ViewportSize;
    float depth = texture(u_Depth, uv).r;
    if (depth >= 1.0)
        discard;   // gökyüzü
    vec3 world = WorldFromDepth(uv, depth);
    vec3 local = (u_InvTransform * vec4(world, 1.0)).xyz;
    if (any(greaterThan(abs(local), vec3(1.0))))
        discard;

    // Yüzey normali (derinlik türevlerinden) ile yansıtma ekseni arası açıya göre solma
    vec3 n = normalize(cross(dFdx(world), dFdy(world)));
    vec3 axis = normalize(mat3(u_Transform) * vec3(0.0, 0.0, 1.0));
    float facing = abs(dot(n, axis));
    float angleFade = smoothstep(u_AngleFadeCos, min(u_AngleFadeCos + 0.2, 1.0), facing);
    // Yansıtma derinliğinin uçlarında yumuşak geçiş
    float depthFade = 1.0 - smoothstep(0.8, 1.0, abs(local.z));

    vec2 tuv = (local.xy * 0.5 + 0.5) * u_Tiling + u_Offset;
    vec4 albedo = vec4(SRGBToLinear(u_Color.rgb), u_Color.a);
    if (u_UseTexture == 1)
    {
        vec4 t = texture(u_Albedo, tuv);
        albedo *= vec4(SRGBToLinear(t.rgb), t.a);
    }
    float alpha = albedo.a * angleFade * depthFade;
    if (alpha < 0.003)
        discard;

    // Basit aydınlatma: ortam + güneş (gölgesiz)
    vec3 ambient = CQ_Frame.AmbientSkyColor.rgb * CQ_Frame.AmbientSkyColor.a;
    vec3 lit = ambient;
    if (CQ_Frame.SunDirection.w > 0.5)
    {
        vec3 viewDir = normalize(world - CQ_Frame.CameraPosTime.xyz);
        vec3 nn = dot(n, viewDir) > 0.0 ? -n : n;   // kameraya bakan yüz
        lit += CQ_Frame.SunColor.rgb * max(dot(nn, -normalize(CQ_Frame.SunDirection.xyz)), 0.0);
    }
    vec3 color = albedo.rgb * lit + albedo.rgb * u_Emission;
    // HDR hattında doğrusal; değilse sahne gölgelendiricileri gibi ton eşleyip sRGB'ye çevir
    if (CQ_Frame.FeatureFlags.x != 1)
        color = LinearToSRGB(clamp((color * (2.51 * color + 0.03)) / (color * (2.43 * color + 0.59) + 0.14), 0.0, 1.0));
    FragColor = vec4(color, alpha);
}
