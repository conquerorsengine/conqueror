#language GLSL
#type vertex
#version 450 core

#include "Include/FrameData.glsl"
#include "Include/TreeWind.glsl"

layout(location = 0) in vec3 a_Position;
layout(location = 1) in vec3 a_Normal;
layout(location = 2) in vec3 a_Tangent;
layout(location = 3) in vec2 a_TexCoord;
layout(location = 4) in vec2 a_TexCoord2;
layout(location = 6) in vec4 a_Color;           // Mesh Paint köşe rengi
uniform int u_UseVertexColor = 0;               // 0: bağlı değil (beyaz; emüle arka uçlarda varsayılan öznitelik siyahtır)

uniform mat4 u_Transform;
uniform mat4 u_NormalMatrix;

// MultiMesh (GPU örnekleme): örnek başına yerel matris (sütunlar) ve renk çarpanı
layout(location = 8) in vec4 a_Instance0;
layout(location = 9) in vec4 a_Instance1;
layout(location = 10) in vec4 a_Instance2;
layout(location = 11) in vec4 a_Instance3;
layout(location = 12) in vec4 a_InstanceColor;
uniform int u_Instanced = 0;

out VS_OUT {
    vec3 FragPos;
    vec3 Normal;
    vec3 Tangent;
    vec2 TexCoord;
    vec2 TexCoord2;
    mat3 TBN;
    vec4 Color;
} vs_out;

void main()
{
    mat4 model = u_Transform;
    mat3 normalMatrix = mat3(u_NormalMatrix);
    vec4 tint = vec4(1.0);
    if (u_Instanced == 1)
    {
        model = u_Transform * mat4(a_Instance0, a_Instance1, a_Instance2, a_Instance3);
        normalMatrix = transpose(inverse(mat3(model)));
        tint = a_InstanceColor;
    }
    vec4 worldPos = model * vec4(a_Position, 1.0);
    // Ağaç rüzgârı (Tree Creator + Wind Zone): ikinci UV kanalındaki ağırlıklarla salınım
    if (u_TreeWindParams.y > 0.5)
        worldPos.xyz += TreeWindOffset(worldPos.xyz, model[3].xyz, a_TexCoord2, u_TreeWindParams.x);
    vs_out.FragPos = worldPos.xyz;

    vec3 N = normalize(normalMatrix * a_Normal);
    vec3 T = normalMatrix * a_Tangent;
    // Gram-Schmidt; tanjantı olmayan meshlerde (sıfır vektör) güvenli yedek
    T = T - dot(T, N) * N;
    if (dot(T, T) < 1e-8)
        T = abs(N.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), N) : vec3(1.0, 0.0, 0.0);
    T = normalize(T);
    vec3 B = cross(N, T);

    vs_out.Normal = N;
    vs_out.Tangent = T;
    vs_out.TBN = mat3(T, B, N);
    vs_out.TexCoord = a_TexCoord;
    vs_out.TexCoord2 = a_TexCoord2;
    vs_out.Color = (u_UseVertexColor == 1 ? a_Color : vec4(1.0)) * tint;

    gl_Position = CQ_Frame.ViewProjection * worldPos;
}

#type fragment
#version 450 core

#include "Include/PBRForwardFragment.glsl"
