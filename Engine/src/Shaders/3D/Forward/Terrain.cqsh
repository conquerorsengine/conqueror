#language GLSL
// Conqueror's Engine - Terrain: yükseklik haritası mesh'i + 4 katmanlı splat (PBR)
#type vertex
#version 450 core

#include "Include/FrameData.glsl"

layout(location = 0) in vec3 a_Position;
layout(location = 1) in vec3 a_Normal;
layout(location = 2) in vec3 a_Tangent;
layout(location = 3) in vec2 a_TexCoord;
layout(location = 4) in vec2 a_TexCoord2;

uniform mat4 u_Transform;
uniform mat4 u_NormalMatrix;

out VS_OUT {
    vec3 FragPos;
    vec3 Normal;
    vec3 Tangent;
    vec2 TexCoord;
    vec2 TexCoord2;
    mat3 TBN;
} vs_out;

void main()
{
    vec4 worldPos = u_Transform * vec4(a_Position, 1.0);
    vs_out.FragPos = worldPos.xyz;
    mat3 normalMatrix = mat3(u_NormalMatrix);
    vec3 N = normalize(normalMatrix * a_Normal);
    vec3 T = normalMatrix * a_Tangent;
    T = T - dot(T, N) * N;
    if (dot(T, T) < 1e-8)
        T = abs(N.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), N) : vec3(1.0, 0.0, 0.0);
    T = normalize(T);
    vs_out.Normal = N;
    vs_out.Tangent = T;
    vs_out.TBN = mat3(T, cross(N, T), N);
    vs_out.TexCoord = a_TexCoord;
    vs_out.TexCoord2 = a_TexCoord2;
    gl_Position = CQ_Frame.ViewProjection * worldPos;
}

#type fragment
#version 450 core

#include "Include/Common.glsl"
#include "Include/FrameData.glsl"
#include "Include/Lighting.glsl"

layout(location = 0) out vec4 FragColor;

in VS_OUT {
    vec3 FragPos;
    vec3 Normal;
    vec3 Tangent;
    vec2 TexCoord;
    vec2 TexCoord2;
    mat3 TBN;
} fs_in;

uniform sampler2D u_Splat;
uniform sampler2D u_Layer0;
uniform sampler2D u_Layer1;
uniform sampler2D u_Layer2;
uniform sampler2D u_Layer3;
uniform vec4 u_LayerTint[4];     // rgb (sRGB), a = doku var mı
uniform vec4 u_LayerParams[4];   // x tekrar, y pürüzlülük, z metaliklik
uniform int u_LayerCount = 1;
uniform vec2 u_TerrainSize = vec2(100.0);

// Döşeme tekrarını kırmak için iki ölçekte örnekle ve karıştır
vec3 SampleLayer(sampler2D tex, vec2 uv, float tiling, vec4 tint)
{
    if (tint.a < 0.5)
        return SRGBToLinear(tint.rgb);
    vec3 a = texture(tex, uv * tiling).rgb;
    vec3 b = texture(tex, uv * tiling * 0.27 + vec2(0.37, 0.71)).rgb;
    float macro = 0.65 + 0.35 * b.g;
    return SRGBToLinear(mix(a, a * macro, 0.5) * tint.rgb);
}

void main()
{
    vec2 uv = fs_in.TexCoord;
    vec4 w = texture(u_Splat, uv);
    if (u_LayerCount < 4) w.a = 0.0;
    if (u_LayerCount < 3) w.b = 0.0;
    if (u_LayerCount < 2) w.g = 0.0;
    float sum = w.r + w.g + w.b + w.a;
    w = sum > 1e-4 ? w / sum : vec4(1.0, 0.0, 0.0, 0.0);

    vec3 albedo = vec3(0.0);
    float roughness = 0.0;
    float metallic = 0.0;
    if (w.r > 0.001) { albedo += w.r * SampleLayer(u_Layer0, uv, u_LayerParams[0].x, u_LayerTint[0]); roughness += w.r * u_LayerParams[0].y; metallic += w.r * u_LayerParams[0].z; }
    if (w.g > 0.001) { albedo += w.g * SampleLayer(u_Layer1, uv, u_LayerParams[1].x, u_LayerTint[1]); roughness += w.g * u_LayerParams[1].y; metallic += w.g * u_LayerParams[1].z; }
    if (w.b > 0.001) { albedo += w.b * SampleLayer(u_Layer2, uv, u_LayerParams[2].x, u_LayerTint[2]); roughness += w.b * u_LayerParams[2].y; metallic += w.b * u_LayerParams[2].z; }
    if (w.a > 0.001) { albedo += w.a * SampleLayer(u_Layer3, uv, u_LayerParams[3].x, u_LayerTint[3]); roughness += w.a * u_LayerParams[3].y; metallic += w.a * u_LayerParams[3].z; }

    vec3 N = normalize(fs_in.Normal);

    CQ_Surface surface;
    surface.Position = fs_in.FragPos;
    surface.Normal = N;
    surface.GeometricNormal = N;
    surface.Albedo = albedo;
    surface.Metallic = Saturate(metallic);
    surface.Roughness = Saturate(roughness);
    surface.AO = 1.0;
    surface.Emission = vec3(0.0);
    surface.Alpha = 1.0;
    surface.LightmapUV = fs_in.TexCoord2;
    surface.ShadingModel = 0;
    surface.SubsurfaceColor = vec3(0.0);
    surface.SubsurfaceAmount = 0.0;
    surface.Tangent = vec3(1.0, 0.0, 0.0);

    int debugView = CQ_Frame.DebugParams.x;
    if (debugView == 1) { FragColor = CQ_FinalizeOutput(vec4(surface.Albedo, 1.0)); return; }
    if (debugView == 2) { FragColor = CQ_FinalizeOutput(vec4(SRGBToLinear(N * 0.5 + 0.5), 1.0)); return; }
    if (debugView == 3) { surface.Albedo = vec3(0.75); surface.Metallic = 0.0; }
    else if (debugView == 4) { FragColor = CQ_FinalizeOutput(vec4(SRGBToLinear(vec3(surface.Metallic, surface.Roughness, 0.0)), 1.0)); return; }
    else if (debugView == 5) { FragColor = CQ_FinalizeOutput(vec4(vec3(1.0), 1.0)); return; }

    FragColor = CQ_FinalizeOutput(CQ_ShadeSurface(surface));
}
