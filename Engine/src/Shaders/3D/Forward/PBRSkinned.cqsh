#language GLSL
#type vertex
#version 450 core

#include "Include/FrameData.glsl"
#include "Include/Skinning.glsl"

layout(location = 0) in vec3 a_Position;
layout(location = 1) in vec3 a_Normal;
layout(location = 2) in vec3 a_Tangent;
layout(location = 3) in vec2 a_TexCoord;
layout(location = 4) in ivec4 a_BoneIDs;
layout(location = 5) in vec4 a_BoneWeights;
layout(location = 6) in vec4 a_Color;           // Mesh Paint köşe rengi
uniform int u_UseVertexColor = 0;               // 0: bağlı değil (beyaz; emüle arka uçlarda varsayılan öznitelik siyahtır)

uniform mat4 u_Transform;
uniform mat4 u_NormalMatrix;

out VS_OUT {
    vec3 FragPos;
    vec3 Normal;
    vec3 Tangent;
    vec2 TexCoord;
    vec2 TexCoord2;
    mat3 TBN;
    vec4 Color;
} vs_out;

void main()
{
    mat4 skinMatrix = CQ_SkinMatrix(a_BoneIDs, a_BoneWeights);
    vec3 position = a_Position;
    vec3 normal = a_Normal;
    CQ_ApplyMorph(position, normal);

    vec4 localPos = skinMatrix * vec4(position, 1.0);
    vec4 worldPos = u_Transform * localPos;
    vs_out.FragPos = worldPos.xyz;

    mat3 skinRot = mat3(skinMatrix);
    mat3 normalMatrix = mat3(u_NormalMatrix);
    vec3 N = normalize(normalMatrix * (skinRot * normal));
    vec3 T = normalMatrix * (skinRot * a_Tangent);
    T = T - dot(T, N) * N;
    if (dot(T, T) < 1e-8)
        T = abs(N.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), N) : vec3(1.0, 0.0, 0.0);
    T = normalize(T);
    vec3 B = cross(N, T);

    vs_out.Normal = N;
    vs_out.Tangent = T;
    vs_out.TBN = mat3(T, B, N);
    vs_out.TexCoord = a_TexCoord;
    vs_out.TexCoord2 = a_TexCoord;
    vs_out.Color = u_UseVertexColor == 1 ? a_Color : vec4(1.0);

    gl_Position = CQ_Frame.ViewProjection * worldPos;
}

#type fragment
#version 450 core

#include "Include/PBRForwardFragment.glsl"
