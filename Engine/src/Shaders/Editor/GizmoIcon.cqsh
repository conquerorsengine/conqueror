#language GLSL
// Editör simgesi (Unity sahne simgeleri gibi): kameraya dönük dörtgen, doku alfası, ışık rengiyle boyanır
#type vertex
#version 450 core

layout(location = 0) in vec3 a_Position;
layout(location = 3) in vec2 a_TexCoord;

uniform mat4 u_ViewProjection;
uniform mat4 u_Transform;

out vec2 v_TexCoord;

void main()
{
    v_TexCoord = a_TexCoord;
    gl_Position = u_ViewProjection * u_Transform * vec4(a_Position, 1.0);
}

#type fragment
#version 450 core

#include "Include/Common.glsl"

layout(location = 0) out vec4 FragColor;

in vec2 v_TexCoord;

uniform sampler2D u_Icon;
uniform vec3 u_Color = vec3(1.0);
uniform float u_Alpha = 1.0;
uniform int u_LinearOutput = 0;

void main()
{
    vec4 t = texture(u_Icon, v_TexCoord);
    float a = t.a * u_Alpha;
    if (a < 0.02)
        discard;
    vec3 c = t.rgb * u_Color;
    if (u_LinearOutput == 1)
        c = SRGBToLinear(c);
    FragColor = vec4(c, a);
}
