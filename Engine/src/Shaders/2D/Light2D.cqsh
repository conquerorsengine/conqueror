#language GLSL
#type vertex
#version 450 core

// 2D ışık: dünya uzayı (xy) üçgenleri; uv yalnızca sprite ışığında kullanılır
layout(location = 0) in vec4 a_PosUV;

uniform mat4 u_ViewProjection;

out vec2 v_World;
out vec2 v_UV;

void main()
{
    v_World = a_PosUV.xy;
    v_UV = a_PosUV.zw;
    gl_Position = u_ViewProjection * vec4(a_PosUV.xy, 0.0, 1.0);
}

#type fragment
#version 450 core

layout(location = 0) out vec4 FragColor;

in vec2 v_World;
in vec2 v_UV;

uniform int u_Type = 1;              // 1 point/spot, 2 sprite, 3 freeform
uniform vec3 u_Color = vec3(1.0);    // renk * yoğunluk * (gölge çarpanı)
uniform vec2 u_Center;
uniform vec2 u_Axis = vec2(0.0, 1.0);  // spot ekseni (ışığın yerel +Y yönü)
uniform vec2 u_Radii = vec2(0.0, 5.0); // iç, dış
uniform vec2 u_HalfAngles = vec2(3.2, 3.2); // radyan; >= pi: tam daire
uniform float u_FalloffExp = 2.5;
uniform sampler2D u_Cookie;
uniform vec2 u_Points[32];
uniform int u_PointCount = 0;
uniform float u_FalloffDistance = 0.5;
uniform int u_HasNormals = 0;
uniform float u_NormalDistance = 3.0;
uniform sampler2D u_Normals;

// Çokgene işaretli uzaklık (içeride negatif) — Inigo Quilez
float PolygonDistance(vec2 p)
{
    float d = dot(p - u_Points[0], p - u_Points[0]);
    float s = 1.0;
    for (int i = 0, j = u_PointCount - 1; i < u_PointCount; j = i, i++)
    {
        vec2 e = u_Points[j] - u_Points[i];
        vec2 w = p - u_Points[i];
        vec2 b = w - e * clamp(dot(w, e) / max(dot(e, e), 1e-8), 0.0, 1.0);
        d = min(d, dot(b, b));
        bvec3 c = bvec3(p.y >= u_Points[i].y, p.y < u_Points[j].y, e.x * w.y > e.y * w.x);
        if (all(c) || all(not(c)))
            s *= -1.0;
    }
    return s * sqrt(d);
}

void main()
{
    float atten = 0.0;
    vec3 tint = vec3(1.0);
    if (u_Type == 2)
    {
        vec4 c = texture(u_Cookie, v_UV);
        tint = c.rgb;
        atten = c.a;
    }
    else if (u_Type == 3)
    {
        float sd = PolygonDistance(v_World);
        float t = clamp(sd / max(u_FalloffDistance, 1e-4), 0.0, 1.0);
        atten = pow(1.0 - t, u_FalloffExp);
    }
    else
    {
        vec2 v = v_World - u_Center;
        float d = length(v);
        float t = clamp((d - u_Radii.x) / max(u_Radii.y - u_Radii.x, 1e-4), 0.0, 1.0);
        atten = pow(1.0 - t, u_FalloffExp);
        if (u_HalfAngles.y < 3.14159 && d > 1e-5)
        {
            float ang = acos(clamp(dot(v / d, u_Axis), -1.0, 1.0));
            atten *= 1.0 - smoothstep(u_HalfAngles.x, max(u_HalfAngles.y, u_HalfAngles.x + 1e-3), ang);
        }
    }
    // Sprite Editor > Secondary Textures: _NormalMap olan sprite'lar ışığın yönüne göre gölgelenir
    if (u_HasNormals == 1 && u_Type == 1)
    {
        vec4 n = texelFetch(u_Normals, ivec2(gl_FragCoord.xy), 0);
        if (n.a > 0.5)
        {
            vec3 N = normalize(n.xyz * 2.0 - 1.0);
            vec3 L = normalize(vec3(u_Center - v_World, u_NormalDistance));
            atten *= max(dot(N, L), 0.0);
        }
    }
    if (atten <= 0.0)
        discard;
    FragColor = vec4(u_Color * tint * atten, 1.0);
}
